@page "/energy"

@using GWS_Statistics.Helper
@using Syncfusion.Blazor.Charts

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<EnergyModel> Logger
@inject NavigationManager NavigationManager
@inject SfDialogService DialogService

<PageTitle>Energiebedarf</PageTitle>

<div class="container">
    <div class="row">
        <div class="text-center fs-3 fw-bold">
            <span class="bi bi-house-up fa-3xs" aria-hidden="true"> </span>
            <label>Energiebedarf</label>
        </div>
    </div>
</div>

@* Min, Max *@
<div class="card shadow-lg p-2 mb-1">
    <div class="container-fluid bg-color-grey pb-2 border">
        <div class="row justify-content-center">
            @* Max/Min Heizung Verbrauch *@
            <div class="col-4 col-xl-3 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Max/Min Heizung</label>
                    <SfNumericTextBox TValue="double?" Value="@HeatingMax_kWh" Enabled="false" Format="####0.00 kWh"></SfNumericTextBox>
                    <div class="mt-1">
                        <SfNumericTextBox TValue="double?" Value="@HeatingMin_kWh" Enabled="false" Format="####0.00 kWh"></SfNumericTextBox>
                    </div>
                </div>
            </div>
            @* Max/Min Warmwasser Verbrauch *@
            <div class="col-4 col-xl-3 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Max/Min Warmwasser</label>
                    <SfNumericTextBox TValue="double?" Value="@HotWaterMax_kWh" Enabled="false" Format="####0.00 kWh"></SfNumericTextBox>
                    <div class="mt-1">
                        <SfNumericTextBox TValue="double?" Value="@HotWaterMin_kWh" Enabled="false" Format="####0.00 kWh"></SfNumericTextBox>
                    </div>
                </div>
            </div>
            @* Max/Min Energie Verbrauch *@
            <div class="col-4 col-xl-3 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Max/Min Energiebedarf</label>
                    <SfNumericTextBox TValue="double?" Value="@EnergyHeatingMax" Enabled="false" Format="####0.00 kWh/m²a"></SfNumericTextBox>
                    <div class="mt-1">
                        <SfNumericTextBox TValue="double?" Value="@EnergyHeatingMin" Enabled="false" Format="####0.00 kWh/m²a"></SfNumericTextBox>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Chart *@
@if (efficiencyList != null && efficiencyList.Count > 0)
{
    <div class="control-section" id="target" align="center">
        <div class="card shadow-lg">
            <SfChart @ref="chart" Title="Übersicht" Width="@Width" Height="@Height" Palettes="@palettes">
                <ChartEvents OnPointRender="PointRender"></ChartEvents>
                <ChartTitleStyle Size="24px"
                Color="black"
                FontFamily=@fontFamily
                FontWeight="normal"
                FontStyle="normal">
                </ChartTitleStyle>

                <ChartArea Background="#8c8b87"
                Width="auto">
                    <ChartAreaBorder Color="black"
                    Width="1"></ChartAreaBorder>
                </ChartArea>

                <ChartMargin Left="20" Right="20" Top="10" Bottom="0"></ChartMargin>

                <ChartZoomSettings EnableMouseWheelZooming="true" EnablePinchZooming="true" EnableSelectionZooming="true"></ChartZoomSettings>

                <ChartPrimaryXAxis RangePadding="ChartRangePadding.Additional"
                ValueType="Syncfusion.Blazor.Charts.ValueType.DateTimeCategory"
                EdgeLabelPlacement="EdgeLabelPlacement.None"
                Interval="@IntervalDuration"
                Format="@DateTimeFormat"
                IntervalType="@IntervalType">

                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    <ChartAxisLabelStyle FontFamily=@fontFamily></ChartAxisLabelStyle>
                    <ChartAxisTitleStyle FontFamily=@fontFamily></ChartAxisTitleStyle>
                    <ChartAxisCrosshairTooltip Fill="magenta" Enable="true"></ChartAxisCrosshairTooltip>
                </ChartPrimaryXAxis>

                <ChartPrimaryYAxis Title="Energie (kWh)"
                LabelFormat="{value}"
                RangePadding="ChartRangePadding.Normal"
                Interval="2000">

                    <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                    <ChartAxisLabelStyle FontFamily=@fontFamily></ChartAxisLabelStyle>
                    <ChartAxisTitleStyle FontFamily=@fontFamily></ChartAxisTitleStyle>
                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    <ChartAxisCrosshairTooltip Fill="magenta" Enable="false"></ChartAxisCrosshairTooltip>
                </ChartPrimaryYAxis>

                <ChartAxes>
                    <ChartAxis Name="yAxisCons_Total"
                    Title="Gesamt-Verbrauch"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="false"
                    Interval="@Interval_YAxis"
                    LabelFormat="{value}">
                        <ChartAxisMajorGridLines Width="1"></ChartAxisMajorGridLines>
                    </ChartAxis>

                    <ChartAxis Name="yAxisCons_Heating"
                    Title="Heizung-Verbrauch"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="false"
                    Interval="@Interval_YAxis"
                    LabelFormat="{value}">
                        <ChartAxisMajorGridLines Width="1"></ChartAxisMajorGridLines>
                    </ChartAxis>

                    <ChartAxis Name="yAxisCons_Water"
                    Title="Wasser-Verbrauch"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="true"
                    Interval="@Interval_YAxis"
                    LabelFormat="{value}">
                        <ChartAxisMajorGridLines Width="1"></ChartAxisMajorGridLines>
                    </ChartAxis>
                </ChartAxes>

                <ChartAnnotations>
                    @foreach (var annotation in Annotations)
                    {
                        <ChartAnnotation X="@annotation.xVal" Y="@annotation.yVal.ToString()" Region="Regions.Series" CoordinateUnits="Units.Point">
                            <ContentTemplate>
                                <div style="color: black; font-size: 24px; font-weight:600">
                                    @annotation.ClassText
                                </div>
                                <div style="color: black; font-size: 10px; font-weight:400">
                                    @annotation.ClassValue
                                </div>
                            </ContentTemplate>
                        </ChartAnnotation>
                    }
                </ChartAnnotations>

                <ChartSeriesCollection>
                    <ChartSeries ColumnWidth="0.5"
                    ColumnSpacing="0.1"
                    DataSource="@ChartPointList"
                    XName="Date"
                    YName="EnergyTotal"
                    Name="Gesamt-Verbrauch"
                    GroupName="Energy"
                    Type="ChartSeriesType.Column">

                        <ChartMarker>
                            <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top">
                                <ChartDataLabelFont Color="#ffffff" FontWeight="600" FontStyle="normal" Size="12px"></ChartDataLabelFont>
                            </ChartDataLabel>
                        </ChartMarker>
                    </ChartSeries>

                    <ChartSeries ColumnWidth="0.5"
                    ColumnSpacing="0.1"
                    DataSource="@ChartPointList"
                    XName="Date"
                    YName="EnergyHeating"
                    Name="Heizung-Verbrauch"
                    GroupName="Energy"
                    Type="ChartSeriesType.Column">

                        <ChartMarker>
                            <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top">
                                <ChartDataLabelFont Color="#ffffff" FontWeight="600" FontStyle="normal" Size="12px"></ChartDataLabelFont>
                            </ChartDataLabel>
                        </ChartMarker>

                    </ChartSeries>

                    <ChartSeries ColumnWidth="0.5"
                    ColumnSpacing="0.1"
                    DataSource="@ChartPointList"
                    XName="Date"
                    YName="EnergyWater"
                    Name="Wasser-Verbrauch"
                    GroupName="Energy"
                    Type="ChartSeriesType.Column">

                        <ChartMarker>
                            <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top">
                                <ChartDataLabelFont Color="#ffffff" FontWeight="600" FontStyle="normal" Size="12px"></ChartDataLabelFont>
                            </ChartDataLabel>
                        </ChartMarker>
                    </ChartSeries>
                </ChartSeriesCollection>

                <ChartCrosshairSettings Enable="true" LineType="LineType.Both"></ChartCrosshairSettings>

                <ChartLegendSettings Visible="true"
                EnableHighlight="true">
                </ChartLegendSettings>
                <ChartTooltipSettings Header="<b>${point.tooltip} kWh // kWh/m²a</b>" Enable="true" Shared="true" EnableHighlight="true"></ChartTooltipSettings>
            </SfChart>
        </div>

        <SfSpinner @bind-Visible="@SpinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

        @* Dialog*@
        <div>
            <SfDialog Target="#target" Width="@dialogWidth" Height="@dialogHeight" AllowDragging="true" ShowCloseIcon="true" @bind-Visible="@DialogVisible" AllowPrerender="true" IsModal="true">
                <DialogTemplates>
                    <Header>@Header</Header>
                </DialogTemplates>
                <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>
                <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>
            </SfDialog>
        </div>

    </div>
}
else
{
    <SfSpinner @bind-Visible="@SpinnerVisibleProperty" Label="Lade Daten..." Size="40"></SfSpinner>
}

<style>
    .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
    }

    .e-dialog .e-dlg-header-content {
        color: white;
        background-color: red;
        font-size: 24px;
    }

    .e-dialog .e-dlg-header {
        color: white;
    }

    .e-dialog .e-dlg-content {
        color: white;
        background-color: red;
        font-size: 16px;
    }

    .bg-color-grey {
        background: #deded9;
    }

    .control-wrapper {
        max-width: 250px;
        min-width: 80px;
        margin: 0 auto;
    }

    .control-label {
        font-size: 14px;
        margin: 6px 0px;
    }

    .tooltipStyle {
        border-radius: 25px;
    }

    .tooltipTextcolor {
        color: white;
        background-color: black;
    }
</style>

@code {
    #region Variablendeklaration
    private double wohnflaeche;

    private bool SpinnerVisibleProperty { get; set; } = false;

    private DialogSettings DialogParams = new DialogSettings { MinHeight = "400px", Width = "450px" };
    public DialogEffect animationEffect = DialogEffect.Zoom;
    public bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string DialogText { get; set; } = string.Empty;
    private string dialogXValue = "center";
    private string dialogYValue = "center";
    private string dialogHeight = "130px";
    private string dialogWidth = "380px";

    readonly string urlEfficiency = "gws/effizienz/";
    readonly string urlBoiler = "gas/therme/";
    readonly string urlParameter = "parameter/";

    string? Header { get; set; }
    string? Content { get; set; }

    GWSProcessor? gwsP;
    MyAppConfigModel? settings;

    private List<Gas_SupplierModel>? supplierList = new();
    private List<Energydata>? energyList = new();
    private Energydata? energyData = new();
    private List<EnergieHeating>? energyHeatingList = new();

    private EfficiencyModel? efficiencyData = new();
    private List<EfficiencyModel>? efficiencyList = null;
    private Dictionary<int, string> yearColorLookup = new();

    private ParameterModel? parameterData = new();
    private List<ParameterModel>? parameterList = null;

    private double? HeatingMax_kWh => energyList?.Max(x => x.Heizung_Verbrauch);
    private double? HeatingMin_kWh => energyList?.Min(x => x.Heizung_Verbrauch);
    private double? HotWaterMax_kWh => energyList?.Max(x => x.Warmwasser_Verbrauch);
    private double? HotWaterMin_kWh => energyList?.Min(x => x.Warmwasser_Verbrauch);

    private double? EnergyHeatingMax = 9999;
    private double? EnergyHeatingMin = -9999;

    #region Chart
    SfChart chart = new();
    public string fontFamily { get; set; } = "Arial";
    public IntervalType IntervalType { get; set; } = IntervalType.Years;
    public int IntervalDuration { get; set; } = 1;
    public string DateTimeFormat { get; set; } = "yyyy";
    public string Width { get; set; } = "100%";
    public string Height { get; set; } = "160%";
    public double Rotation { get; set; } = 0;
    public LabelIntersectAction Label { get; set; } = LabelIntersectAction.Trim;
    public String[] palettes = new String[] { "#f2ae1b", "#34b4eb", "#0634bd", "#a83c32" };  // Farben Serie Energieverbrauch: Heizung[kWh], Wasser[kWh], Strom[kWh]
    public double Interval_YAxis { get; set; } = 2000.0d;

    public List<ColumnChartData> ChartPointList { get; set; } = new List<ColumnChartData>();

    public class ColumnChartData
    {
        public DateTime Date { get; set; }
        public double? EnergyTotal { get; set; }
        public double? EnergyHeating { get; set; }
        public double? EnergyWater { get; set; }
        public string? Eff_Class { get; set; }
    }

    public class Energydata
    {
        public DateTime? Verbrauchsjahr { get; set; }
        public double? Gesamt_Verbrauch { get; set; }
        public double? Heizung_Verbrauch { get; set; }
        public double? Warmwasser_Verbrauch { get; set; }
    }

    public class EfficiencyValues
    {
        public string? EfficiencyClass { get; set; }
        public string? EfficiencyColor { get; set; }
    }
    #endregion

    public class ChartAnnotationData
    {
        public DateTime? xVal { get; set; }
        public double? yVal { get; set; }
        public string? ClassText { get; set; }
        public string? ClassValue { get; set; }
    }
    public List<ChartAnnotationData> Annotations = new();

    public class EnergieHeating
    {
        public DateTime HeatingYear { get; set; }
        public double HeatingConsumption { get; set; }
    }
    #endregion

    #region OnInitializedAsync
    /// <summary>
    /// OnInitializedAsync: Lädt die Effizienzklassen, Energiedaten und Parameter aus der GWS-API und bereitet die Daten für die Anzeige im Chart vor.
    /// </summary>
    /// <returns></returns>
    /// <exception cref="Exception"></exception>
    protected override async Task OnInitializedAsync()
    {
        this.SpinnerVisibleProperty = true;

        try
        {
            // 1. Einstellungen laden
            settings = await GetSetMyAppConfig.GetMyAppSettings.ReadSettingsAsync(myAppSettings);
            gwsP = new GWSProcessor(myHttpClient, settings!.GWSUri);

            // 2. Performance-Boost: Alle drei API-Aufrufe PARALLEL starten
            var efficiencyTask = gwsP.LoadDataAsync<EfficiencyModel>(urlEfficiency);
            var energyTask = gwsP.LoadDataAsync<Energydata>(urlBoiler);
            var parameterTask = gwsP.LoadDataAsync<ParameterModel>(urlParameter);

            await Task.WhenAll(efficiencyTask, energyTask, parameterTask); // Wartet gleichzeitig

            efficiencyList = efficiencyTask.Result;
            energyList = energyTask.Result;
            parameterList = parameterTask.Result;

            // 3. Validierung der Daten (Early Exits)
            if (efficiencyList == null || efficiencyList.Count == 0)
            {
                OpenDialog("Keine Effizienzklassen vorhanden!", "60px", "130px", false);
            }

            if (parameterList == null || parameterList.Count == 0)
            {
                OpenDialog("Keine Parameter vorhanden!", "60px", "130px", false);
            }
            else
            {
                var lastParameter = parameterList.LastOrDefault();
                if (lastParameter != null)
                {
                    wohnflaeche = lastParameter.Wohnflaeche.GetValueOrDefault(149.18d);
                }
            }

            if (energyList == null || energyList.Count == 0)
            {
                OpenDialog("Keine Energiedaten vorhanden!", "60px", "130px", false);
                return; // Ohne Energiedaten macht die Annotation-Schleife keinen Sinn
            }

            // Sortierung nach Verbrauchsjahr
            energyList.Sort((x, y) => x.Verbrauchsjahr.GetValueOrDefault().CompareTo(y.Verbrauchsjahr.GetValueOrDefault()));
            GetChartData(energyList);

            // 4. Listen-Initialisierung fixen gegen Abstürze!
            energyHeatingList = new List<EnergieHeating>();
            Annotations.Clear();

            // 5. Schleifen-Optimierung
            foreach (var energy in energyList)
            {

                double heizungVerbrauch = energy.Heizung_Verbrauch.GetValueOrDefault();
                double heatingConsumption = heizungVerbrauch / wohnflaeche;

                // Lokales Objekt hinzufügen statt Index-Gefahr
                var currentHeating = new EnergieHeating
                {
                    HeatingYear = energy.Verbrauchsjahr.GetValueOrDefault(),
                    HeatingConsumption = heatingConsumption
                };
                energyHeatingList.Add(currentHeating);

                double? yVal = Math.Round(heizungVerbrauch - ((heizungVerbrauch - energy.Warmwasser_Verbrauch.GetValueOrDefault()) / 2.0d), 0);
                EfficiencyValues effClass = GetEfficiencyClassValues(efficiencyList, heatingConsumption);

                string pointColor = effClass.EfficiencyColor ?? "Transparent";
                yearColorLookup[energy.Verbrauchsjahr.GetValueOrDefault().Year] = pointColor;

                if (energy.Gesamt_Verbrauch >= 1500.0d)
                {
                    Annotations.Add(new ChartAnnotationData
                    {
                        xVal = energy.Verbrauchsjahr,
                        yVal = yVal,
                        ClassText = effClass.EfficiencyClass,
                        // Schnelleres Runden und sauber formatierte String-Interpolation statt Convert.ToDecimal
                        ClassValue = $"({Math.Round(heatingConsumption)})"
                    });
                }
                else
                {
                    Annotations.Add(new ChartAnnotationData
                    {
                        xVal = energy.Verbrauchsjahr,
                        yVal = 0.0d,
                        ClassText = "",
                        ClassValue = ""
                    });
                }
            }

            // 6. Max/Min Bestimmung (Sicher, da Liste oben garantiert instanziiert wurde)
            if (energyHeatingList.Count > 0)
            {
                EnergyHeatingMax = energyHeatingList.Max(x => x.HeatingConsumption);
                EnergyHeatingMin = energyHeatingList.Min(x => x.HeatingConsumption);
            }
        }
        catch (Exception ex)
        {
            // UI-Fehlermeldung statt App-Crash via "throw new Exception"
            OpenDialog($"Fehler beim Laden der Energiedaten: {ex.Message}", "60px", "130px", false);
        }
        finally
        {
            // 7. Spinner sicher ausschalten ohne künstliches Delay
            this.SpinnerVisibleProperty = false;
            await Task.Yield();
        }
    }
    #endregion

    #region GetChartData
    /// <summary>
    /// Holt die Chart-Daten aus der Energiedatenliste und bereitet sie für die Anzeige vor.
    /// </summary>
    /// <param name="energyList"></param>
    /// <returns></returns>
    public void GetChartData(List<Energydata>? energyList)
    {
        IntervalDuration = 1;
        IntervalType = IntervalType.Years;
        DateTimeFormat = "yyyy";
        ChartPointList.Clear();

        // 1. Sicherer Null-Check (Verhindert eine NullReferenceException bei 'energyList?.Count')
        if (energyList == null || energyList.Count == 0)
        {
            OpenDialog("Energiedaten nicht vorhanden", "60px", "380px", false);
            return;
        }

        // 2. Schleife optimieren
        foreach (var energy in energyList)
        {
            double heizungVerbrauch = energy.Heizung_Verbrauch.GetValueOrDefault();
            double consumption = heizungVerbrauch / wohnflaeche;

            // Effizienzklasse einmalig für diesen Durchlauf holen
            var effClassValues = GetEfficiencyClassValues(efficiencyList, consumption);

            ChartPointList.Add(new ColumnChartData
            {
                Date = energy.Verbrauchsjahr.GetValueOrDefault(),
                EnergyTotal = energy.Gesamt_Verbrauch,
                EnergyHeating = energy.Heizung_Verbrauch,
                EnergyWater = energy.Warmwasser_Verbrauch,
                // Null-Coalescing fängt eventuelle Null-Werte aus der Klasse ab
                Eff_Class = effClassValues.EfficiencyClass ?? "N/A"
            });
        }
    }

    #endregion

    #region PointRender: Verändert die Barfarbe in Abhängigkeit des Wertes (pos/negativ)
    /// <summary>
    /// PointRender
    /// </summary>
    /// <param name="args"></param>
    public void PointRender(PointRenderEventArgs args)
    {
        // 1. Schneller und sicherer String-Vergleich
        if (args.Point == null || args.Series?.Name != "Heizung-Verbrauch")
        {
            return;
        }

        double yValue = args.Point.YValue;

        // 2. Nur berechnen und aufrufen, wenn der Wert größer 0 ist
        if (yValue > 0.0d)
        {
            double consumption = yValue / wohnflaeche;

            // 3. Holt die Farbe direkt aus der optimierten GetEfficiencyClassValues-Methode
            args.Fill = GetEfficiencyClassValues(efficiencyList, consumption).EfficiencyColor ?? "Transparent";
        }
    }
    #endregion

    #region GetEfficiencyClassValues: Liest die Effizienzklasse/Effizienzfarbe aus anhand des Verbrauches
    /// <summary>
    /// Effizienzklasse und Farbe anhand des Verbrauches ermitteln
    /// </summary>
    /// <param name="effClassification"></param>
    /// <param name="consumption"></param>
    /// <returns></returns>
    public EfficiencyValues GetEfficiencyClassValues(List<EfficiencyModel>? effClassification, double? consumption)
    {
        // 1. Fallback-Objekt bereitstellen, falls keine Daten vorhanden sind
        EfficiencyValues efficiencyValues = new()
        {
            EfficiencyClass = "N/A",
            EfficiencyColor = palettes != null && palettes.Length > 0 ? palettes[0] : "#FFFFFF"
        };

        if (effClassification == null || effClassification.Count == 0)
        {
            return efficiencyValues;
        }

        // Sicherstellen, dass ein Verbrauchswert da ist (falls null, unterste Klasse wählen)
        double currentConsumption = consumption.GetValueOrDefault(0.0d);

        // 2. Schleife korrigiert: Läuft jetzt über alle Elemente außer dem letzten
        // (da das letzte Element das "Fallback" für extrem hohe Verbräuche ist)
        for (int i = 0; i < effClassification.Count - 1; i++)
        {
            if (currentConsumption < effClassification[i].Energiebedarf)
            {
                efficiencyValues.EfficiencyClass = effClassification[i].Energieklasse?.ToString() ?? string.Empty;
                efficiencyValues.EfficiencyColor = effClassification[i].Farbcode;
                return efficiencyValues; // Sofortiger Ausstieg spart das Flag und das 'break'
            }
        }

        // 3. Wenn kein Bereich darunter lag, greift das letzte Element der Klassifizierung
        var lastEff = effClassification[^1];
        efficiencyValues.EfficiencyClass = lastEff.Energieklasse?.ToString() ?? string.Empty;
        // Falls im letzten Element kein Farbcode hinterlegt ist, Paletten-Fallback nutzen
        efficiencyValues.EfficiencyColor = !string.IsNullOrEmpty(lastEff.Farbcode) ? lastEff.Farbcode : palettes?[0];

        return efficiencyValues;
    }

    #endregion

    #region OpenDialog
    /// <summary>
    /// Dialog öffnen mit Header, Höhe, Breite und optionalen Buttons
    /// </summary>
    private void OpenDialog(string header, string height = "auto", string width = "500px", bool showButtons = true)
    {
        Header = header;
        dialogHeight = height;
        dialogWidth = width;
        showDialogButtons = showButtons;
        this.DialogVisible = true;

        // Erzwingt das Neu-Rendern der UI (wichtig in Blazor für Dialoge)
        this.StateHasChanged();
    }
    #endregion
}
