@code
{
    #region Variablendeklaration
    #region DialogBox
    DialogEffect animationEffect { get; set; } = DialogEffect.Zoom;
    bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string DialogText { get; set; } = string.Empty;
    private string dialogXValue = "center";
    private string dialogYValue = "center";
    private string dialogHeight = "130px";
    private string dialogWidth = "380px";
    #endregion

    #region Spinner
    private bool spinnerVisibleProperty { get; set; } = false;
    #endregion

    #region Daten
    private List<Electric_SupplierModel>? supplierList = new();
    private Electric_SupplierModel? supplierData = new();
    private List<GWS_PaymentModel>? paymentList = new();
    private List<Electric_CounterChangeModel>? counterChangeList = null;
    #endregion

    #region DateTime
    private DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    private DateTime MaxDate { get; set; } = DateTime.Now;
    private DateTime? StartDate { get; set; } = new DateTime(2000, 1, 1);
    private DateTime? EndDate { get; set; } = new DateTime(2000, 1, 1);
    #endregion

    #region App-Settings
    private MyAppConfigModel? settings = new();
    #endregion

    #region Url
    private readonly string urlSupplier = "strom/anbieter/";
    private readonly string urlPayments = "strom/zahlungen/";
    readonly string urlCounterChangeAllSuppliers = "strom/zaehlerwechsel";
    #endregion

    string? Header { get; set; }
    string? Content { get; set; }

    #region Http
    GWSProcessor? gwsP;
    #endregion

    #region Chart
    SfChart chart = new();
    private string fontFamily { get; set; } = "Arial";
    private IntervalType IntervalType { get; set; } = IntervalType.Months;
    private int IntervalDuration { get; set; } = 1;

    private string DateTimeFormat { get; set; } = "yyyy";

    private Theme Theme { get; set; }
    private string Width { get; set; } = "100%";
    private string Height { get; set; } = "160%";
    private double Rotation { get; set; } = 0;
    private LabelIntersectAction Label { get; set; } = LabelIntersectAction.Trim;
    private String[] palettes = new String[] { "#f2ae1b", "#1b85cc", "#fc0303" };  // Farben Serie: Verbrauch kWh, Kosten/kWh, Gesamtkosten
    private double Interval_YAxis_kWh { get; set; } = 1000.0d;
    private double Interval_YAxis_Cost_kWh { get; set; } = 10.0d;
    private double Interval_YAxis_Cost_Total { get; set; } = 300.0d;

    private double MaxRangeCons_kWh { get; set; } = 5000;
    private double MaxRangeCost_kWh { get; set; } = 50;
    private double MaxRangeCost_Total { get; set; } = 2000;

    private double MinRangeCons_kWh { get; set; } = 0;
    private double MinRangeCost_kWh { get; set; } = 0;
    private double MinRangeCost_Total { get; set; } = 0;

    private List<ColumnChartData> ChartPointList { get; set; } = new List<ColumnChartData>();

    public class ColumnChartData
    {
        public DateTime Date { get; set; }
        public double Cons_kWh { get; set; }
        public double Cost_kWh { get; set; }
        public double Cost_Total { get; set; }
    }
    #endregion
    // private static readonly CultureInfo DisplayCulture = new CultureInfo("de-DE");
    #endregion

    #region OnInitializedAsync
    /// <summary>
    /// Startet beim Laden der Seite automatisch und ruft die Daten parallel ab, berechnet die Chart-Daten und zeigt ggf. Dialoge an.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        this.spinnerVisibleProperty = true;

        try
        {
            // 1. Einstellungen lesen
            settings = await GetSetMyAppConfig.GetMyAppSettings.ReadSettingsAsync(myAppSettings);
            gwsP = new GWSProcessor(myHttpClient, settings!.GWSUri);

            // 2. Performance-Boost: Beide API-Aufrufe PARALLEL starten (halbiert die Ladezeit!)
            Task<List<Electric_SupplierModel>?> supplierTask = gwsP.LoadDataAsync<Electric_SupplierModel>(urlSupplier);
            Task<List<GWS_PaymentModel>?> paymentTask = gwsP.LoadDataAsync<GWS_PaymentModel>(urlPayments);

            // Warten, bis beide Anfragen fertig sind
            await Task.WhenAll(supplierTask, paymentTask);

            supplierList = supplierTask.Result;
            paymentList = paymentTask.Result;

            // 3. Early Exits statt tief verschachtelter If-Statements
            if (supplierList == null || supplierList.Count == 0)
            {
                OpenDialog("Keine Strom-Anbieter vorhanden!", "60px", "380px", false);
                return;
            }

            if (paymentList == null || paymentList.Count == 0)
            {
                OpenDialog("Keine Strom-Zahlungen vorhanden!", "60px", "380px", false);
                return;
            }

            // HINWEIS: Das manuelle Sortieren (.Sort) wurde ENTFERNT.
            // Da CalcChartData jetzt ein Dictionary verwendet, ist die Reihenfolge der Listen völlig egal!

            // 4. Daten verarbeiten
            await CalcChartData(supplierList, paymentList);
        }
        catch (Exception)
        {
            OpenDialog("Keine Strom-Daten vorhanden!", "60px", "380px", false);
        }
        finally
        {
            // 5. Spinner sicher ausschalten (auch im Fehlerfall dank 'finally')
            this.spinnerVisibleProperty = false;

            StateHasChanged();
        }
    }
    #endregion

    #region CalcChartData
    /// <summary>
    /// Berechnung der Chart-Daten für Verbrauch, Kosten/kWh und Gesamtkosten
    /// </summary>
    /// <param name="suppliers"></param>
    /// <param name="payments"></param>
    /// <returns></returns>
    public async Task CalcChartData(List<Electric_SupplierModel>? suppliers, List<GWS_PaymentModel>? payments)
    {
        // 1. Defensiver Null- und Leer-Check vorab (O(1) statt LINQ .Any())
        if (suppliers == null || suppliers.Count == 0 || payments == null || payments.Count == 0)
        {
            chart.ClearSeries();
            OpenDialog("Keine Strom-Vergleichskosten vorhanden!", "60px", "380px", false);
            return;
        }

        GetStartDateEndDate(suppliers);

        // Externe Daten asynchron laden
        counterChangeList = await gwsP!.LoadDataAsync<Electric_CounterChangeModel>(urlCounterChangeAllSuppliers);

        List<IConsumption> consumptionsYearly = await Task.Run(() => GWS_Calculation.CalcConsumptionYearly(suppliers, counterChangeList));

        if (consumptionsYearly == null || consumptionsYearly.Count == 0)
        {
            OpenDialog("Keine Strom-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }

        // 2. Performance-Boost: Zahlungen vor der Schleife indizieren (O(1) statt Listen-Scan)
        var paymentLookup = payments
            .GroupBy(p => p.ID_Anbieter)
            .ToDictionary(g => g.Key, g => g.Sum(p => p.Zahlungen));

        double cons_kWh;
        double cost_kWh = 0.0d;
        double cost_Total;

        // Flag, damit der Dialog bei fehlenden Kosten nur einmal aufpoppt
        bool hasShownNoCostDialog = false;

        // 3. Effiziente Schleife
        foreach (var cons in consumptionsYearly)
        {
            // Sicheres Auslesen des Nullable double? aus IConsumption
            cons_kWh = cons.Consumption.GetValueOrDefault();

            // Blitzschneller O(1) Zugriff auf die summierten Kosten aus dem Dictionary
            if (paymentLookup.TryGetValue(cons.SupplierId, out double? tempCost))
            {
                cost_Total = tempCost.GetValueOrDefault();
            }
            else
            {
                cost_Total = 0.0d;
            }

            // Berechnung & Dialog-Logik
            if (cons_kWh > 0.0d)
            {
                cost_kWh = (cost_Total / cons_kWh) * 100.0d;
            }
            else
            {
                cost_kWh = 0.0d; // Definierten Standardwert setzen
                chart.ClearSeries();

                if (!hasShownNoCostDialog)
                {
                    OpenDialog("Keine Strom-Kosten vorhanden!", "60px", "380px", false);
                    hasShownNoCostDialog = true; // Sperre für weitere Durchläufe aktivieren
                }
            }

            ChartPointList.Add(new ColumnChartData
            {
                Date = cons.Date,
                Cons_kWh = cons_kWh,
                Cost_kWh = cost_kWh,
                Cost_Total = cost_Total
            });
        }

        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region GetStartDateEndDate
    /// <summary>
    /// Auslesen des frühesten Startdatums und spätesten Enddatums aus der Liste der Anbieter
    /// </summary>
    /// <param name="suppliers"></param>
    public void GetStartDateEndDate(List<Electric_SupplierModel>? suppliers)
    {
        // 1. Früher Ausstieg bei leeren Daten + sauberes Fallback auf 'null'
        if (suppliers == null || suppliers.Count == 0)
        {
            StartDate = null;
            EndDate = null;
            return;
        }

        DateTime? minStart = DateTime.MaxValue;
        DateTime? maxEnd = DateTime.MinValue;
        bool hasValidData = false;

        // Cache für DateTime.Now, damit es nicht in jeder Schleifeniteration neu abgefragt werden muss
        DateTime now = DateTime.Now;

        // 2. Einmaliger, schneller Durchlauf
        foreach (var supplier in suppliers)
        {
            // Lokale Variablen reduzieren mehrfache Property-Zugriffe
            var start = supplier.Zeitraum_Start;
            var end = supplier.Zeitraum_Ende;

            // Kombinierter Check: Nur abgelaufene Zeiträume mit validen Daten betrachten
            if (start.HasValue && end.HasValue && end.Value < now)
            {
                if (start.Value < minStart.Value) minStart = start;
                if (end.Value > maxEnd.Value) maxEnd = end;
                hasValidData = true;
            }
        }

        // 3. Zuweisung nur, wenn tatsächlich passende Daten gefunden wurden
        StartDate = hasValidData ? minStart : null;
        EndDate = hasValidData ? maxEnd : null;
    }
    #endregion

    #region GetChartMinMaxRange
    /// <summary>
    /// Berechnung der Min/Max-Werte für die Y-Achsen der Chart-Darstellung
    /// </summary>
    public void GetChartMinMaxRange(List<ColumnChartData> chartList)
    {
        // 1. Früher Abbruch
        if (chartList == null || !chartList.Any())
        {
            MinRangeCons_kWh = MaxRangeCons_kWh = 0.0d;
            MinRangeCost_kWh = MaxRangeCost_kWh = 0.0d;
            MinRangeCost_Total = MaxRangeCost_Total = 0.0d;
            return;
        }

        // 2. Initialisierung der Min-Werte und Intervalle
        MinRangeCons_kWh = 0.0d;
        MinRangeCost_kWh = 0.0d;
        MinRangeCost_Total = 0.0d;

        Interval_YAxis_kWh = 1000.0d;
        Interval_YAxis_Cost_kWh = 10.0d;
        Interval_YAxis_Cost_Total = 100.0d;

        // 3. Startwerte für die Maximum-Suche aus dem ersten Element lesen
        // (Verhindert Probleme, falls alle Werte in der Liste 0 oder negativ sind)
        var firstItem = chartList.FirstOrDefault(x => x != null);
        if (firstItem == null) return;

        double maxCons = firstItem.Cons_kWh;
        double maxCostKwh = firstItem.Cost_kWh;
        double maxCostTotal = firstItem.Cost_Total;

        // Liste einmal komplett durchlaufen
        foreach (var item in chartList)
        {
            if (item == null) continue;

            if (item.Cons_kWh > maxCons) maxCons = item.Cons_kWh;
            if (item.Cost_kWh > maxCostKwh) maxCostKwh = item.Cost_kWh;
            if (item.Cost_Total > maxCostTotal) maxCostTotal = item.Cost_Total;
        }

        // 4. Werte runden und Offsets addieren
        MaxRangeCons_kWh = Math.Round(maxCons, 0) * 1.05d; // 5% Puffer
        MaxRangeCost_kWh = Math.Round(maxCostKwh, 0) * 1.05d; // 5% Puffer
        MaxRangeCost_Total = Math.Round(maxCostTotal, 0) * 1.05d; // 5% Puffer
    }
    #endregion

    #region OpenDialog
    /// <summary>
    /// Dialog öffnen mit Header, Höhe, Breite und optionalen Buttons
    /// </summary>
    private void OpenDialog(string header, string height="auto", string width="500px", bool showButtons=true)
    {
        Header = header;
        dialogHeight = height;
        dialogWidth = width;
        showDialogButtons = showButtons;
        this.DialogVisible = true;

        // Erzwingt das Neu-Rendern der UI (wichtig in Blazor für Dialoge)
        this.StateHasChanged();
    }
    #endregion

    #region LabelRender
    /// <summary>
    /// LabelRender für Achsenbeschriftung, um Einheiten wie kWh, ct/kWh oder € anzuhängen
    /// </summary>
    /// <param name="args"></param>
    public void LabelRender(AxisLabelRenderEventArgs args)
    {
        // Absicherung gegen Null-Werte beim Laden/ Rendern der Achsen
        if (args?.Axis?.Name == null) return;

        // 1. Das passende Suffix anhand des Achsennamens ermitteln
        string? suffix = args.Axis.Name switch
        {
            "yAxisCons_kWh" => " kWh",
            "yAxisCost_kWh" => " ct/kWh",
            "yAxisCost_Total" => " €",
            _ => null // Fallback für andere Achsen
        };

        // 2. String elegant anhängen, falls eine bekannte Achse getroffen wurde
        if (suffix != null)
        {
            args.Text += suffix;
        }
    }
    #endregion

    #region ToolTipRenderEvent
    /// <summary>
    /// Anzeige von x Nachkommastellen im Tooltip!
    /// </summary>
    /// <param name="args"></param>
    public void ToolTipRenderEvent(SharedTooltipRenderEventArgs args)
    {
        if (args?.Data == null || args.Text == null) return;

        for (int i = 0; i < args.Data.Count; i++)
        {
            var di = args.Data[i];
            if (di?.PointY == null) continue;

            // 1. Numerischen Wert direkt ermitteln ohne String-Fallback wo möglich
            if (!TryGetDouble(di.PointY, out double y)) continue;

            // 2. Einheit über Pattern Matching (C# 8+) ermitteln
            string? unit = di.SeriesName switch
            {
                "Kosten" => "ct/kWh",
                "Verbrauch" => "kWh",
                "Gesamtkosten" => "€",
                _ => null
            };

            // 3. String-Zuweisung absichern (Index-Check)
            if (unit != null && i < args.Text.Count)
            {
                // Nachkommastellen
                string decimalFormat = di.SeriesName == "Kosten" ? "N2" : "N0";

                args.Text[i] = $"{di.SeriesName}: {y.ToString(decimalFormat, DisplayCulture)} {unit}";
            }
        }
    }
    #endregion
}