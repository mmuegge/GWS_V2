    private async Task YesClick()
    {
        // 1. Schließt das Fenster optisch sofort im C#-State
        DialogVisible = false;
        StateHasChanged();

        // 2. GIBT SYNCFUSION DIE NÖTIGE ZEIT (150ms), UM DAS GRAUE OVERLAY SAUBER ABZUBAUEN!
        await Task.Delay(150);

        if (gwsP is null || paymentData is null || currentOperation == GridOperation.None) return;

        try
        {
            bool isSuccess = false;
            string successMessage = string.Empty;
            string defaultErrorMessage = "Aktion konnte nicht ausgeführt werden.";

            apiResponse = null;

            switch (currentOperation)
            {
                case GridOperation.Add:
                    apiResponse = await gwsP.PostDataAsync<GWS_PaymentModel>(urlPayment, paymentData);
                    isSuccess = apiResponse?.MyHttpStatusCode == HttpStatusCode.Created;
                    successMessage = "Datensatz erfolgreich gespeichert!";
                    defaultErrorMessage = "Datensatz konnte nicht gespeichert werden.";
                    break;

                case GridOperation.Edit:
                    string urlEdit = $"{urlPayment.TrimEnd('/')}/{paymentData.ID_Zahlung}";
                    apiResponse = await gwsP.UpdateDataAsync<GWS_PaymentModel>(urlEdit, paymentData);
                    isSuccess = apiResponse?.MyHttpStatusCode == HttpStatusCode.NoContent;
                    successMessage = "Datensatz erfolgreich aktualisiert!";
                    defaultErrorMessage = "Datensatz konnte nicht aktualisiert werden.";
                    break;

                case GridOperation.Delete:
                    string deleteUrl = urlPayment.EndsWith("/") ? urlPayment : urlPayment + "/";
                    string idToDelete = paymentData.ID_Zahlung.ToString();

                    var deletedData = await gwsP.DeleteDataAsync<GWS_PaymentModel>(deleteUrl, idToDelete);
                    isSuccess = deletedData is not null;
                    successMessage = "Datensatz erfolgreich gelöscht!";
                    defaultErrorMessage = "Datensatz konnte nicht gelöscht werden.";
                    break;
            }

            if (isSuccess)
            {
                ShowToast(true, successMessage);

                // Schutz für den asynchronen ValueSelectHandler aktivieren
                isReloadingAfterSave = true;
                isSaving = true;

                if (currentOperation == GridOperation.Delete)
                {
                    var itemToRemove = paymentList?.FirstOrDefault(x => x.ID_Zahlung == paymentData.ID_Zahlung);
                    if (itemToRemove is not null) paymentList?.Remove(itemToRemove);

                    // NUR wenn nach dem Löschen wirklich absolut KEINE Daten mehr da sind,
                    // darf sich die Infobox mit dem Text neu öffnen!
                    if (paymentList == null || !paymentList.Any())
                    {
                        header = "Keine Strom-Zahlungen vorhanden!";
                        showDialogButtons = false;
                        DialogVisible = true;
                    }
                    else
                    {
                        DialogVisible = false; // Sicherstellen, dass das Fenster zu bleibt
                    }
                }
                else if (currentOperation == GridOperation.Add || currentOperation == GridOperation.Edit)
                {
                    paymentList = await gwsP.LoadDataAsync<GWS_PaymentModel>($"{urlPaymentsSupplier}{supplierData!.Id}");

                    if (paymentList == null || !paymentList.Any())
                    {
                        header = "Keine Strom-Zahlungen vorhanden!";
                        showDialogButtons = false;
                        DialogVisible = true;
                    }
                    else
                    {
                        DialogVisible = false;
                    }
                }
            }
            else
            {
                string errorMessage = defaultErrorMessage;
                if (apiResponse is not null && !string.IsNullOrWhiteSpace(apiResponse.MyResponseString))
                {
                    errorMessage = $"Fehler ({apiResponse.MyHttpStatusCode}): {apiResponse.MyResponseString}";
                }
                ShowToast(false, errorMessage);
            }

            if (sfDataGrid is not null)
            {
                await sfDataGrid.Refresh();
            }
        }
        catch (Exception ex)
        {
            ShowToast(false, $"Netzwerkfehler: {ex.Message}");
        }
        finally
        {
            // 1. Wenn nach der Aktion noch Einträge in der Tabelle sind,
            // halten wir den Dialog absolut und bedingungslos geschlossen!
            if (paymentList != null && paymentList.Any())
            {
                DialogVisible = false;
            }
            else
            {
                // Nur wenn die Liste wirklich komplett leer ist, bereiten wir
                // das Flag für die Anzeige der Infobox vor
                showDialogButtons = false;
            }

            currentOperation = GridOperation.None;
            isSaving = false;
            isReloadingAfterSave = false;

            // 2. Blazor anweisen, die UI flüssig und ohne Blockaden neu zu zeichnen
            StateHasChanged();
        }
    }




