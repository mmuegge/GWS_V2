    private void OnCustomEditClick(GWS_PaymentModel model)
    {
        if (model is null) return;

        paymentData = new GWS_PaymentModel
        {
            ID_Zahlung = model.ID_Zahlung,
            ID_Anbieter = model.ID_Anbieter,
            Anbieter = model.Anbieter,
            Datum = model.Datum,
            Zahlungsart = model.Zahlungsart,
            Zahlungen = model.Zahlungen,
            Bemerkungen = model.Bemerkungen
        };

        currentOperation = GridOperation.Edit;
        FormDialogTitle = "Einzahlung bearbeiten";

        // Wichtig: Sichtbarkeit einschalten und Blazor zum Zeichnen zwingen
        IsFormDialogVisible = true;
        StateHasChanged();
    }

    private void OnCustomDeleteClick(GWS_PaymentModel model)
    {
        if (model is null || model.ID_Zahlung <= 0) return;

        paymentData = model;
        currentOperation = GridOperation.Delete;

        // Sicherheitsabfrage befüllen
        DialogHeader = "Datensatz wirklich löschen ?";
        DialogMessage = "Möchten Sie diesen Eintrag unwiderruflich aus der Datenbank entfernen?";

        // Wichtig: Sichtbarkeit einschalten und Blazor zum Zeichnen zwingen
        DialogVisible = true;
        StateHasChanged();
    }

    // --- 1. DIREKT-KLICK AUF HINZUFÜGEN ---
    private void OnToolbarAddClick()
    {
        if (paymentList is null || paymentsMethodList is null || paymentData is null)
        {
            paymentData = new GWS_PaymentModel
            {
                Datum = DateTime.Today,
                ID_Zahlung = 0,
                Zahlungsart = "Abschlag"
            };
        }
        else
        {
            paymentData.Datum = DateTime.Today;

            var lastPayment = paymentList?.LastOrDefault();
            if (lastPayment != null)
            {
                paymentData.ID_Anbieter = lastPayment.ID_Anbieter;
                paymentData.Anbieter = lastPayment.Anbieter;
                paymentData.Zahlungsart = lastPayment.Zahlungsart;
                paymentData.Zahlungen = lastPayment.Zahlungen;
                paymentData.Bemerkungen = lastPayment.Bemerkungen;
            }
            
        }

        // paymentData = new GWS_PaymentModel
        // {
        //     Datum = DateTime.Now,
        //     ID_Zahlung = 0,
        //     Zahlungsart = paymentsMethodList?.FirstOrDefault()?.Zahlungsart ?? ""
        // };

        currentOperation = GridOperation.Add;
        FormDialogTitle = "Einzahlung: neue Einzahlung";

        // Wichtig: Sichtbarkeit einschalten und Blazor zum Zeichnen zwingen
        IsFormDialogVisible = true;

        StateHasChanged();
    }

    // --- 2. DIREKT-KLICK AUF EXCEL-EXPORT ---
    private async Task OnToolbarExcelClick()
    {
        try
        {
            IsExporting = true;
            string dateSuffix = DateTime.Now.ToString("ddMMyyyy");

            var excelExportProperties = new ExcelExportProperties
            {
                FileName = $"Stromanbieter_{dateSuffix}.xlsx",
                Theme = new ExcelTheme
                {
                    Header = new ExcelStyle { FontName = "Calibri", FontSize = 12, Bold = true },
                    Record = new ExcelStyle { FontName = "Calibri", FontSize = 10, Bold = false }
                }
            };

            await ToggleActionColumnsAsync(hide: true);
            await sfDataGrid.ExportToExcelAsync(excelExportProperties);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export fehlgeschlagen: {ex.Message}");
        }
        finally
        {
            await ToggleActionColumnsAsync(hide: false);
            IsExporting = false;
        }
    }

    private async Task OnToolbarPdfClick()
    {
        try
        {
            IsExporting = true;
            string dateSuffix = DateTime.Now.ToString("ddMMyyyy");

            var pdfExportProperties = new PdfExportProperties
            {
                IsRepeatHeader = true,
                FileName = $"Stromanbieter_{dateSuffix}.pdf",
                PageOrientation = Syncfusion.Blazor.Grids.PageOrientation.Landscape,
                Header = new PdfHeader { FromTop = 0, Height = 80, Contents = HeaderContent },
                Footer = new PdfFooter { FromBottom = 0, Height = 80, Contents = FooterContent },
                Theme = new PdfTheme
                {
                    Header = new PdfThemeStyle { FontColor = "Blue", FontName = "Calibri", FontSize = 8, Bold = true }
                }
            };

            await ToggleActionColumnsAsync(hide: true);
            await sfDataGrid.ExportToPdfAsync(pdfExportProperties);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export fehlgeschlagen: {ex.Message}");
        }
        finally
        {
            await ToggleActionColumnsAsync(hide: false);
            IsExporting = false;
        }
    }

