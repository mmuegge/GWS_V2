    #region GetDialogHeader
    /// <summary>
    /// GetDialogHeader
    /// </summary>
    /// <param name="payment"></param>
    /// <returns></returns>
    public string GetDialogHeader(GWS_PaymentModel? payment) =>
      payment is not { ID_Zahlung: > 0 }
          ? "Einzahlung: neue Einzahlung"
          : $"Einzahlung: {payment.Datum:dd.MM.yyyy}";
