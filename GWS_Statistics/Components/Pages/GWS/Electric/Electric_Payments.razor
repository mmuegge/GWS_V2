    private void SaveForm()
    {
        // 1. Eingabemaske schließen
        IsFormDialogVisible = false;

        // 2. Texte für den Dialog vorbereiten (wie gehabt)
        if (currentOperation == GridOperation.Add)
        {
            header = "Datensatz speichern ?";
        }
        else if (currentOperation == GridOperation.Edit)
        {
            header = "Datensatz ändern ?";
        }

        // 3. WICHTIG: Die Knöpfe für die Bestätigung explizit EINSCHALTEN!
        showDialogButtons = true;

        // 4. Bestätigungs-Popup öffnen
        DialogVisible = true;

        // 5. Erst JETZT das Flag setzen, um asynchrone Doppelklicks im Hintergrund zu blockieren
        isSaving = true;

        StateHasChanged();
    }

    // Logik für deinen neuen Abbrechen-Button
    private void CloseForm()
    {
        IsFormDialogVisible = false;

        // Zwingt die Box im C#-Code zu, wenn manuell abgebrochen wird
        DialogVisible = false;

        if (!isSaving)
        {
            paymentData = null;
            currentOperation = GridOperation.None;
        }

        StateHasChanged();
}
