@page "/electric_payments"

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Electric_Payments> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService

<PageTitle>Strom- Zahlungen</PageTitle>

<div class="container">
    <div class="row">
        <div class="text-center fs-3 fw-bold">
            <span class="fa-solid fa-plug fa-3xs" aria-hidden="true"> </span>
            <label>Strom- Zahlungen</label>
        </div>
    </div>
</div>

@* Auswahl Anbieter *@
<div class="card shadow-lg p-2 mb-1">
    @* <- p-2 für den Abstand zum Schatten hinzugefügt *@
    @* Auswahl Anbieter und Anzeigen Start-Datum/Ende-Datum*@
    @* container-fluid --> Breite = 100% *@
    <div class="container-fluid bg-color-grey pb-2 border">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    <SfDropDownList DataSource="@supplierDataList" TItem="Electric_SupplierDataModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData.Id">
                        <DropDownListFieldSettings Text="Anbieter" Value="Id"></DropDownListFieldSettings>
                        <DropDownListEvents TItem="Electric_SupplierDataModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                    </SfDropDownList>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@startDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@endDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>
</div>

@* Grid *@
<div class="control-section" id="target" align="left">
    <SfGrid ID="Grid" @ref="SfDataGrid" 
            DataSource="@paymentList"
            AllowPaging="true"
            AllowFiltering="true"
            AllowReordering="true"
            AllowResizing="true"
            AllowExcelExport="true"
            AllowPdfExport="true"
            EnableHover="true"
            AllowTextWrap="true"
            AllowSelection="true"
            AllowSorting="true"
            Height="100%" 
            Width="100%"
            Toolbar=@toolbar
            EnableStickyHeader="true">

        <GridEditSettings AllowAdding="true"
            AllowEditing="true"
            AllowDeleting="true"
            ShowDeleteConfirmDialog="true"
            Mode="Syncfusion.Blazor.Grids.EditMode.Dialog"
            Dialog="DialogParams">

            <HeaderTemplate>
                @{
                    var DialogHeader = GetDialogHeader((context as GWS_PaymentModel));
                    <span>@DialogHeader</span>
                }
            </HeaderTemplate>
        </GridEditSettings>

        <GridEvents OnToolbarClick="ToolbarBtnClickHandler"
                    RowCreating="RowCreatingHandler"
                    RowEditing="RowEditingHandler"
                    OnActionComplete="ActionCompleteHandler"
                    TValue="GWS_PaymentModel">
        </GridEvents>

        <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>

        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

        <GridSortSettings>
            <GridSortColumns>
                <GridSortColumn 
                    Field="Datum" 
                    Direction="SortDirection.Descending">
                </GridSortColumn>
            </GridSortColumns>
        </GridSortSettings>

        <GridAggregates>
            <GridAggregate>
                <GridAggregateColumns>
                    <GridAggregateColumn Field="@nameof(GWS_PaymentModel.Zahlungen)" Type="AggregateType.Sum" Format="C2">
                        <FooterTemplate>
                            @{
                                var SumValue = (context as AggregateTemplateContext);
                                <div>
                                    &sum; : @SumValue!.Sum
                                </div>
                            }
                        </FooterTemplate>
                    </GridAggregateColumn>
                </GridAggregateColumns>
            </GridAggregate>
        </GridAggregates>

        <GridColumns>
            <GridColumn IsPrimaryKey="true" Field="@nameof(GWS_PaymentModel.ID_Zahlung)" Visible="false"
                AllowAdding="false"
                AllowEditing="false"
                AllowSorting="false"
                AllowFiltering="false"
                Width="35">
            </GridColumn>

            <GridColumn Field=@nameof(GWS_PaymentModel.Anbieter)
                        Width="200"
                        EditType="EditType.DropDownEdit"
                        HeaderText="Anbieter">

                <EditTemplate>
                    <SfDropDownList Placeholder="Anbieter"
                                    FloatLabelType="FloatLabelType.Always"
                                    TValue="int?"
                                    TItem="Electric_SupplierDataModel"
                                    DataSource="@supplierDataList"
                                    @bind-Value="@DropDownValueSupplier">

                        <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                    </SfDropDownList>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Anbieter")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Anbieter</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(GWS_PaymentModel.Datum)
                        Format="d"
                        EditType="EditType.DatePickerEdit"
                        Width="110"
                        DefaultValue="DateTime.Now"
                        HeaderText="Datum">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Datum")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Datum</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(GWS_PaymentModel.Zahlungsart)
            EditType="EditType.DropDownEdit"
            Width="110"
            HeaderText="Zahlungsart">

                <EditTemplate>
                    <SfDropDownList Placeholder="Zahlungsart"
                                    FloatLabelType="FloatLabelType.Always"
                                    TItem="GWS_PaymentsMethodModel"
                                    TValue="string"
                                    DataSource="@paymentsMethodList"
                                    @bind-Value="@((context as GWS_PaymentModel)!.Zahlungsart)">

                        <DropDownListFieldSettings Value="Zahlungsart" Text="Zahlungsart"></DropDownListFieldSettings>
                    </SfDropDownList>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Art")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Art</b></span>
                    </SfTooltip>
                </HeaderTemplate>

            </GridColumn>

            <GridColumn Field=@nameof(GWS_PaymentModel.Zahlungen)
            Format="C2"
            EditType="EditType.NumericEdit"
            Width="110"
            HeaderText="Betrag">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Betrag"
                                      FloatLabelType="FloatLabelType.Always"
                                      TValue="Double?"
                                      @bind-Value="@((context as GWS_PaymentModel)!.Zahlungen)"
                                      Format="C2">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Betrag")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Betrag</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(GWS_PaymentModel.Bemerkungen)
            Width="300"
            HeaderText="Bemerkung">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Bemerkung")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Bemerkung</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                <GridCommandColumns>
                    <GridCommandColumn Type="CommandButtonType.Edit"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Delete"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Save"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Cancel"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                </GridCommandColumns>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfSpinner @bind-Visible="@spinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

@* Dialog*@
<div>
    <SfDialog Target="#target"
                      Width="@dialogWidth"
                      Height="@dialogHeight"
                      AllowDragging="true"
                      ShowCloseIcon="true"
                      @bind-Visible="@DialogVisible"
                      AllowPrerender="true"
                      IsModal="true" 
                      CssClass="MyCss">

        <DialogTemplates>
            <Header>@Header</Header>
        </DialogTemplates>

        <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>
        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

        @if (showDialogButtons)
        {
            <DialogButtons>
                <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
            </DialogButtons>
                }
    </SfDialog>
</div>

<style>
    .e-dlg-overlay {
    background-color: slategray;
    opacity: 0.6;
    }

    /* Dialog Editing*/
    .e-dialog .e-dlg-header-content {
    background-color: grey;
    font-size: 24px;
    }

    .e-dialog .e-dlg-header {
    color: white;
    }

    .e-dialog .e-dlg-content {
    color: white;
    background-color: lightgray;
    font-size: 16px;
    }

    .bg-color-grey {
    background: #deded9;
    }

    #toast_default .e-circle-check::before {
    content: "\e72b";
    font-size: 17px;
    }

    #toast_default .e-circle-close::before {
    content: "\e878";
    font-size: 17px;
    }

    .control-wrapper {
    max-width: 250px;
    min-width: 80px;
    margin: 0 auto;
    }

    .control-label {
    font-size: 14px;
    margin: 6px 0px;
    }

    /* Dialog: Datensatz ändern/löschen */
    .MyCss .e-dlg-header-content {
    background-color: red;
    }
</style>

@code
{
    #region Variablendeklaration
    public bool spinnerVisibleProperty { get; set; } = false;

    private DialogSettings DialogParams = new DialogSettings { MinHeight = "400px", Width = "450px" };
    public DialogEffect animationEffect = DialogEffect.Zoom;
    public bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string DialogText { get; set; } = string.Empty;
    private string dialogXValue = "center";
    private string dialogYValue = "center";
    private string dialogHeight = "130px";
    private string dialogWidth = "380px";

    public int? DropDownValueSupplier { get; set; } = 0;
    public int? DropDownValuePaymentsMethod { get; set; } = 1;

    private bool save = false;
    private bool update = false;
    private bool success = false;

    readonly string urlSupplier = "strom/anbieter/";
    readonly string urlPaymentsSupplier = "strom/zahlungen/anbieter/";
    readonly string urlPaymentsMethod = "strom/zahlungsart/";
    readonly string urlPayment = "strom/zahlung/";

    string? Header { get; set; }
    string? Content { get; set; }

    GWSProcessor? gwsP;
    ApiResponse? apiResponse;

    private SfGrid<GWS_PaymentModel> SfDataGrid = new();
    private List<Electric_SupplierDataModel>? supplierDataList = new();
    private List<GWS_PaymentsMethodModel>? paymentsMethodList = new();

    private Electric_SupplierDataModel supplierData = new();
    private List<GWS_PaymentModel>? paymentList = new();
    private GWS_PaymentModel paymentData = new();
    private GWS_PaymentsMethodModel paymentsMethod = new();

    private List<object> toolbar = new List<object>() { "Add", "Cancel", "Search", "ExcelExport", "PdfExport" };

    public DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    public DateTime MaxDate { get; set; } = DateTime.Now;
    public DateTime? startDate { get; set; } = new DateTime(2000, 1, 1);
    public DateTime? endDate { get; set; } = new DateTime(2000, 1, 1);

    MyAppConfigModel? settings;

    // Dictionary for column descriptions
    public Dictionary<string, string> ColumnDescriptions = new()
    {
        { "Anbieter", "Anbieter" },
        { "Datum", "Zahlungs-Datum" },
        { "Art", "Zahlungs-Art" },
        { "Betrag", "Betrag" },
        { "Bemerkung", "Bemerkung" }
    };

    // PDF-Export Properties
    public List<PdfHeaderFooterContent> HeaderContent = new List<PdfHeaderFooterContent>
    {
    new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 4, X2 = 720, Y2 = 4}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },
    new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Strom-Zählerstände", Position = new PdfPosition() { X = 350, Y = 20 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
    new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 40, X2 = 720, Y2 = 40}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },

    new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 8, HAlign = PdfHorizontalAlign.Right } }
    };

    public List<PdfHeaderFooterContent> FooterContent = new List<PdfHeaderFooterContent>
    {
        // new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Seite: ", Position = new PdfPosition() { X = 400, Y = 600 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
        // new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 10, HAlign = PdfHorizontalAlign.Right } }
    };

    #endregion

    #region OnInitializedAsync
    protected override async Task OnInitializedAsync()
    {
        // 1. Spinner sofort einschalten
        spinnerVisibleProperty = true;

        try
        {
            // Settings und API-Prozessor initialisieren
            settings = GetSetMyAppConfig.GetMyAppSettings.ReadSettings(myAppSettings);
            if (settings == null) return;

            gwsP = new GWSProcessor(myHttpClient, settings.GWSUri);

            // Anbieterdaten auslesen
            supplierDataList = await gwsP.LoadDataAsync<Electric_SupplierDataModel>(urlSupplier);

            if (supplierDataList != null && supplierDataList.Any())
            {
                // ID sicher ermitteln (Verhindert Absturz, falls Parse fehlschlägt)
                if (!string.IsNullOrEmpty(settings.Supplier_Id?.Electric) && int.TryParse(settings.Supplier_Id.Electric, out int savedId))
                {
                    supplierData.Id = savedId;
                }
                else
                {
                    supplierData.Id = supplierDataList.Max(x => x.Id);
                }

                // Performance-Boost: Den gewählten Anbieter nur EINMAL suchen
                var currentSupplier = supplierDataList.FirstOrDefault(c => c.Id == supplierData.Id);
                if (currentSupplier != null)
                {
                    startDate = currentSupplier.Zeitraum_Start;
                    endDate = currentSupplier.Zeitraum_Ende;
                }
            }
            else
            {
                supplierData.Id = 0;
            }

            // Zahlungen anbieterabhängig auslesen
            if (supplierData.Id > 0)
            {
                paymentList = await gwsP.LoadDataAsync<GWS_PaymentModel>($"{urlPaymentsSupplier}{supplierData.Id}");
                if (paymentList == null || !paymentList.Any())
                {
                    OpenDialog("Keine Strom-Zahlungen vorhanden!", "60px", "380px", false);
                }
            }

            // Zahlungsarten laden
            paymentsMethodList = await gwsP.LoadDataAsync<GWS_PaymentsMethodModel>(urlPaymentsMethod);
        }
        catch (Exception ex)
        {
            // Stacktrace erhalten durch Mitgabe der Original-Exception (ex)
            throw new Exception("Es konnten keine Strom-Zahlungen geladen werden.", ex);
        }
        finally
        {
            // Spinner GARANTIERT ausschalten (künstliches Delay entfernt)
            spinnerVisibleProperty = false;
        }
    }
    #endregion

    #region ValueSelectHandler
    /// <summary>
    /// Auslesen Ablesetage des neuen ausgewählten Anbieters
    /// </summary>
    /// <param name="args"></param>
    private async Task ValueSelectHandler(SelectEventArgs<Electric_SupplierDataModel> args)
    {
        // 1. Guard Clauses: Abbrechen, wenn Argumente oder API-Service fehlen
        if (args?.ItemData == null || gwsP == null) return;

        supplierData = args.ItemData;

        if (supplierData.Id > 0)
        {
            // 2. Spinner SOFORT einschalten, bevor die asynchronen Aktionen starten
            spinnerVisibleProperty = true;

            try
            {
                // Einstellungen schreiben
                success = GetSetMyAppConfig.SetMyAppSettings.WriteSettings(myAppSettings, "Supplier_Id.Water", supplierData.Id.ToString());

                // Zeiträume zuweisen
                startDate = supplierData.Zeitraum_Start;
                endDate = supplierData.Zeitraum_Ende;

                // API-Aufruf (Der Spinner läuft währenddessen im Hintergrund)
                paymentList = await gwsP.LoadDataAsync<GWS_PaymentModel>($"{urlPaymentsSupplier}{supplierData.Id}");

                if (paymentList == null || !paymentList.Any())
                {
                    OpenDialog("Keine Strom-Zahlungen vorhanden!", "60px", "380px", false);
                }

                // Grid asynchron aktualisieren
                if (SfDataGrid != null)
                {
                    await SfDataGrid.Refresh();
                }
            }
            finally
            {
                // 3. Spinner GARANTIERT wieder ausschalten (auch im Fehlerfall)
                spinnerVisibleProperty = false;
            }
        }
    }

    #endregion

    #region ToolbarBtnClickHandler
    /// <summary>
    /// ToolbarBtnClickHandler
    ///
    /// </summary>
    /// <param name="args"></param>
    public async Task ToolbarBtnClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        // 1. Guard Clauses: Sicherstellen, dass Argumente und das Grid existieren
        if (args?.Item?.Id == null || SfDataGrid == null) return;

        string dateSuffix = $"{DateTime.Now:ddMMyyyy}";
        string itemId = args.Item.Id;

        // --- FALL 1: EXCEL EXPORT ---
        if (itemId.Contains("_excelexport"))
        {
            ExcelExportProperties excelExportProperties = new()
            {
                FileName = $"Stromzaehler_{dateSuffix}.xlsx",
                Theme = new()
                {
                    Header = new() { FontName = "Calibri", FontSize = 12, Bold = true },
                    Record = new() { FontName = "Calibri", FontSize = 10, Bold = false }
                }
            };

            await SfDataGrid.ExportToExcelAsync(excelExportProperties);
        }
        // --- FALL 2: PDF EXPORT ---
        else if (itemId.Contains("_pdfexport"))
        {
            PdfExportProperties pdfExportProperties = new()
            {
                IsRepeatHeader = true,
                FileName = $"Stromanbieter_{dateSuffix}.pdf",
                PageOrientation = Syncfusion.Blazor.Grids.PageOrientation.Landscape,
                Header = new() { FromTop = 0, Height = 80, Contents = HeaderContent },
                Footer = new() { FromBottom = 0, Height = 80, Contents = FooterContent },
                Theme = new()
                {
                    Header = new() { FontColor = "Blue", FontName = "Calibri", FontSize = 8, Bold = true }
                }
            };

            await SfDataGrid.ExportToPdfAsync(pdfExportProperties);
        }
        // --- FALL 3: XML EXPORT (Ungenutzt) ---
        else if (itemId.Contains("XmlExport"))
        {
            // Wenn nicht genutzt, reicht ein simpler Kommentar, ohne Konsolenausgabe
        }
    }
    #endregion

    #region ActionCompleteHandler
    /// <summary>
    /// ActionCompleteHandler
    /// </summary>
    /// <param name="args"></param>
    public async Task ActionCompleteHandler(ActionEventArgs<GWS_PaymentModel> args)
    {
        if (args == null) return;

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save)
        {
            // Zentralisierte Zuweisung für Add und Edit
            paymentData = args.Data!;
            if (paymentData == null) return;

            if (args.Action == "Add")
            {
                save = true;
                OpenDialog("Datensatz speichern ?", "130px", "220px", true);
            }
            else if (args.Action == "Edit")
            {
                // Prüfen, ob der Anbieter im Dropdown geändert wurde
                if (DropDownValueSupplier != null && DropDownValueSupplier != paymentData.ID_Anbieter)
                {
                    // Performance-Boost: FirstOrDefault direkt mit Prädikat (sucht nur bis zum ersten Treffer)
                    var anbieterName = supplierDataList?
                        .FirstOrDefault(s => s.Id == DropDownValueSupplier)?
                        .Anbieter;

                    if (anbieterName != null)
                    {
                        paymentData.ID_Anbieter = DropDownValueSupplier.Value;
                        paymentData.Anbieter = anbieterName;
                    }
                }

                update = true;
                OpenDialog("Datensatz ändern ?", "130px", "220px", true);
            }
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Delete)
        {
            var dataToDelete = args.Data;
            if (dataToDelete == null) return;

            if (dataToDelete.ID_Zahlung == 0)
            {
                // Sicherstellen, dass gwsP nicht null ist (?.)
                paymentList = await gwsP?.LoadDataAsync<GWS_PaymentModel>($"{urlPaymentsSupplier}{supplierData.Id}")!;
            }
            else
            {
                // ToString() statt Convert.ToString() bei garantiertem int, kombiniert mit String-Interpolation
                paymentData = await gwsP?.DeleteDataAsync<GWS_PaymentModel>(urlPayment, dataToDelete.ID_Zahlung.ToString())!;
                ShowToastMessage(true, "Datensatz gelöscht!");
            }

            if (SfDataGrid != null)
            {
                await SfDataGrid.Refresh(); // Syncfusion Grid-Refresh ist in der Regel async
            }
        }
    }
    #endregion

    #region CancelClick
    /// <summary>
    /// CancelClick
    /// </summary>
    ///
    private async Task CancelClick()
    {
        DialogVisible = false;

        // Guard Clause: Abbrechen, wenn benötigte Objekte oder IDs fehlen
        if (gwsP == null || supplierData == null) return;

        // Performante String-Interpolation statt Convert.ToString und sicherer API-Aufruf
        string url = $"{urlPaymentsSupplier}{supplierData.Id}";
        paymentList = await gwsP.LoadDataAsync<GWS_PaymentModel>(url);

        if (SfDataGrid != null)
        {
            await SfDataGrid.Refresh(); // Syncfusion Grid-Refresh ist in der Regel async
        }
    }
    #endregion

    #region YesClick
    /// <summary>
    /// YesClick
    /// </summary>
    ///
    private async Task YesClick()
    {
        DialogVisible = false;

        // 1. Frühzeitiger Abbruch (Guard Clause), wenn keine Daten vorhanden sind
        if (paymentData == null || gwsP == null) return;

        bool isSuccess = false;

        if (save)
        {
            save = false; // Direkt zurücksetzen, um Doppel-Klicks abzufangen
            apiResponse = await gwsP.PostDataAsync<GWS_PaymentModel>(urlPayment, paymentData);
            isSuccess = apiResponse?.MyHttpStatusCode == HttpStatusCode.Created;
        }
        else if (update)
        {
            update = false; // Direkt zurücksetzen
            string url = $"{urlPayment}{paymentData.ID_Zahlung}"; // Sauberere String-Verkettung

            apiResponse = await gwsP.UpdateDataAsync<GWS_PaymentModel>(url, paymentData);
            // Hier fehlte die Prüfung! Angenommen, OK oder NoContent ist der Erfolgsstatus:
            isSuccess = apiResponse?.MyHttpStatusCode == HttpStatusCode.OK || apiResponse?.MyHttpStatusCode == HttpStatusCode.NoContent;
        }

        // 2. Gemeinsame Logik für Erfolg/Fehler zusammenfassen
        if (isSuccess)
        {
            string msg = save ? "Datensatz gespeichert!" : "Datensatz aktualisiert!";
            ShowToastMessage(true, msg);

            // Daten aktualisieren
            paymentList = await gwsP.LoadDataAsync<GWS_PaymentModel>($"{urlPaymentsSupplier}{supplierData.Id}");

            if (SfDataGrid != null)
            {
                await SfDataGrid.Refresh();
            }
        }
        else if (save || update) // Nur Toast zeigen, wenn überhaupt eine Aktion stattgefunden hat
        {
            ShowToastMessage(false, "Fehler beim Speichern oder Aktualisieren der Daten!");
        }
    }
    #endregion

    #region ShowToastMessage
    /// <summary>
    /// ShowToastMessage
    /// </summary>
    /// <param name="success"></param>
    /// <param name="message"></param>
    /// <returns></returns>
    private void ShowToastMessage(bool success, string message)
    {
        // Die Parameter werden dynamisch anhand des Erfolgsstatus bestimmt
        string title = success ? "Erfolg" : "Fehler";
        string cssClass = success ? "e-toast-success" : "e-toast-danger";
        string icon = success ? "e-circle-check" : "e-circle-close";

        ShowToast(title, message, cssClass, icon);
    }
    #endregion

    #region ShowToast
    /// <summary>
    /// ShowToast
    /// </summary>
    /// <param name="title"></param>
    /// <param name="content"></param>
    /// <param name="cssClass"></param>
    /// <param name="icon"></param>
    private void ShowToast(string title, string content, string cssClass, string icon)
    {
        ToastService.Open(new()
        {
            Title = title,
            Content = content,
            CssClass = cssClass,
            Icon = icon
        });
    }
    #endregion

    #region GetTooltipContent
    /// <summary>
    /// GetTooltipContent
    /// </summary>
    /// <param name="headerText"></param>
    /// <returns></returns>
    public string GetTooltipContent(string headerText)
    {
        return ColumnDescriptions.ContainsKey(headerText) ? ColumnDescriptions[headerText] : "No description available.";
    }
    #endregion

    #region OpenDialog
    /// <summary>
    /// OpenDialog
    /// </summary>
    private void OpenDialog(string header, string height, string width, bool showButtons)
    {
        Header = header;
        dialogHeight = height;
        dialogWidth = width;
        showDialogButtons = showButtons;
        DialogVisible = true;
    }
    #endregion

    #region GetDialogHeader
    /// <summary>
    /// GetDialogHeader
    /// </summary>
    /// <param name="payment"></param>
    /// <returns></returns>
    public string GetDialogHeader(GWS_PaymentModel? payment)
    {
        return payment switch
        {
            null => "Keine Einzahlung vorhanden!",
            { ID_Zahlung: 0 } => "Einzahlung: neue Einzahlung",
            _ => $"Einzahlung: {payment.Datum:dd.MM.yyyy}"
        };
    }
    #endregion

    #region RowCreatingHandler
    /// <summary>
    /// ein neuer Datebsatz wird angelegt
    /// </summary>
    /// <param name="args"></param>
    public void RowCreatingHandler(RowCreatingEventArgs<GWS_PaymentModel> args)
    {
        // 1. Guard Clause: Wenn keine Anbieterdaten da sind, sofort abbrechen
        if (supplierData == null || args?.Data == null) return;

        // Anbieter-Daten zuweisen
        DropDownValueSupplier = supplierData.Id;
        args.Data.ID_Anbieter = supplierData.Id;

        // Kompaktes LINQ: Findet direkt den Anbieter-Namen
        args.Data.Anbieter = supplierDataList?
            .FirstOrDefault(x => x.Id == supplierData.Id)?
            .Anbieter;

        // 2. Bezahlmethode verarbeiten
        if (DropDownValuePaymentsMethod == 0)
        {
            // Wert aus der Liste anhand der Daten lesen
            var method = paymentsMethodList?
                .FirstOrDefault(c => c.Zahlungsart == args.Data.Zahlungsart);

            if (method != null)
            {
                DropDownValuePaymentsMethod = method.ID_Zahlungsart;
            }
        }
        else
        {
            // Wert aus der Liste anhand der ID lesen (Sicherer Null-Check statt !)
            args.Data.Zahlungsart = paymentsMethodList?
                .FirstOrDefault(a => a.ID_Zahlungsart == DropDownValuePaymentsMethod)?
                .Zahlungsart;
        }
    }
    #endregion

    #region RowEditingHandler
    /// <summary>
    /// Datenzeile wird editiert
    /// </summary>
    /// <param name="args"></param>
    public void RowEditingHandler(RowEditingEventArgs<GWS_PaymentModel> args)
    {
        // C# 8+ Null-Conditional Assignment: Zuweisung erfolgt nur, wenn args und Data nicht null sind
        if (args?.Data != null)
        {
            DropDownValueSupplier = args.Data.ID_Anbieter;
        }
    }
    #endregion
}
