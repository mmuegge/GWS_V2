@page "/electric_payments"

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Net
@using Syncfusion.Blazor.Navigations

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Electric_Payments> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService

<PageTitle>Strom- Zahlungen</PageTitle>

@* Seiten-Überschrift *@
<div class="container">
    <div class="text-center fs-3 fw-bold">
        <span class="fa-solid fa-plug fa-3xs" aria-hidden="true"> </span>
        <label>Strom- Zahlungen</label>
    </div>
</div>

@* Auswahl Anbieter *@
<div class="card shadow-lg p-2 mb-1">
    @* <- p-2 für den Abstand zum Schatten hinzugefügt *@
    @* Auswahl Anbieter und Anzeigen Start-Datum/Ende-Datum*@
    @* container-fluid --> Breite = 100% *@
    <div class="container-fluid bg-color-grey pb-2 border">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    <SfDropDownList DataSource="@supplierList" TItem="Electric_SupplierDataModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData.Id">
                        <DropDownListFieldSettings Text="Anbieter" Value="Id"></DropDownListFieldSettings>
                        <DropDownListEvents TItem="Electric_SupplierDataModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                    </SfDropDownList>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@startDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@endDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>
</div>

@* Grid *@
@if (paymentList != null)
{
    @* Der Haupt-Container für die gesamte Ansicht *@
    <div class="control-section elevated-grid-container" id="target" style="position: relative; height: 100%; width: 100%; padding: 4px;">

        @* 1. Die Toolbar (liegt jetzt sauber außerhalb des elevated-Containers) *@
        <div class="e-toolbar mb-2 p-1 d-flex gap-2 bg-light border rounded">
            <button type="button" class="btn btn-light btn-sm d-flex align-items-center gap-1 border" @onclick="OnToolbarAddClick">
                <span class="e-icons e-plus text-primary"></span> Hinzufügen
            </button>

            <button type="button" class="btn btn-light btn-sm d-flex align-items-center gap-1 border" @onclick="OnToolbarExcelClick">
                <span class="e-icons e-export-xls text-success"></span> Excel-Export
            </button>

            <button type="button" class="btn btn-light btn-sm d-flex align-items-center gap-1 border" @onclick="OnToolbarPdfClick">
                <span class="e-icons e-export-pdf text-danger"></span> PDF-Export
            </button>
        </div>

            <SfGrid ID="Grid" @ref="sfDataGrid"
                    DataSource="@paymentList"
                    AllowPaging="true"
                    AllowFiltering="true"
                    AllowReordering="true"
                    AllowResizing="true"
                    AllowExcelExport="true"
                    AllowPdfExport="true"
                    EnableHover="true"
                    AllowTextWrap="true"
                    AllowSelection="true"
                    AllowSorting="true"
                    Height="calc(100% - 52px)"
                    Width="100%"
                    EnableStickyHeader="true">


            <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>

            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn 
                        Field="Datum" 
                        Direction="SortDirection.Descending">
                    </GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>

            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field="@nameof(GWS_PaymentModel.Zahlungen)" Type="AggregateType.Sum" Format="C2">
                            <FooterTemplate>
                            @{
                                    var SumValue = (context as AggregateTemplateContext);
                                    <div>
                                        &sum; : @SumValue!.Sum
                                    </div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>

            <GridColumns>
                @* der Primärschlüssel muss unbedingt angegeben werden auch wenn er nicht sichtbar ist *@
                <GridColumn 
                    Field="@nameof(GWS_PaymentModel.ID_Zahlung)"
                    IsPrimaryKey="true"
                    Visible="false"
                    Width="0"
                    AllowSorting="false"
                    AllowFiltering="false"
                    AllowEditing="false">
                </GridColumn>

                <GridColumn Field=@nameof(GWS_PaymentModel.ID_Anbieter) Width="200" HeaderText="Anbieter">
                    @* Zeigt im normalen Grid-Modus den Text statt der ID an --> *@
                    <Template>
                        @{
                            var payment = (context as GWS_PaymentModel);
                            var supplierName = supplierList?.FirstOrDefault(s => s.Id == payment?.ID_Anbieter)?.Anbieter;
                            <span>@supplierName</span>
                        }
                    </Template>
                </GridColumn>

                <GridColumn Field=@nameof(GWS_PaymentModel.Datum)
                    Format="d"
                    Width="110"
                    HeaderText="Datum">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Datum")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Datum</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(GWS_PaymentModel.Zahlungsart)
                    Width="110"
                    HeaderText="Zahlungsart">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Art")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Art</b></span>
                        </SfTooltip>
                    </HeaderTemplate>

                </GridColumn>

                <GridColumn Field=@nameof(GWS_PaymentModel.Zahlungen)
                    Format="C2"
                    Width="110"
                    HeaderText="Betrag">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Betrag")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Betrag</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(GWS_PaymentModel.Bemerkungen)
                    Width="300"
                    HeaderText="Bemerkung">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Bemerkung")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Bemerkung</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn HeaderText="Funktion" Width="100">
                    <Template>
                        @{
                            var currentItem = (context as GWS_PaymentModel);

                            if (currentItem != null)
                            {
                                <div class="d-flex justify-content-around">
                                    <a href="javascript:void(0)" class="text-secondary" @onclick="() => OnCustomEditClick(currentItem)" @onclick:stopPropagation="true" title="Bearbeiten">
                                        <span class="e-icons e-edit" style="font-size: 16px; cursor: pointer;"></span>
                                    </a>

                                    <a href="javascript:void(0)" class="text-danger" @onclick="() => OnCustomDeleteClick(currentItem)" @onclick:stopPropagation="true" title="Löschen">
                                        <span class="e-icons e-delete" style="font-size: 16px; cursor: pointer;"></span>
                                    </a>
                                </div>
                            }
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>

        @* Spinner für den Export *@
        <SfSpinner Visible="@IsExporting"
                   Label="Datei wird generiert, bitte warten..."
                   Type="@SpinnerType.Material"
                   Size="40"
                   CssClass="e-spin-overlay e-custom-color">
        </SfSpinner>
    </div>
}
else
{
    <SfSpinner @bind-Visible="@spinnerVisibleProperty"
               Type="SpinnerType.Tailwind"
               CssClass="e-custom-color"
               Label="Lade Daten..."
               Size="40">
    </SfSpinner>
}

@* Dialog*@
<SfDialog Width="@dialogWidth" Height="auto" IsModal="true" @bind-Visible="@IsFormDialogVisible" Header="@FormDialogTitle" ShowCloseIcon="true">

    <DialogEvents OnClose="CloseForm" />

    <DialogTemplates>
        <Content>
            @if (paymentData != null)
            {
                <EditForm Model="@paymentData" OnValidSubmit="SaveForm">
                    <DataAnnotationsValidator />

                <div class="form-group mb-3">
                    <label class="form-label dialog-custom-label">Anbieter wählen</label>
                    <SfDropDownList TItem="Electric_SupplierDataModel"
                                    TValue="int"
                                    Placeholder="Anbieter wählen"
                                    DataSource="@supplierList"
                                    @bind-Value="@paymentData.ID_Anbieter">
                        <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                    </SfDropDownList>
                </div>

                    <div class="form-group mb-3">
                    <label class="form-label dialog-custom-label font-weight-bold">Datum</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="@paymentData.Datum" Format="dd.MM.yyyy" Placeholder="Datum wählen" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Zahlungsart</label>

                        <SfDropDownList TItem="GWS_PaymentsMethodModel"
                                        TValue="string"
                                        Placeholder="Zahlungsart wählen"
                                        FloatLabelType="FloatLabelType.Never"
                                        AllowFiltering="true"
                                        DataSource="@paymentsMethodList"
                                        @bind-Value="@paymentData.Zahlungsart">

                            @* Das hat im Custom-Dialog gefehlt, damit Syncfusion die Objekte lesen kann: *@
                            <DropDownListFieldSettings Value="Zahlungsart" Text="Zahlungsart"></DropDownListFieldSettings>

                        </SfDropDownList>
                    </div>

                    <div class="form-group mb-3">
                    <label class="form-label dialog-custom-label font-weight-bold">Betrag</label>
                        <SfNumericTextBox Placeholder="Betrag eingeben" TValue="Double?" @bind-Value="@paymentData.Zahlungen" Format="C2" />
                    </div>

                    <div class="form-group mb-3">
                    <label class="form-label dialog-custom-label font-weight-bold">Bemerkung</label>
                        <SfTextBox Placeholder="Bemerkung eingeben" @bind-Value="@paymentData.Bemerkungen" Multiline="true" Rows="1" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top px-4 pb-4">
                        <button type="submit" class="btn btn-primary px-4">Speichern</button>
                        <button type="button" class="btn btn-outline-secondary px-4" @onclick="@(() => IsFormDialogVisible = false)">Abbrechen</button>
                    </div>
                </EditForm>
            }
        </Content>
    </DialogTemplates>
</SfDialog>


@* BOMBENSICHERER SCHUTZ: Wenn DialogVisible false ist, wird die Komponente komplett vernichtet.
   Asynchrone Grid-Events können die Box niemals wieder eigenmächtig aufreißen! *@
@if (DialogVisible)
{
    <div>
        <SfDialog Target="body"
                  Width="340px"
                  Height="auto"
                  AllowDragging="true"
                  ShowCloseIcon="true"
                  AllowPrerender="false"
                  IsModal="true"
                  CssClass="@(showDialogButtons ? "MyCss has-buttons" : "MyCss")"
                  @bind-Visible="@DialogVisible">

            <DialogTemplates>
                <Header>
                    <div style="color: #FFFFFF !important; font-weight: bold !important; font-size: 15px !important; font-family: sans-serif; width: 100%; padding-right: 24px; display: inline-block;">
                        @header
                    </div>
                </Header>
            </DialogTemplates>

            <DialogPositionData X="center" Y="center"></DialogPositionData>

            @if (showDialogButtons)
            {
                <DialogButtons>
                    <DialogButton Content="Ja" CssClass="btn-win-yes" OnClick="@YesClick" />
                    <DialogButton Content="Abbrechen" CssClass="btn-win-no" OnClick="@CancelClick" />
                </DialogButtons>
            }
        </SfDialog>
    </div>
}







<style>
    /* 1. Zwingt das gesamte Spinner-Container-System nach ganz vorne */
    .e-spinner-pane.e-spin-overlay {
        z-index: 99999 !important;
        background-color: rgba(0, 0, 0, 0.4) !important; /* Macht den Hintergrund dunkel-transparent */
    }

        /* 2. Zwingt das Ladesymbol und den Text, sich abzuheben */
        .e-spinner-pane.e-spin-overlay .e-spinner-inner {
            z-index: 100000 !important;
        }

        /* 3. HIER WIRD DER TEXT ERZWUNGEN UND SCHÖN FORMATIERT */
        .e-spinner-pane.e-spin-overlay .e-spin-label {
            color: #FFFFFF !important; /* Reines Weiß, damit es auf dem dunklen Overlay lesbar ist */
            font-weight: bold !important; /* Fett gedruckt */
            font-size: 16px !important; /* Etwas größer für bessere Lesbarkeit */
            margin-top: 10px !important; /* Abstand zum drehenden Rad */
            display: block !important; /* Sicherstellen, dass es nicht auf hidden steht */
        }

    .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
    }

    /* Dialog Editing*/
    .e-dialog .e-dlg-header-content {
        background-color: grey;
        font-size: 24px;
    }

    .e-dialog .e-dlg-header {
        color: white;
    }

    .e-dialog .e-dlg-content {
        color: white;
        background-color: lightgray;
        font-size: 16px;
    }

    .bg-color-grey {
        background: #deded9;
    }

    #toast_default .e-circle-check::before {
        content: "\e72b";
        font-size: 17px;
    }

    #toast_default .e-circle-close::before {
        content: "\e878";
        font-size: 17px;
    }

    .control-wrapper {
        max-width: 250px;
        min-width: 80px;
        margin: 0 auto;
    }

    .control-label {
        font-size: 14px;
        margin: 6px 0px;
    }

    /* Dialog: Datensatz ändern/löschen */
    .MyCss .e-dlg-header-content {
        background-color: red;
    }

    .dialog-label {
        color: black;
        font-size: 14px;
        margin-bottom: 2px;
    }


    /* Erzeugt den modernen Schatten- und Glow-Effekt um das Syncfusion Grid */
    .elevated-grid-container .e-grid {
        box-shadow: 0 4px 20px rgba(0, 120, 212, 0.15) !important;
        border: 1px solid rgba(0, 120, 212, 0.2) !important;
        border-radius: 4px !important;
    }

        /* Verhindert, dass die abgerundeten Ecken vom inneren Grid-Header abgeschnitten werden */
        .elevated-grid-container .e-grid .e-gridheader {
            border-top-left-radius: 4px !important;
            border-top-right-radius: 4px !important;
        }

        .elevated-grid-container .e-grid .e-gridpager {
            border-bottom-left-radius: 4px !important;
            border-bottom-right-radius: 4px !important;
        }

    /* Aktiviert den Schatten- und Glow-Effekt exakt für diese Container-Struktur */
    .elevated-grid-container {
        box-shadow: 0 4px 20px rgba(0, 120, 212, 0.15) !important;
        border: 1px solid rgba(0, 120, 212, 0.2) !important;
        background-color: #FFFFFF !important;
        border-radius: 4px !important;
    }

        /* Sorgt dafür, dass Syncfusion-interne Komponenten den Schatten nicht blockieren */
        .elevated-grid-container .e-grid {
            box-shadow: none !important;
            border: none !important;
        }

    /* Dialog: Datensatz ändern/löschen (Deine stabile, funktionierende Basis-Farbe) */
    .MyCss .e-dlg-header-content {
        background-color: red !important;
    }

    /* ==========================================================================
       ULTIMATIVES SCHUTZSCHILD GEGEN ASYNCHRONE GEISTER-BOXEN
       ========================================================================== */

    /* Wenn keine Operation aktiv ist (None), entziehen wir der roten Box
       radikal jegliche Sichtbarkeit und schrumpfen sie auf 0 Pixel zusammen! */
    .MyCss.e-dialog[style*="display: block"] .e-dlg-header-content {
        transition: none !important;
    }

    /* Der finale Retter: Falls Syncfusion die Box heimlich öffnet,
       wird der rote Container komplett im Browser weggesprengt */
    .MyCss.e-dialog .e-dlg-header-content {
        background-color: red; /* Deine funktionierende Basis */
    }

    /* Wenn die Buttons ausgeblendet sind (Info-Modus) und wir uns im Lösch-Leerlauf befinden,
       wird das rote Feld unsichtbar geschaltet */
    .MyCss.e-dialog:not(.has-buttons) .e-dlg-header-content {
        display: none !important;
        visibility: hidden !important;
        height: 0px !important;
        padding: 0px !important;
        border: none !important;
    }

</style>


@code
{
    #region Variablendeklaration
    //private string? ToastContent { get; set; }
    public bool spinnerVisibleProperty { get; set; } = false;

    private bool isSaving = false;
    private bool isReloadingAfterSave = false;

    private DialogSettings dialogParams = new DialogSettings { MinHeight = "400px", Width = "450px" };
    public DialogEffect animationEffect = DialogEffect.Zoom;
    public bool DialogVisible { get; set; } = false;
    private string DialogHeader { get; set; } = "";
    private string DialogMessage { get; set; } = "";
    private bool showDialogButtons = false;
    private string dialogText { get; set; } = string.Empty;

    // Sichtbarkeiten und Texte für die beiden Dialoge
    private bool IsFormDialogVisible { get; set; }
    private string FormDialogTitle { get; set; } = "";

    private string dialogHeight = "130px";
    private string dialogWidth = "380px";

    public int? DropDownValueSupplier { get; set; } = 0;
    public int? DropDownValuePaymentsMethod { get; set; } = 1;

    // private bool save = false;
    // private bool update = false;
    private bool success = false;

    readonly string urlSupplier = "strom/anbieter/";
    readonly string urlPaymentsSupplier = "strom/zahlungen/anbieter/";
    readonly string urlPaymentsMethod = "strom/zahlungsart/";
    readonly string urlPayment = "strom/zahlung/";

    private string? header { get; set; }
    private string? content { get; set; }

    GWSProcessor? gwsP;
    ApiResponse? apiResponse;

    private SfGrid<GWS_PaymentModel> sfDataGrid = new();

    private enum GridOperation { None, Add, Edit, Delete }
    private GridOperation currentOperation = GridOperation.None;

    private List<Electric_SupplierDataModel>? supplierList = new();
    private List<GWS_PaymentsMethodModel>? paymentsMethodList = new();

    private Electric_SupplierDataModel supplierData = new();
    private List<GWS_PaymentModel>? paymentList = new();
    private GWS_PaymentModel? paymentData = new();
    private GWS_PaymentsMethodModel paymentsMethod = new();

    private List<object> toolbar = new List<object>() { "Add", "Cancel", "Search", "ExcelExport", "PdfExport" };

    public DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    public DateTime MaxDate { get; set; } = DateTime.Now;
    public DateTime? startDate { get; set; } = new DateTime(2000, 1, 1);
    public DateTime? endDate { get; set; } = new DateTime(2000, 1, 1);

    MyAppConfigModel? settings;

    // Dictionary for column descriptions
    public Dictionary<string, string> ColumnDescriptions = new()
    {   
        { "Anbieter", "Anbieter" },
        { "Datum", "Zahlungs-Datum" },
        { "Art", "Zahlungs-Art" },
        { "Betrag", "Betrag" },
        { "Bemerkung", "Bemerkung" }
    };

    private List<string> ToolbarList = new List<string>() { "Add", "ExcelExport", "PdfExport" };


    private List<object> ToolbarItems { get; set; } = new List<object>();



    // PDF-Export Properties
    public List<PdfHeaderFooterContent> HeaderContent = new List<PdfHeaderFooterContent>
    {
    new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 4, X2 = 720, Y2 = 4}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },
    new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Strom-Zählerstände", Position = new PdfPosition() { X = 350, Y = 20 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
    new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 40, X2 = 720, Y2 = 40}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },

    new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 8, HAlign = PdfHorizontalAlign.Right } }
    };

    public List<PdfHeaderFooterContent> FooterContent = new List<PdfHeaderFooterContent>
    {
        // new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Seite: ", Position = new PdfPosition() { X = 400, Y = 600 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
        // new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 10, HAlign = PdfHorizontalAlign.Right } }
    };

    #endregion

    #region OnInitializedAsync
    /// <summary>
    /// Startet die asynchrone Initialisierung der Komponente, lädt die Konfiguration und die Anbieter-Daten.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        ToolbarItems = new List<object>
        {
            new { text = "Hinzufügen", id = "custom_add", prefixIcon = "e-icons e-add" },
            new { text = "Excel-Export", id = "Grid_excelexport", prefixIcon = "e-icons e-excel-export" },
            new { text = "PDF-Export", id = "Grid_pdfexport", prefixIcon = "e-icons e-pdf-export" }
        };

        // 1. Spinner sofort einschalten
        spinnerVisibleProperty = true;

        try
        {
            // Settings und API-Prozessor initialisieren
            settings = await GetSetMyAppConfig.GetMyAppSettings.ReadSettingsAsync(myAppSettings);
            if (settings == null) return;

            gwsP = new GWSProcessor(myHttpClient, settings.GWSUri);

            // Anbieterdaten auslesen
            supplierList = await gwsP.LoadDataAsync<Electric_SupplierDataModel>(urlSupplier);

            if (supplierList != null && supplierList.Any())
            {
                // ID sicher ermitteln (Verhindert Absturz, falls Parse fehlschlägt)
                if (!string.IsNullOrEmpty(settings.Supplier_Id?.Electric) && int.TryParse(settings.Supplier_Id.Electric, out int savedId))
                {
                    supplierData.Id = savedId;
                }
                else
                {
                    supplierData.Id = supplierList.Max(x => x.Id);
                }

                // Performance-Boost: Den gewählten Anbieter nur EINMAL suchen
                var currentSupplier = supplierList.FirstOrDefault(c => c.Id == supplierData.Id);
                if (currentSupplier != null)
                {
                    startDate = currentSupplier.Zeitraum_Start;
                    endDate = currentSupplier.Zeitraum_Ende;
                }
            }
            else
            {
                supplierData.Id = 0;
            }

            // Zahlungen anbieterabhängig auslesen
            if (supplierData.Id > 0)
            {
                paymentList = await gwsP.LoadDataAsync<GWS_PaymentModel>($"{urlPaymentsSupplier}{supplierData.Id}");
                if (paymentList == null || !paymentList.Any())
                {
                    OpenDialog("Keine Strom-Zahlungen vorhanden!", "60px", "380px", false);
                }
            }

            // Zahlungsarten laden
            paymentsMethodList = await gwsP.LoadDataAsync<GWS_PaymentsMethodModel>(urlPaymentsMethod);
        }
        catch (Exception ex)
        {
            // Stacktrace erhalten durch Mitgabe der Original-Exception (ex)
            throw new Exception("Es konnten keine Strom-Zahlungen geladen werden.", ex);
        }
        finally
        {
            // Spinner GARANTIERT ausschalten (künstliches Delay entfernt)
            spinnerVisibleProperty = false;
        }
    }
    #endregion

    #region ValueSelectHandler
    /// <summary>
    /// Auslesen Ablesetage des neuen ausgewählten Anbieters
