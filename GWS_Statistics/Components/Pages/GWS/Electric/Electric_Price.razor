    #region ActionCompleteHandler
    /// <summary>
    /// ActionCompleteHandler
    /// </summary>
    /// <param name="args"></param>
    public async Task ActionCompleteHandler(ActionEventArgs<Electric_CostModel> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
        {
            if (args.Action == "Add")
            {
                save = true;
                costData = args.Data;

                OpenDialog("Datensatz speichern ?", "130px", true);
            }
            else if (args.Action == "Edit")
            {
                update = true;
                costData = args.Data;

                OpenDialog("Datensatz ändern ?", "130px", true);
            }
        }
        else if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            if (args.Data.Id == 0)
            {
                costsList = await gwsP!.LoadDataAsync<Electric_CostModel>(urlCostSupplier + Convert.ToString(supplierData!.Id));
                if (costsList == null || !costsList.Any())
                {
                    OpenDialog("Keine Strom-Preise vorhanden!", "60px", false);
                }
            }
            else
            {
                costData = await gwsP!.DeleteDataAsync<Electric_CostModel>(urlCost, Convert.ToString(args.Data.Id));  // Zahlung löschen
                ShowToastMessage(true, "Datensatz gelöscht!");
            }
            SfDataGrid?.Refresh();
        }
    }
    #endregion

    #region CancelClick
    /// <summary>
    /// CancelClick
    /// </summary>
    private async void CancelClick()
    {
        DialogVisible = false;
        costsList = await gwsP!.LoadDataAsync<Electric_CostModel>(urlCostSupplier + Convert.ToString(supplierData!.Id));  // Daten neu laden
        SfDataGrid?.Refresh();
    }
    #endregion

    #region YesClick
    /// <summary>
    /// YesClick
    /// </summary>
    private async void YesClick()
    {
        DialogVisible = false;

        if (save) // Datensatz speichern
        {
            if (costData != null)
            {
                save = false;

                apiResponse = await gwsP!.PostDataAsync<Electric_CostModel>(urlCost, costData);  // POST

                if (apiResponse.MyHttpStatusCode == HttpStatusCode.Created)
                {
                    ShowToastMessage(true, "Datensatz gespeichert (created)!");
                    costsList = await gwsP!.LoadDataAsync<Electric_CostModel>(urlCostSupplier + Convert.ToString(supplierData!.Id));  // Daten neu laden
                }
                else
                {
                    ShowToastMessage(false, "Datensatz nicht gespeichert!");
                }
            }
        }
        else if (update) // Datensatz updaten
        {
            update = false;

            if (costData != null)
            {
                string url = urlCost + Convert.ToString(costData.Id);

                apiResponse = await gwsP!.UpdateDataAsync<Electric_CostModel>(url, costData);  // Put
                ShowToastMessage(true, "Datensatz aktualisiert!");
                costsList = await gwsP!.LoadDataAsync<Electric_CostModel>(urlCostSupplier + Convert.ToString(supplierData!.Id));  // Daten neu laden
            }
        }
        SfDataGrid?.Refresh();
    }
    #endregion

    #region ShowToastMessage
    /// <summary>
    /// ShowToastMessage
    /// </summary>
    /// <param name="success"></param>
    /// <param name="message"></param>
    /// <returns></returns>
    private void ShowToastMessage(bool success, string message)
    {
        if (success)
        {
            ShowToast("Erfolg", message, "e-toast-success", "e-circle-check");
        }
        else
        {
            ShowToast("Fehler", message, "e-toast-danger", "e-circle-close");
        }
    }
    #endregion

    #region ShowToast
    /// <summary>
    /// ShowToast
    /// </summary>
    /// <param name="title"></param>
    /// <param name="content"></param>
    /// <param name="cssClass"></param>
    /// <param name="icon"></param>
    private void ShowToast(string title, string content, string cssClass, string icon)
    {
        this.ToastService.Open(new ToastOption()
            {
                Title = title,
                Content = content,
                CssClass = cssClass,
                Icon = icon,
            });
    }
    #endregion

    #region GetTooltipContent
    /// <summary>
    /// GetTooltipContent(string headerText)
    /// </summary>
    /// <param name="headerText"></param>
    /// <returns></returns>
    // Method to get tooltip content dynamically based on HeaderText
    public string GetTooltipContent(string headerText)
    {
        return ColumnDescriptions.ContainsKey(headerText) ? ColumnDescriptions[headerText] : "No description available.";
    }
    #endregion

    #region CloseDialog
    /// <summary>
    /// CloseDialog
    /// </summary>
    private void CloseDialog()
    {
        this.DialogVisible = false;
    }
    #endregion

    #region OpenDialog
    /// <summary>
    /// OpenDialog
    /// </summary>
    private void OpenDialog(string header, string height, bool showButtons)
    {
        Header = header;
        dialogHeight = height;
        showDialogButtons = showButtons;
        this.DialogVisible = true;
    }
    #endregion

    #region GetDialogHeader
    /// <summary>
    /// GetDialogHeader
    /// </summary>
    /// <param name="cost"></param>
    /// <returns></returns>
    public string GetDialogHeader(Electric_CostModel? cost)
    {
        if (cost != null)
        {
            return cost.Id == 0
                ? "Kosten: neue Kosten"
                : "Kosten: " + cost.Gueltig_Ab.ToString("dd.MM.yyyy");
        }
        else
        {
            return "Keine Kosten vorhanden";
        }
    }
    #endregion

    #region RowCreatingHandler
    /// <summary>
    /// ein neuer Datebsatz wird angelegt
    /// </summary>
    /// <param name="args"></param>
    public void RowCreatingHandler(RowCreatingEventArgs<Electric_CostModel> args)
    {
         // Daten aus Dropdown "Anbieter" auslesen und Anbieter-Feld in Grid vorbesetzen
        args.Data.Id_Anbieter = supplierData!.Id;
        args.Data.Anbieter = supplierDataList?
                                    .Where(x => x.Id == supplierData.Id)
                                    .Select(a => a.Anbieter)
                                    .FirstOrDefault();

        args.Data.Gueltig_Ab = DateTime.Now;  // das Datum auf Heute setzen

        // letzte Einträge holen und Variable vorbesetzen
        if (costsList != null && costsList.Any())
        {
            var lastCost = costsList?.LastOrDefault();
            if (lastCost != null)
            {
                args.Data.Grundpreis = lastCost.Grundpreis;
                args.Data.Arbeitspreis = lastCost.Arbeitspreis;
                args.Data.Zaehlermiete = lastCost.Zaehlermiete;
                args.Data.Bemerkung = lastCost.Bemerkung;
            }
        }
    }
    #endregion

