@page "/electric_price"

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Electric_Price> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService

<PageTitle>Strom- Preise</PageTitle>

@* Seiten-Überschrift *@
<div class="container">
    <div class="text-center fs-3 fw-bold">
        <span class="fa-solid fa-plug fa-3xs" aria-hidden="true"> </span>
        <label>Strom- Preise</label>
    </div>
</div>

@* Auswahl Anbieter *@
<div class="card shadow-lg p-2 mb-1">
    <div class="container-fluid bg-color-grey pb-2 border">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    <SfDropDownList DataSource="@supplierList" TItem="Electric_SupplierDataModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData!.Id">
                        <DropDownListFieldSettings Text="Anbieter" Value="Id"></DropDownListFieldSettings>
                        <DropDownListEvents TItem="Electric_SupplierDataModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                    </SfDropDownList>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@startDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@endDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>
</div>

@* Grid *@
@if (supplierList != null && supplierList.Count > 0)
{
    <div class="control-section" id="target" align="center" style="position: relative; min-height: 200px;">
        <SfGrid ID="Grid" @ref="sfDataGrid" DataSource="@costsList"
                AllowPaging="true"
                AllowFiltering="true"
                AllowReordering="true"
                AllowResizing="true"
                AllowExcelExport="true"
                AllowPdfExport="true"
                EnableHover="true"
                AllowTextWrap="true"
                AllowSelection="true"
                AllowSorting="true"
                Height="100%" 
                Width="100%"
                Toolbar="@toolbar"
                EnableStickyHeader="true">

            <GridEditSettings AllowAdding="true"
                              AllowEditing="true"
                              AllowDeleting="true"
                              ShowDeleteConfirmDialog="true"
                              Mode="EditMode.Dialog"
                              Dialog="dialogParams">

                    <HeaderTemplate>
                    @{
                            var DialogHeader = GetDialogHeader((context as Electric_CostModel));
                            <span>@DialogHeader</span>
                        }
                    </HeaderTemplate>
            </GridEditSettings>

            <GridEvents OnToolbarClick="ToolbarBtnClickHandler"
                        RowCreating="RowCreatingHandler"
                        RowEditing="RowEditingHandler"
                        OnActionComplete="ActionCompleteHandler"
                        TValue="Electric_CostModel">
            </GridEvents>

            <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>

            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn 
                            Field="Gueltig_Ab" 
                            Direction="SortDirection.Descending">
                    </GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>

            <GridColumns>
                <GridColumn IsPrimaryKey="true" Field="@nameof(Electric_CostModel.Id)" Visible="false"
                            AllowAdding="false"
                            AllowEditing="false"
                            AllowSorting="false"
                            AllowFiltering="false"
                            Width="35">
                </GridColumn>

                <GridColumn Field=@nameof(Electric_CostModel.Anbieter)
                Width="200"
                EditType="EditType.DropDownEdit"
                HeaderText="Anbieter">

                    <EditTemplate>
                        <SfDropDownList Placeholder="Anbieter"
                                        FloatLabelType="FloatLabelType.Always"
                                        ID="Anbieter"
                                        TItem="Electric_SupplierDataModel"
                                        TValue="string"
                                        @bind-Value="@((context as Electric_CostModel)!.Anbieter)"
                                        DataSource="@supplierList">

                            <DropDownListFieldSettings Value="Anbieter" Text="Anbieter"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Anbieter")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Anbieter</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_CostModel.Gueltig_Ab)
                            Format="d"
                            EditType="EditType.DatePickerEdit"
                            Width="110"
                            HeaderText="Gültig ab">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("G-ab")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Datum</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_CostModel.Grundpreis)
                Format="0.0000 €/Monat"
                Width="100"
                HeaderText="Grundpreis">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Grundpreis"
                                          FloatLabelType="FloatLabelType.Always"
                                          TValue="double?"
                                          @bind-Value="@((context as Electric_CostModel)!.Grundpreis)"
                                          Format="0.0000 €/Monat">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("GP")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>GP</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_CostModel.Arbeitspreis)
                            Format="0.0000 ct/kWh"
                            Width="100"
                            HeaderText="Arbeitspreis">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Arbeitspreis"
                                          FloatLabelType="FloatLabelType.Always"
                                          TValue="double?"
                                          @bind-Value="@((context as Electric_CostModel)!.Arbeitspreis)"
                                          Format="0.0000 ct/kWh">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("AP")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>AP</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_CostModel.Zaehlermiete)
                Format="0.0000 €/Monat"
                Width="110"
                HeaderText="Zählermiete">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Zählermiete"
                                          FloatLabelType="FloatLabelType.Always"
                                          TValue="double?"
                                          @bind-Value="@((context as Electric_CostModel)!.Zaehlermiete)"
                                          Format="0.0000 €/Monat">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("ZM")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>ZM</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field="Bemerkung"
                Width="300"
                HeaderText="Bemerkung">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Bemerkung")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Bemerkung</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                    <GridCommandColumns>
                        <GridCommandColumn Type="CommandButtonType.Edit"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Delete"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Save"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Cancel"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                    </GridCommandColumns>
                </GridColumn>
            </GridColumns>
        </SfGrid>

        @* Spinner für den Export *@
        <SfSpinner Visible="@IsExporting"
                   Label="Datei wird generiert, bitte warten..."
                   Type="@SpinnerType.Material"
                   Size="40"
                   CssClass="e-spin-overlay e-custom-color">
        </SfSpinner>
    </div>
}
else
{
    <SfSpinner @bind-Visible="@spinnerVisibleProperty" 
               Type="SpinnerType.Tailwind" 
               CssClass="e-custom-color"
               Label="Lade Daten..."
               Size="40"> 
    </SfSpinner>
}

@* Dialog*@
<div>
    <SfDialog Target="#target"
              Width="320px"
              Height=@dialogHeight
              AllowDragging="true"
              ShowCloseIcon=" true"
              @bind-Visible="DialogVisible"
              AllowPrerender="true"
              IsModal="true"
              CssClass="MyCss">

            <DialogTemplates>
                <Header>@header</Header>
            </DialogTemplates>

            <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>

            <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

            @if (showDialogButtons)
            {
                <DialogButtons>
                    <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                    <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
                </DialogButtons>
            }
    </SfDialog>
</div>

<style>
    /* 1. Zwingt das gesamte Spinner-Container-System nach ganz vorne */
    .e-spinner-pane.e-spin-overlay {
        z-index: 99999 !important;
        background-color: rgba(0, 0, 0, 0.4) !important; /* Macht den Hintergrund dunkel-transparent */
    }

        /* 2. Zwingt das Ladesymbol und den Text, sich abzuheben */
        .e-spinner-pane.e-spin-overlay .e-spinner-inner {
            z-index: 100000 !important;
        }

        /* 3. HIER WIRD DER TEXT ERZWUNGEN UND SCHÖN FORMATIERT */
        .e-spinner-pane.e-spin-overlay .e-spin-label {
            color: #FFFFFF !important; /* Reines Weiß, damit es auf dem dunklen Overlay lesbar ist */
            font-weight: bold !important; /* Fett gedruckt */
            font-size: 16px !important; /* Etwas größer für bessere Lesbarkeit */
            margin-top: 10px !important; /* Abstand zum drehenden Rad */
            display: block !important; /* Sicherstellen, dass es nicht auf hidden steht */
        }

    .e-dlg-overlay {
    background-color: slategray;
    opacity: 0.6;
    }

    /* Dialog Editing*/
    .e-dialog .e-dlg-header-content {
    background-color: grey;
    font-size: 24px;
    }

    .e-dialog .e-dlg-header {
    color: white;
    }

    .e-dialog .e-dlg-content {
    color: white;
    background-color: lightgray;
    font-size: 16px;
    }

    .bg-color-grey {
    background: #deded9;
    }

    #toast_default .e-circle-check::before {
    content: "\e72b";
    font-size: 17px;
    }

    #toast_default .e-circle-close::before {
    content: "\e878";
    font-size: 17px;
    }

    .control-wrapper {
    max-width: 250px;
    min-width: 80px;
    margin: 0 auto;
    }

    .control-label {
    font-size: 14px;
    margin: 6px 0px;
    }

    /* Dialog: Datensatz ändern/löschen */
    .MyCss .e-dlg-header-content {
    background-color: red;
    }
</style>

@code
{
    #region Variablendeklaration
    private bool success = false;

    bool spinnerVisibleProperty { get; set; } = false;

    private DialogSettings dialogParams = new DialogSettings { MinHeight = "400px", Width = "450px" };
    public DialogEffect animationEffect = DialogEffect.Zoom;
    public bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string dialogText { get; set; } = string.Empty;
    private string dialogXValue = "center";
    private string dialogYValue = "center";
    private string dialogHeight = "130px";
    private string dialogWidth = "450px";

    public int? DropDownValueSupplier { get; set; } = 0;

    readonly string urlSupplier = "strom/anbieter/";
    readonly string urlCost = "strom/kosten/";
    readonly string urlCostSupplier = "strom/kosten/anbieter/";

    string? header { get; set; }
    string? content { get; set; }

    GWSProcessor? gwsP;
    ApiResponse? apiResponse;

    private SfGrid<Electric_CostModel> sfDataGrid = new();

    private enum GridOperation { None, Add, Edit }
    private GridOperation currentOperation = GridOperation.None;

    private List<Electric_SupplierDataModel>? supplierList = new();

    private Electric_SupplierDataModel? supplierData = new();
    private List<Electric_CostModel>? costsList = null;
    private Electric_CostModel? costData = new();

    private List<object> toolbar = new List<object>() { "Add", "Cancel", "Search", "ExcelExport", "PdfExport" };

    public DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    public DateTime MaxDate { get; set; } = DateTime.Now;
    public DateTime? startDate { get; set; } = new DateTime(2000, 1, 1);
    public DateTime? endDate { get; set; } = new DateTime(2000, 1, 1);


    MyAppConfigModel? settings;

    // Dictionary for column descriptions
    public Dictionary<string, string> ColumnDescriptions = new()
    {
        { "Anbieter", "Anbieter" },
        { "G-ab", "Gültig ab" },
        { "GP", "Grundpreis" },
        { "AP", "Arbeitspreis" },
        { "ZM", "Zählermiete" },
        { "Bemerkung", "Bemerkung" }
    };

    // PDF-Export Properties
    public List<PdfHeaderFooterContent> HeaderContent = new List<PdfHeaderFooterContent>
    {
    new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 4, X2 = 720, Y2 = 4}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },
    new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Strom-Preise", Position = new PdfPosition() { X = 350, Y = 20 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
    new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 40, X2 = 720, Y2 = 40}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },

    new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 8, HAlign = PdfHorizontalAlign.Right } }
    };

    public List<PdfHeaderFooterContent> FooterContent = new List<PdfHeaderFooterContent>
    {
        // new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Seite: ", Position = new PdfPosition() { X = 400, Y = 600 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
        // new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 10, HAlign = PdfHorizontalAlign.Right } }
    };
    #endregion

    #region OnInitializedAsync
    /// <summary>
    /// Startet die asynchrone Initialisierung der Komponente, lädt die Konfiguration und die Anbieter-Daten.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        this.spinnerVisibleProperty = true;

        try
        {
            // Einstellungen laden
            settings = await GetSetMyAppConfig.GetMyAppSettings.ReadSettingsAsync(myAppSettings);
            gwsP = new GWSProcessor(myHttpClient, settings!.GWSUri);

            supplierList = await gwsP.LoadDataAsync<Electric_SupplierDataModel>(urlSupplier);

            // 1. Sichere und saubere Prüfung auf Daten
            if (supplierList?.Any() == true)
            {
                // 2. Doppelte Zuweisung entfernt & sicheres Parsen
                if (string.IsNullOrEmpty(settings.Supplier_Id?.Electric))
                {
                    supplierData!.Id = supplierList.Max(x => x.Id);
                }
                else if (int.TryParse(settings.Supplier_Id.Electric, out int parsedId))
                {
                    supplierData!.Id = parsedId;
                }

                // 3. Nur noch EINMALIGER LINQ-Durchlauf statt dreimal
                var currentSupplier = supplierList.FirstOrDefault(c => c.Id == supplierData?.Id);
                if (currentSupplier != null)
                {
                    startDate = currentSupplier.Zeitraum_Start;
                    endDate = currentSupplier.Zeitraum_Ende;
                }
            }
            else
            {
                supplierData!.Id = 0;
            }

            // Kosten laden
            if (supplierData?.Id > 0)
            {
                costsList = await gwsP.LoadDataAsync<Electric_CostModel>($"{urlCostSupplier}{supplierData.Id}");

                if (costsList?.Any() != true)
                {
                    OpenDialog("Keine Strom-Preise vorhanden!", "60px", "380px", false);
                }
            }
        }
        catch (Exception ex)
        {
            // 4. Echte Fehlerursache (Stacktrace) nicht zerstören
            throw new Exception("Es konnten keine Strom-Preise geladen werden.", ex);
        }
        finally
        {
            // 5. Sicherstellen, dass der Spinner IMMER ausgeblendet wird
            this.spinnerVisibleProperty = false;
        }
    }
    #endregion

    #region ValueSelectHandler
    /// <summary>
    /// Auswahl eines Anbieters aus der Dropdown-Liste. Lädt die entsprechenden Kosten und speichert die Auswahl in den Einstellungen.
    /// </summary>
    /// <param name="args"></param>
    private async Task ValueSelectHandler(SelectEventArgs<Electric_SupplierDataModel>? args)
    {
        // 1. Null-Check für die Event-Argumente
        if (args?.ItemData == null) return;

        supplierData = args.ItemData;

        if (supplierData.Id > 0)
        {
            this.spinnerVisibleProperty = true;

            try
            {
                // 2. Einstellungen asynchron speichern
                success = await GetSetMyAppConfig.SetMyAppSettings.WriteSettingsAsync(
                    myAppSettings,
                    "Supplier_Id.Electric",
                    supplierData.Id.ToString()
                );

                // Direkt aus den validierten Event-Daten auslesen
                startDate = supplierData.Zeitraum_Start;
                endDate = supplierData.Zeitraum_Ende;

                // 3. String-Interpolation statt Plus-Operator
                costsList = await gwsP!.LoadDataAsync<Electric_CostModel>($"{urlCostSupplier}{supplierData.Id}");

                if (costsList?.Any() != true)
                {
                    OpenDialog("Keine Strom-Preise vorhanden!", "60px", "380px", false);
                }

                // 4. Null-Conditional Operator für das Grid-Refresh
                sfDataGrid?.Refresh();
            }
            finally
            {
                // 5. Spinner wird IMMER ausgeschaltet – auch bei Fehlern (ohne künstliches Delay)
                this.spinnerVisibleProperty = false;
            }
        }
    }
    #endregion

    #region ToolbarBtnClickHandler
    /// <summary>
    /// Toolbar Button Click Handler für das Grid. Behandelt das Exportieren von Daten in Excel oder PDF.
    /// </summary>
    /// <param name="args"></param>
    
    // Variable zur Steuerung des Lade - Spinners im UI
    private bool IsExporting { get; set; }

    public async Task ToolbarBtnClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        string? itemId = args.Item?.Id;
        if (string.IsNullOrEmpty(itemId)) return;

        try
        {
            // 1. Spinner aktivieren & UI aktualisieren
            IsExporting = true;

            // Test Spinner sichtbar machen
            // 2. ERZWINGEN, dass Blazor das UI JETZT sofort neu zeichnet
            // StateHasChanged();
            // 3. TEST: 3 Sekunden warten, um zu sehen, ob der Spinner auftaucht
            // await Task.Delay(3000);

            string dateSuffix = DateTime.Now.ToString("ddMMyyyy");

            if (itemId.Contains("_excelexport", StringComparison.OrdinalIgnoreCase))
            {
                var excelExportProperties = new ExcelExportProperties
                {
                    FileName = $"Stromanbieter_{dateSuffix}.xlsx",
                    Theme = new ExcelTheme
                    {
                        Header = new ExcelStyle { FontName = "Calibri", FontSize = 12, Bold = true },
                        Record = new ExcelStyle { FontName = "Calibri", FontSize = 10, Bold = false }
                    }
                };

                // 2. Optionale Optimierung: Bestimmte Spalten vor Export verstecken
                await ToggleActionColumnsAsync(hide: true);

                await sfDataGrid.ExportToExcelAsync(excelExportProperties);
            }
            else if (itemId.Contains("_pdfexport", StringComparison.OrdinalIgnoreCase))
            {
                var pdfExportProperties = new PdfExportProperties
                {
                    IsRepeatHeader = true,
                    FileName = $"Stromanbieter_{dateSuffix}.pdf",
                    PageOrientation = Syncfusion.Blazor.Grids.PageOrientation.Landscape,
                    Header = new PdfHeader { FromTop = 0, Height = 80, Contents = HeaderContent },
                    Footer = new PdfFooter { FromBottom = 0, Height = 80, Contents = FooterContent },
                    Theme = new PdfTheme
                    {
                        Header = new PdfThemeStyle { FontColor = "Blue", FontName = "Calibri", FontSize = 8, Bold = true }
                    }
                };

                await ToggleActionColumnsAsync(hide: true);

                await sfDataGrid.ExportToPdfAsync(pdfExportProperties);
            }
        }
        catch (Exception ex)
        {
            // Hier optionales Logging oder Benutzer-Fehlermeldung integrieren
            Console.WriteLine($"Export fehlgeschlagen: {ex.Message}");
        }
        finally
        {
            // 3. Spalten wieder einblenden & Spinner deaktivieren (läuft IMMER durch)
            await ToggleActionColumnsAsync(hide: false);
            IsExporting = false;
        }
    }

    // Hilfsmethode zum Ein-/Ausblenden von Grid-Spalten (z.B. "Aktionen" oder "Id")
    private async Task ToggleActionColumnsAsync(bool hide)
    {
        // Nutzen Sie die Field-Namen Ihrer Spalten, die nicht exportiert werden sollen
        var columnsToToggle = new[] { "Id", "Actions" };

        foreach (var field in columnsToToggle)
        {
            if (hide)
            {
                await sfDataGrid.HideColumnAsync(field);
            }
            else
            {
                await sfDataGrid.ShowColumnAsync(field);
            }
        }
    }
    #endregion

    #region ActionCompleteHandler
    /// <summary>
    /// Action Complete Handler für das Grid. Behandelt das Speichern, Bearbeiten und Löschen von Datensätzen.
    /// </summary>
    /// <param name="args"></param>
    public async Task ActionCompleteHandler(ActionEventArgs<Electric_CostModel> args)
    {
        if (args?.Data is null) return;

        switch (args.RequestType)
        {
            case Syncfusion.Blazor.Grids.Action.Save:
                costData = args.Data;

                if (args.Action == "Add")
                {
                    currentOperation = GridOperation.Add;
                    OpenDialog("Datensatz speichern ?", "130px", "220px", true);
                }
                else if (args.Action == "Edit")
                {
                    currentOperation = GridOperation.Edit;
                    OpenDialog("Datensatz ändern ?", "130px", "220px", true);
                }
                break;

            case Syncfusion.Blazor.Grids.Action.Delete:
                if (args.Data.Id <= 0)
                {
                    if (gwsP is not null)
                    {
                        costsList = await gwsP.LoadDataAsync<Electric_CostModel>(urlCostSupplier);
                    }
                    ShowToast(false, "Datensatz nicht gelöscht!");
                }
                else
                {
                    if (gwsP is not null)
                    {
                        costData = await gwsP.DeleteDataAsync<Electric_CostModel>(urlCost, args.Data.Id.ToString());
                        ShowToast(true, "Datensatz gelöscht!");
                    }
                }

                if (sfDataGrid is not null)
                {
                    await sfDataGrid.Refresh();
                }
                break;
        }
    }
    #endregion

    #region CancelClick
    /// <summary>
    /// Abbrechen-Button im Dialog wurde geklickt, schließt den Dialog und setzt den aktuellen Operationstyp zurück.
    /// </summary>
    private async void CancelClick()
    {
        // Schließt den Dialog sofort visuell
        DialogVisible = false;

        // Setzt den aktuellen Operationstyp zurück, um sicherzustellen, dass keine Aktion mehr aussteht
        currentOperation = GridOperation.None;

        // Setzt die temporären Datenstrukturen zurück, falls diese im Grid gebunden waren
        costData = null;
    }
    #endregion

    #region YesClick
    /// <summary>
    /// YesClick
    /// </summary>
    private async Task YesClick()
    {
        DialogVisible = false;

        if (gwsP is null || costData is null || currentOperation == GridOperation.None) return;

        try
        {
            bool isSuccess = false;
            string successMessage = string.Empty;
            string defaultErrorMessage = "Aktion konnte nicht ausgeführt werden.";

            switch (currentOperation)
            {
                case GridOperation.Add:
                    apiResponse = await gwsP.PostDataAsync<Electric_CostModel>(urlCost, costData);
                    isSuccess = apiResponse?.MyHttpStatusCode == HttpStatusCode.Created;
                    successMessage = "Datensatz erfolgreich gespeichert!";
                    defaultErrorMessage = "Datensatz konnte nicht gespeichert werden.";
                    break;

                case GridOperation.Edit:
                    string url = $"{urlCost.TrimEnd('/')}/{costData.Id}";
                    apiResponse = await gwsP.UpdateDataAsync<Electric_CostModel>(url, costData);
                    isSuccess = apiResponse?.MyHttpStatusCode == HttpStatusCode.NoContent;
                    successMessage = "Datensatz erfolgreich aktualisiert!";
                    defaultErrorMessage = "Datensatz konnte nicht aktualisiert werden.";
                    break;
            }

            if (isSuccess)
            {
                ShowToast(true, successMessage);
                costsList = await gwsP.LoadDataAsync<Electric_CostModel>($"{urlCostSupplier}{supplierData!.Id}");
            }
            else
            {
                // Dynamische Fehlerursache aus MyResponseString ermitteln
                string errorMessage = defaultErrorMessage;

                if (apiResponse is not null && !string.IsNullOrWhiteSpace(apiResponse.MyResponseString))
                {
                    // Wenn die API direkt Text zurückgibt, nutzen wir ihn.
                    // Falls es JSON ist (z.B. bei Validierungsfehlern), könnte man es hier parsen.
                    errorMessage = $"Fehler ({apiResponse.MyHttpStatusCode}): {apiResponse.MyResponseString}";
                }

                ShowToast(false, errorMessage);
            }

            if (sfDataGrid is not null)
            {
                await sfDataGrid.Refresh();
            }
        }
        catch (Exception ex)
        {
            ShowToast(false, $"Netzwerkfehler: {ex.Message}");
        }
        finally
        {
            currentOperation = GridOperation.None;
        }
    }
    #endregion

    #region ShowToast
    /// <summary>
    /// Anzeige einer Toast-Nachricht basierend auf dem Erfolg oder Misserfolg einer Aktion.
    /// </summary>
    /// <param name="success"></param>
    /// <param name="message"></param>
    /// <returns></returns>
    private void ShowToast(bool success, string message)
    {
        var (title, cssClass, icon) = success switch
        {
            true => ("Erfolg", "e-toast-success", "e-circle-check"),
            false => ("Fehler", "e-toast-danger", "e-circle-close")
        };

        this.ToastService.Open(new()
        {
            Title = title,
            Content = message ?? string.Empty,
            CssClass = cssClass,
            Icon = icon,
        });
    }
    #endregion

    #region GetTooltipContent
    /// <summary>
    /// Hole den Tooltip-Inhalt basierend auf dem HeaderText. Wenn keine Beschreibung vorhanden ist, wird eine Standardnachricht zurückgegeben.
    /// </summary>
    /// <param name="headerText"></param>
    /// <returns></returns>
    // Method to get tooltip content dynamically based on HeaderText
    public string GetTooltipContent(string headerText)
    {
        return ColumnDescriptions.ContainsKey(headerText) ? ColumnDescriptions[headerText] : "Keine Beschreibung verfügbar";
    }
    #endregion

    #region OpenDialog
    /// <summary>
    /// Dialog öffnen mit Header, Höhe, Breite und optionalen Buttons
    /// </summary>
    private void OpenDialog(string header, string height = "auto", string width = "500px", bool showButtons = true)
    {
        this.header = header;
        dialogHeight = height;
        dialogWidth = width;
        showDialogButtons = showButtons;
        this.DialogVisible = true;

        // Erzwingt das Neu-Rendern der UI (wichtig in Blazor für Dialoge)
        this.StateHasChanged();
    }
    #endregion

    #region GetDialogHeader
    /// <summary>
    /// Dialog-Header generieren. Wenn kein Kostenmodell vorhanden ist, wird ein Standardtext angezeigt.
    /// </summary>
    /// <param name="cost"></param>
    /// <returns></returns>
    public string GetDialogHeader(Electric_CostModel? cost) =>
       cost is not { Id: > 0 }
           ? "Kosten: neue Kosten"
           : $"Kosten: {cost.Gueltig_Ab.ToString("dd.MM.yyyy")}";
    #endregion

    #region RowCreatingHandler
    /// <summary>
    /// ein neuer Datebsatz wird angelegt
    /// </summary>
    /// <param name="args"></param>
    public void RowCreatingHandler(RowCreatingEventArgs<Electric_CostModel> args)
    {
        if (args?.Data == null) return;

        // 1. Anbieter-Daten direkt zuweisen (Vermeidung von LINQ-Suche auf Listen)
        if (supplierData != null)
        {
            args.Data.Id_Anbieter = supplierData.Id;

            var selectedSupplier = supplierList?.FirstOrDefault(x => x.Id == supplierData.Id);
            if (selectedSupplier != null)
            {
                args.Data.Anbieter = selectedSupplier.Anbieter;
            }
        }

        // 2. Datum auf das aktuelle Datum (ohne Uhrzeit) setzen
        args.Data.Gueltig_Ab = DateTime.Today;

        // 3. Effizientes Holen des letzten Eintrags (Vermeidung von Any() + LastOrDefault())
        var lastCost = costsList?.LastOrDefault();
        if (lastCost != null)
        {
            args.Data.Grundpreis = lastCost.Grundpreis;
            args.Data.Arbeitspreis = lastCost.Arbeitspreis;
            args.Data.Zaehlermiete = lastCost.Zaehlermiete;
            args.Data.Bemerkung = lastCost.Bemerkung;
        }
    }
    #endregion

    #region RowEditingHandler
    /// <summary>
    /// Datenzeile wird editiert
    /// </summary>
    /// <param name="args"></param>
    public void RowEditingHandler(RowEditingEventArgs<Electric_CostModel> args)
    {
        // Best Practice: Null-Check für die Argumente und Daten
        if (args?.Data is null) return;

        // Daten aus Dropdown "Anbieter" auslesen und Anbieter-Feld in Grid vorbesetzen
        DropDownValueSupplier = args.Data.Id_Anbieter;
    }
    #endregion
