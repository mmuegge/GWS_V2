    #region CalculateTotalConsumption
    /// <summary>
    /// Berechnet den Gesamtverbrauch über ein bestimmtes Zeitintervall
    /// </summary>
    /// <param name="startCounter"></param>
    /// <param name="periodStartDate"></param>
    /// <param name="dayCounters"></param>
    /// <param name="counterChanges"></param>
    /// <returns>Total consumption</returns>
    public double CalculateTotalConsumption(
                double startCounter, 
                DateTime periodStartDate,
                List<Electric_CounterModel> dayCounters,
                List<Electric_CounterChangeModel> counterChanges)
    {
        // Maximaler Verbrauch, den wir bei einem Zählerüberlauf (z.B. von 999999 auf 0) pro Tag erwarten
        // Verhindert, dass massive Tippfehler als Überlauf gewertet werden. 5000.0 -> max. Tagesverbrauch

        // 1. Sortieren aller Listen nach Datum aufsteigend, um chronologische Fehler zu vermeiden
        var sortedCounters = (dayCounters ?? new List<Electric_CounterModel>())
            .Where(z => z.Zaehlerstand.HasValue) // Nur Einträge mit Werten nutzen
            .OrderBy(z => z.Ablesetag)
            .ToList();

        var sortedCounterChanges = (counterChanges ?? new List<Electric_CounterChangeModel>())
            .OrderBy(w => w.Wechsel_Datum)
            .ToList();

        double totalConsumption = 0;

        // Wir starten mit dem allerersten Zähler
        DateTime periodStart = periodStartDate;
        double currentCounter = startCounter;

        // 2. Schleife über alle Zählertausche
        foreach (var change in sortedCounterChanges)
        {
            // Alle Tagesstände dieses spezifischen Zählers holen (während seiner Laufzeit)
            var valuesForThisCounter = sortedCounters
                .Where(z => z.Ablesetag >= periodStart && z.Ablesetag <= change.Wechsel_Datum)
                .Select(z => z.Zaehlerstand.GetValueOrDefault()) // .GetValueOrDefault() ist sicher, da oben gefiltert
                .ToList();

            if (valuesForThisCounter.Any())
            {
                // Überlauf-sichere Berechnung über die Tagesliste (Nutzt die korrigierte Logik)
                totalConsumption += CalcIntervalConsumption(currentCounter, valuesForThisCounter, EnergyConfig.DAILY_MAX_DROP_ELECTRIC);
            }
            else
            {
                // Fallback auf die offiziellen Wechseldaten, falls für diesen Zeitraum keine Tagesdaten vorliegen
                double oldLastValue = change.Zaehlerstand_alt ?? 0;

                if (oldLastValue >= currentCounter)
                {
                    // Normaler Verlauf: Alter Zähler stieg bis zum Ausbau
                    totalConsumption += (oldLastValue - currentCounter);
                }
                else
                {
                    // FEHLERBEHEBUNG: Zählerüberlauf direkt beim offiziellen Tauschwert abfangen
                    // Wir berechnen den potenziellen Verbrauch über den Nullsprung hinweg
                    double overflowBasis = GetCounterOverflowBasis(currentCounter);
                    double calculatedOverflowConsumption = (overflowBasis - currentCounter) + oldLastValue;

                    // Prüfen, ob der Überlauf-Verbrauch im plausiblen Rahmen liegt
                    if (calculatedOverflowConsumption <= EnergyConfig.CHANGE_MAX_DROP_ELECTRIC)
                    {
                        totalConsumption += calculatedOverflowConsumption;
                    }
                }
            }

            // Parameter für den NÄCHSTEN Zähler vorbereiten
            periodStart = change.Wechsel_Datum;
            currentCounter = change.Zaehlerstand_neu ?? 0;
        }

        // 3. Den Verbrauch des AKTUELLEN (letzten) Zählers nach dem letzten Tausch berechnen
        var remainValues = sortedCounters
            .Where(z => z.Ablesetag >= periodStart)
            .Select(z => z.Zaehlerstand.GetValueOrDefault())
            .ToList();

        if (remainValues.Any())
        {
            // Überlauf-sichere Berechnung für den letzten Zähler bis zum Ende der Periode
            totalConsumption += CalcIntervalConsumption(currentCounter, remainValues, EnergyConfig.DAILY_MAX_DROP_ELECTRIC);
        }

        return totalConsumption;
    }
    #endregion

    #region CalcIntervalConsumption
    /// <summary>
    /// Berechnet den Verbrauch eines Intervalls und behandelt Überläufe sowie Tippfehler
    /// </summary>
    /// <param name="startValue"></param>
    /// <param name="counterValues"></param>
    /// <param name="maxDrop"></param>
    /// <returns>Den errechneten Verbrauch</returns>
    // Hilfsmethode: Berechnet den Verbrauch einer Liste und fängt Überläufe sowie Tippfehler ab
    private double CalcIntervalConsumption(double startValue, List<double> counterValues, double maxDrop)
    {
        double consumption = 0;
        double previousValue = startValue;

        foreach (var actualValue in counterValues)
        {
            if (actualValue >= previousValue)
            {
                // Normaler Verlauf: Zähler steigt
                consumption += (actualValue - previousValue);
                previousValue = actualValue;
            }
            else
            {
                // Zählerstand ist GESUNKEN: Überlauf berechnen
                double overflowBasis = GetCounterOverflowBasis(previousValue);
                double calculatedOverflowConsumption = (overflowBasis - previousValue) + actualValue;

                // Prüfen, ob der errechnete Verbrauch für einen Tag plausibel ist
                if (calculatedOverflowConsumption <= maxDrop)
                {
                    // SZENARIO A: Plausibler Verbrauch -> Zählerüberlauf (Roll-Over)
                    consumption += calculatedOverflowConsumption;
                    previousValue = actualValue;
                }
                else
                {
                // SZENARIO B: Zu hoher Verbrauch -> Offensichtlicher Tippfehler (wird ignoriert)
                // previousValue bleibt unverändert für den nächsten Schleifendurchlauf
                }
            }
        }

        return consumption;
    }
    #endregion

    #region GetCounterOverflowBasis
    /// <summary>
    /// Findet die nächste logische Zehnerpotenz für den Zählerüberlauf (10.000, 100.000 etc.)
    /// </summary>
    /// <param name="value"></param>
    /// <returns></returns>
    // Hilfsmethode: Findet die nächste logische Zehnerpotenz für den Zählerüberlauf (10.000, 100.000 etc.)
    private double GetCounterOverflowBasis(double value)
    {
        if (value < 10000.0) return 10000.0;       // 4 Stellen (max. 9.999)
        if (value < 100000.0) return 100000.0;     // 5 Stellen (max. 99.999)
        if (value < 1000000.0) return 1000000.0;   // 6 Stellen (max. 999.999)

        return 10000000.0;                        // 7 Stellen (max. 9.999.999)
    }
    #endregion

    #region CalculatePeriodConsumptionWithChanges
    /// <summary>
    /// Berechnet den Gesamtverbrauch für einen bestimmten Zeitraum unter Berücksichtigung von Zählerwechseln
    /// und sichert absinkende Werte über ein Plausibilitätslimit (MAX_PLAUSIBLE_OVERFLOW_DROP) ab.
    /// </summary>
    /// <param name="startCounterValue">Anfangszählerstand</param>
    /// <param name="endCounterValue">Endzählerstand</param>
    /// <param name="changeCounterList">Liste aller Zählertausche</param>
    /// <returns>Den errechneten Gesamtverbrauch</returns>
    public double CalculatePeriodConsumptionWithChanges(
            double startCounterValue,
            double endCounterValue,
            List<Electric_CounterChangeModel> changeCounterList)
    {
        var sortedCounterChanges = (changeCounterList ?? new List<Electric_CounterChangeModel>())
            .OrderBy(w => w.Wechsel_Datum)
            .ToList();

        double totalConsumption = 0;
        double actualCounterStartValue = startCounterValue;

        foreach (var change in sortedCounterChanges)
        {
            double oldLastCounterValue = change.Zaehlerstand_alt ?? 0;
            double newCounterValue = change.Zaehlerstand_neu ?? 0;

            if (oldLastCounterValue >= actualCounterStartValue)
            {
                totalConsumption += (oldLastCounterValue - actualCounterStartValue);
            }
            else
            {
                double overflowBasis = GetCounterOverflowBasis(actualCounterStartValue);
                double calculatedOverflowConsumption = (overflowBasis - actualCounterStartValue) + oldLastCounterValue;

                // KORREKTUR: Nutzt den zentralen Tausch-Grenzwert für Strom
                if (calculatedOverflowConsumption <= EnergyConfig.CHANGE_MAX_DROP_ELECTRIC)
                {
                    totalConsumption += calculatedOverflowConsumption;
                }
            }

            actualCounterStartValue = newCounterValue;
        }

        if (endCounterValue >= actualCounterStartValue)
        {
            totalConsumption += (endCounterValue - actualCounterStartValue);
        }
        else
        {
            // KORREKTUR: Auf dynamische Basis-Ermittlung umgestellt
            double overflowBasis = GetCounterOverflowBasis(actualCounterStartValue);
            double calculatedOverflowConsumption = (overflowBasis - actualCounterStartValue) + endCounterValue;

            if (calculatedOverflowConsumption <= EnergyConfig.CHANGE_MAX_DROP_ELECTRIC)
            {
                totalConsumption += calculatedOverflowConsumption;
            }
        }

        return totalConsumption;
    }
    #endregion
}
