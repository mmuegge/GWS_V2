    #region CalcAverageSum
    /// <summary>
    /// Berechnen Durchschnitt/Summe/Min/Max
    /// </summary>
    public void CalcAverageSum()
    {
        // if (supplierData is null || ChartPointList is null || ChartPointList.Count == 0)
        // {
        //     ConsMin_kWh = 0;
        //     ConsMax_kWh = 0;
        //     TempAverage = 0;
        //     return;
        // }
        // ConsAverage_kWh = Math.Round(ChartPointList.Average(x => x.Cons_kWh).GetValueOrDefault(), 2);

        // // Berechnung der Summe kWh: Wenn Start- und End-Zählerstand vorhanden, dann Differenz berechnen, ansonsten Summe der Verbrauchswerte
        // // 1. Früher Abbruch/Sonderfall: Bei jährlich wird die Summe immer geleert
        // if (DdlInterval == Interval.jährlich)
        // {
        //     ConsSum_kWh = null;
        // }
        // // 2. Fall A: Beide offiziellen Zählerstände sind vorhanden (Schnelle Perioden-Berechnung)
        // else if (supplierData?.Ende_Zaehlerstand != null && supplierData?.Start_Zaehlerstand != null)
        // {
        //     ConsSum_kWh = CalculatePeriodConsumptionWithChanges(
        //         supplierData.Start_Zaehlerstand.Value,
        //         supplierData.Ende_Zaehlerstand.Value,
        //         counterChangeList ?? new()
        //     );
        // }
        // // 3. Fall B: Zählerstände fehlen -> Berechnung über feinere Tagesdaten (Detaillierte Berechnung)
        // else
        // {
        //     ConsSum_kWh = CalculateTotalConsumption(
        //         supplierData?.Start_Zaehlerstand ?? 0,
        //         supplierData?.Zeitraum_Start ?? DateTime.Now,
        //         counterList ?? new(),
        //         counterChangeList ?? new()
        //     );
        // }
        // ConsMin_kWh = Math.Round(ChartPointList.Min(x => x.Cons_kWh).GetValueOrDefault(), 2);
        // ConsMax_kWh = Math.Round(ChartPointList.Max(x => x.Cons_kWh).GetValueOrDefault(), 2);
        // TempAverage = Math.Round(ChartPointList.Average(x => x.Temp).GetValueOrDefault(), 2);

        if (supplierData is null || ChartPointList is null || ChartPointList.Count == 0)
        {
            ConsMin_kWh = 0;
            ConsMax_kWh = 0;
            ConsSum_kWh = 0;
            ConsAverage_kWh = 0;
            TempAverage = 0;
            Year_MaxCons = 1990;
            Year_MinCons = 1990;
            return;
        }

        // 1. Allgemeine Durchschnitts-, Min- und Max-Werte direkt aus der Chart-Liste berechnen
        ConsAverage_kWh = Math.Round(ChartPointList.Average(x => x.Cons_kWh).GetValueOrDefault(), 2);
        ConsMin_kWh = Math.Round(ChartPointList.Min(x => x.Cons_kWh).GetValueOrDefault(), 2);
        ConsMax_kWh = Math.Round(ChartPointList.Max(x => x.Cons_kWh).GetValueOrDefault(), 2);
        TempAverage = Math.Round(ChartPointList.Average(x => x.Temp).GetValueOrDefault(), 2);

        // =========================================================================
        // SUMMEN-BERECHNUNG (Direkt aus der Liste aggregiert) 
        // =========================================================================

        // Fall A: Bei jährlich werden die Summen-Felder in der UI immer geleert
        if (DdlInterval == Interval.jährlich)
        {
            ConsSum_kWh = null;

            // Jahr mit dem höchsten Verbrauch
            Year_MaxCons = ChartPointList
                .OrderByDescending(x => x.Cons_kWh)
                .Select(x => x.Date.Year)
                .FirstOrDefault();

            // Jahr mit dem niedrigsten Verbrauch
            Year_MinCons = ChartPointList
                .OrderBy(x => x.Cons_kWh)
                .Select(x => x.Date.Year)
                .FirstOrDefault();
        }
        // Fall B: Bei täglich / monatlich ziehen wir die echten Summen direkt aus den Chart-Punkten
        else
        {
            ConsSum_kWh = Math.Round(ChartPointList.Sum(x => x.Cons_kWh).GetValueOrDefault(), 2);
        }
    }
