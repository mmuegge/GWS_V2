                        <SfTooltip Content="@GetTooltipHeaderText("Kuendigung")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Kündigung</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_SupplierModel.Zeitraum_Start)
                            Format="d"
                            EditType="EditType.DatePickerEdit"
                            Width="110"
                            HeaderText="Zeitraum-Start">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipHeaderText("Abr-Start")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Abr-Start</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_SupplierModel.Zeitraum_Ende)
                            Format="d"
                            EditType="EditType.DatePickerEdit"
                            Width="110"
                            HeaderText="Zeitraum-Ende">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipHeaderText("Abr-Ende")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Abr-Ende</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_SupplierModel.Start_Zaehlerstand)
