                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_SupplierModel.Ende_Zaehlerstand)
                            Format="#####.00 kWh"
                            Width="110"
                            HeaderText="Ende-Zählerstand 1.8.0">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Ende-Zählerstand"
                                          FloatLabelType="FloatLabelType.Always"
                                          TValue="double?"
                                          @bind-Value="@((context as Electric_SupplierModel)!.Ende_Zaehlerstand)"
                                          Format="####0.00 kWh">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipHeaderText("Z-Ende-180")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Z-Ende 1.8.0</b></span>
