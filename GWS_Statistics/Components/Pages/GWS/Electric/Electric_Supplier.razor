                            AllowEditing="false"
                            AllowSorting="false"
                            AllowFiltering="false"
                            Width="35">
                </GridColumn>

                <GridColumn Field=@nameof(Electric_SupplierModel.Anbieter)
                            Width="150"
                            ValidationRules="@(new ValidationRules{ Required= true })"
                HeaderText="Anbieter">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipHeaderText("Anbieter")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Anbieter</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_SupplierModel.Tarif)
                            Width="150"
                            HeaderText="Tarif">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipHeaderText("Tarif")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Tarif</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_SupplierModel.Zaehlernummer)
                            Width="125"
                            HeaderText="Zählernummer">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipHeaderText("Z-Nr")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Z-Nr</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Electric_SupplierModel.Kuendigungsfrist)
