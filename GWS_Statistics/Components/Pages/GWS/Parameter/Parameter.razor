@page "/parameter"

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Globalization
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Parameter> Logger
@inject ToastService ToastService
@* @inject NavigationManager NavigationManager *@
@inject SfDialogService DialogService

<PageTitle>Parameter</PageTitle>

<div class="container">
    <div class="row">
        <div class="col col-md-12">
            <div class="text-center fs-3 fw-bold">
                <span class="fa-solid fa-house-circle-check fa-3xs" aria-hidden="true"> </span>
                @* <span><img src="energyEfficiency.png" width="50" height="50"></span> *@
                <label>Parameter</label>
            </div>
        </div>
    </div>
</div>

<div class="control-section" id="target" align="center">
    <SfGrid ID="Grid" @ref="SfDataGrid" DataSource="@parameterList"
            AllowPaging="true"
            AllowFiltering="true"
            AllowReordering="true"
            AllowResizing="true"
            AllowExcelExport="true"
            AllowPdfExport="true"
            EnableHover="true"
            AllowTextWrap="true"
            AllowSelection="true"
            AllowSorting="true"
            Height="100%" Width="100%"
            Toolbar=@toolbar
            EnableStickyHeader="true">

        <GridEditSettings AllowAdding="true"
                          AllowEditing="true"
                          AllowDeleting="true"
                          ShowDeleteConfirmDialog="true"
                          Mode="EditMode.Dialog"
                          Dialog="DialogParams">

            <HeaderTemplate>
                @{
                    var DialogHeader = GetDialogHeader((context as ParameterModel)!);
                    <span>@DialogHeader</span>
                }
            </HeaderTemplate>
        </GridEditSettings>

        <GridEvents OnToolbarClick="ToolbarBtnClickHandler"
                    RowCreating="RowCreatingHandler"
                    OnActionComplete="ActionCompleteHandler"
                    TValue="ParameterModel">
        </GridEvents>

        <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>

        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

        <GridColumns>
            <GridColumn IsPrimaryKey="true" Field="@nameof(ParameterModel.Id)" Visible="false"
                        AllowAdding="false"
                        AllowEditing="false"
                        AllowSorting="false"
                        AllowFiltering="false"
                        Width="35">
            </GridColumn>

            <GridColumn Field=@nameof(ParameterModel.Baujahr)
                        EditType="EditType.DatePickerEdit"
                        Format="d"
                        Type="Syncfusion.Blazor.Grids.ColumnType.DateTime"
                        Width="110"
                        DefaultValue="DateTime.Now"
                        HeaderText="Baujahr Haus">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("BJ")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Baujahr Haus</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(ParameterModel.Wohnflaeche)
                        Format="###.00 m2"
                        Width="125"
                        HeaderText="Wohnfläche">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Wohnfläche"
                                      FloatLabelType="FloatLabelType.Always"
                                      TValue="Double?"
                                      @bind-Value="@((context as ParameterModel)!.Wohnflaeche)"
                                      Format="###.## m2">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("WF")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Wohnfläche</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(ParameterModel.Bemerkung)
                        Width="300"
                        HeaderText="Bemerkung">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("BM")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Bemerkung</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                <GridCommandColumns>
                    <GridCommandColumn Type="CommandButtonType.Edit"
                                       ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Delete"
                                       ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Save"
                                       ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Cancel"
                                       ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                </GridCommandColumns>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfSpinner @bind-Visible="@SpinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

@* Dialog*@
<div>
    <SfDialog Target="#target"
                Width=@dialogWidth
                Height=@dialogHeight
                AllowDragging="true"
                ShowCloseIcon=" true"
                @bind-Visible="DialogVisible"
                AllowPrerender="true"
                IsModal="true"
                CssClass="MyCss">

        <DialogTemplates>
            <Header>@Header</Header>
        </DialogTemplates>

        <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>
        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

        @if (showDialogButtons)
        {
            <DialogButtons>
                <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
            </DialogButtons>
        }
    </SfDialog>
</div>

<style>
    .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
    }

    /* Dialog Editing*/
    .e-dialog .e-dlg-header-content {
        background-color: grey;
        font-size: 24px;
    }

    .e-dialog .e-dlg-header {
        color: white;
    }

    .e-dialog .e-dlg-content {
        color: black;
        background-color: lightgray;
        font-size: 16px;
    }

    .bg-color-grey {
        background: #deded9;
    }

    #toast_default .e-circle-check::before {
        content: "\e72b";
        font-size: 17px;
    }

    #toast_default .e-circle-close::before {
        content: "\e878";
        font-size: 17px;
    }

    .control-wrapper {
        max-width: 250px;
        min-width: 80px;
        margin: 0 auto;
    }

    .control-label {
        font-size: 14px;
        margin: 6px 0px;
    }

    /* Dialog: Datensatz ändern */
    .MyCss .e-dlg-header-content {
        background-color: red;
        padding-top: 5px;
        padding-bottom: 15px;
    }

    .e-grid .e-dlg-content,
    .e-grid .e-footer-content {
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .e-grid .e-dlg-header {
        background-color: red;
    }
</style>

