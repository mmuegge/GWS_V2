@page "/water_cost_comparison"

@using GWS_Statistics.Helper
@using static GWS_Statistics.Helper.HelperMethods
@using GWS_Statistics.Calculation
@using System.Globalization
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Data

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Electric_ConsumptionModel> Logger
@inject NavigationManager NavigationManager
@inject SfDialogService DialogService

<PageTitle>Wasser- Kosten-Vergleich</PageTitle>

@* Seiten-Überschrift *@
<div class="container">
    <div class="row">
        <div class="text-center fs-3 fw-bold">
            <span class="fa-solid fa-faucet-drip fa-3xs" aria-hidden="true"> </span>
            <label>Wasser- Kosten-Vergleich</label>
        </div>
    </div>
</div>

<div class="card shadow-lg p-2 mb-1">
    @* Anzeigen alle Anbieter Start-Datum/Ende-Datum*@
    <div class="container-fluid bg-color-grey pb-2 border">
        <div class="row justify-content-center">

            @* Anbieter *@
            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    <SfTextBox Placeholder="Alle Anbieter" Readonly="true"></SfTextBox>
                </div>
            </div>

            @* Start-Datum *@
            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@StartDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            @* Ende-Datum *@
            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@EndDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>
</div>

@* Chart *@
@if (ChartPointList != null && ChartPointList.Count > 0)
{
    <div class="control-section" id="target" align="center">
        <div class="card shadow-lg">
            <SfChart @ref="chart" Title="Übersicht" Width="@Width" Height="@Height" Palettes="@palettes">
                <ChartEvents 
                OnAxisLabelRender="LabelRender"
                SharedTooltipRender="ToolTipRenderEvent">
                </ChartEvents>
                <ChartTitleStyle Size="24px"
                Color="black"
                FontFamily=@fontFamily
                FontWeight="normal"
                FontStyle="normal">
                </ChartTitleStyle>

                <ChartArea Background="#8c8b87"
                Width="auto">
                    <ChartAreaBorder Color="black"
                    Width="1"></ChartAreaBorder>
                </ChartArea>

                <ChartMargin Left="20" Right="20" Top="10" Bottom="0"></ChartMargin>

                <ChartZoomSettings EnableMouseWheelZooming="true" EnablePinchZooming="true" EnableSelectionZooming="true"></ChartZoomSettings>

                <ChartPrimaryXAxis RangePadding="ChartRangePadding.Additional"
                ValueType="Syncfusion.Blazor.Charts.ValueType.DateTimeCategory"
                EdgeLabelPlacement="EdgeLabelPlacement.None"
                Interval="@IntervalDuration"
                Format="@DateTimeFormat"
                IntervalType="@IntervalType">

                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    <ChartAxisLabelStyle FontFamily=@fontFamily></ChartAxisLabelStyle>
                    <ChartAxisTitleStyle FontFamily=@fontFamily></ChartAxisTitleStyle>
                    <ChartAxisCrosshairTooltip Fill="magenta" Enable="true"></ChartAxisCrosshairTooltip>
                </ChartPrimaryXAxis>

                <ChartPrimaryYAxis Title="Verbrauch (m3)"
                LabelFormat="{value}"
                RangePadding="ChartRangePadding.Normal">

                    <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                    <ChartAxisLabelStyle FontFamily=@fontFamily></ChartAxisLabelStyle>
                    <ChartAxisTitleStyle FontFamily=@fontFamily></ChartAxisTitleStyle>
                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    <ChartAxisCrosshairTooltip Fill="magenta" Enable="false"></ChartAxisCrosshairTooltip>
                </ChartPrimaryYAxis>

                <ChartAxes>
                    <ChartAxis Name="yAxisCons_m3"
                    Title="Verbrauch"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="false"
                    Interval="@Interval_YAxis_m3"
                    Minimum="@MinRangeCons_m3"
                    Maximum="@MaxRangeCons_m3"
                    LabelFormat="N0">
                        <ChartAxisMajorGridLines Width="1"></ChartAxisMajorGridLines>
                    </ChartAxis>

                    <ChartAxis Name="yAxisCost_m3"
                    Title="Kosten"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="false"
                    Interval="@Interval_YAxis_Cost_m3"
                    Minimum="@MinRangeCost_m3"
                    Maximum="@MaxRangeCost_m3"
                    LabelFormat="N0">
                        <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    </ChartAxis>

                    <ChartAxis Name="yAxisCost_Total"
                    Title="Gesamtkosten"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="true"
                    Interval="@Interval_YAxis_Cost_Total"
                    Minimum="@MinRangeCost_Total"
                    Maximum="@MaxRangeCost_Total"
                    LabelFormat="N0">
                        <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    </ChartAxis>
                </ChartAxes>

                <ChartSeriesCollection>
                    <ChartSeries Type="ChartSeriesType.Column"
                    DataSource="@ChartPointList"
                    YAxisName="yAxisCons_m3"
                    XName="Date"
                    YName="Cons_m3"
                    Width="3"
                    Name="Verbrauch"
                    TooltipFormat="${series.name} : ${point.y} m³">
                    </ChartSeries>

                    <ChartSeries Type="ChartSeriesType.Column"
                    DataSource="@ChartPointList"
                    YAxisName="yAxisCost_m3"
                    XName="Date"
                    YName="Cost_m3"
                    Width="3"
                    Name="Kosten"
                    TooltipFormat="${series.name} : ${point.y} €/m³">
                    </ChartSeries>

                    <ChartSeries Type="ChartSeriesType.Column"
                    DataSource="@ChartPointList"
                    YAxisName="yAxisCost_Total"
                    XName="Date"
                    YName="Cost_Total"
                    Width="3"
                    Name="Gesamtkosten"
                    TooltipFormat="${series.name} : ${point.y} €">
                    </ChartSeries>

                </ChartSeriesCollection>

                <ChartCrosshairSettings Enable="true" LineType="LineType.Both"></ChartCrosshairSettings>

                <ChartLegendSettings Visible="true"
                EnableHighlight="true">
                </ChartLegendSettings>
                <ChartTooltipSettings Header="<b>${point.tooltip}</b>" Enable="true" Shared="true"></ChartTooltipSettings>

                <SfSpinner @bind-Visible="@spinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

            </SfChart>
        </div>
    </div>
}
else
{
    <SfSpinner @bind-Visible="@spinnerVisibleProperty" Label="Lade Daten..." Size="40"></SfSpinner>
}

@* Dialog*@
<div>
    <SfDialog Target="#target" Width="320px" Height=@dialogHeight AllowDragging="true" ShowCloseIcon=" true" @bind-Visible="DialogVisible" AllowPrerender="true" IsModal="true">
        <DialogTemplates>
            <Header>@Header</Header>
        </DialogTemplates>
        <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>
        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>
    </SfDialog>
</div>

<style>
    .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
    }

    .e-dialog .e-dlg-header-content {
        color: white;
        background-color: red;
        font-size: 24px;
    }

    .e-dialog .e-dlg-header {
        color: white;
    }

    .e-dialog .e-dlg-content {
        color: white;
        background-color: red;
        font-size: 16px;
    }

    .bg-color-grey {
        background: #deded9;
    }

    .control-wrapper {
        max-width: 250px;
        min-width: 80px;
        margin: 0 auto;
    }

    .control-label {
        font-size: 14px;
        margin: 6px 0px;
    }

    .tooltipStyle {
        border-radius: 25px;
    }

    .tooltipTextcolor {
        color: white;
        background-color: black;
    }
</style>

@code
{
    // Variablendeklaration
    #region Variablendeklaration
    #region DialogBox
    DialogEffect animationEffect { get; set; } = DialogEffect.Zoom;
    bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string DialogText { get; set; } = string.Empty;
    private string dialogXValue = "center";
    private string dialogYValue = "center";
    private string dialogHeight = "130px";
    private string dialogWidth = "380px";
    #endregion

    #region Spinner
    private bool spinnerVisibleProperty { get; set; } = false;
    #endregion

    #region Daten
    private List<Water_SupplierModel>? supplierList = new();
    private Water_SupplierModel? supplierData = new();
    private List<GWS_PaymentModel>? paymentList = new();
    private List<Water_CounterChangeModel>? counterChangeList = null;
    #endregion

    #region DateTime
    private DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    private DateTime MaxDate { get; set; } = DateTime.Now;
    private DateTime? StartDate { get; set; } = new DateTime(2000, 1, 1);
    private DateTime? EndDate { get; set; } = new DateTime(2000, 1, 1);
    #endregion

    #region App-Settings
    private MyAppConfigModel? settings = new();
    #endregion

    #region Url
    private readonly string urlSupplier = "wasser/anbieter/";
    private readonly string urlPayments = "wasser/zahlungen/";
    readonly string urlCounterChangeAllSuppliers = "wasser/zaehlerwechsel";
    #endregion

    string? Header { get; set; }
    string? Content { get; set; }

    #region Http
    GWSProcessor? gwsP;
    #endregion

    #region Chart
    SfChart chart = new();
    private string fontFamily { get; set; } = "Arial";
    private IntervalType IntervalType { get; set; } = IntervalType.Months;
    private int IntervalDuration { get; set; } = 1;

    private string DateTimeFormat { get; set; } = "yyyy";

    private Theme Theme { get; set; }
    private string Width { get; set; } = "100%";
    private string Height { get; set; } = "160%";
    private double Rotation { get; set; } = 0;
    private LabelIntersectAction Label { get; set; } = LabelIntersectAction.Trim;
    private String[] palettes = new String[] { "#f2ae1b", "#1b85cc", "#fc0303" };  // Farben Serie: Verbrauch kWh, Kosten/kWh, Gesamtkosten
    private double Interval_YAxis_m3 { get; set; } = 10.0d;
    private double Interval_YAxis_Cost_m3 { get; set; } = 1.0d;
    private double Interval_YAxis_Cost_Total { get; set; } = 100.0d;

    private double MaxRangeCons_m3 { get; set; } = 200;
    private double MaxRangeCost_m3 { get; set; } = 10;
    private double MaxRangeCost_Total { get; set; } = 500;

    private double MinRangeCons_m3 { get; set; } = 0;
    private double MinRangeCost_m3 { get; set; } = 0;
    private double MinRangeCost_Total { get; set; } = 0;

    private List<ColumnChartData> ChartPointList { get; set; } = new List<ColumnChartData>();

    public class ColumnChartData
    {
        public DateTime Date { get; set; }
        public double Cons_m3 { get; set; }
        public double Cost_m3 { get; set; }
        public double Cost_Total { get; set; }
    }
    #endregion
    #endregion

    #region OnInitializedAsync
    /// <summary>
    /// Startet beim Laden der Seite automatisch und ruft die Daten parallel ab, berechnet die Chart-Daten und zeigt ggf. Dialoge an.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        this.spinnerVisibleProperty = true;

        try
        {
            // 1. Einstellungen auslesen
            settings = await GetSetMyAppConfig.GetMyAppSettings.ReadSettingsAsync(myAppSettings);
            gwsP = new GWSProcessor(myHttpClient, settings!.GWSUri);

            // 2. Performance-Boost: Gas-Anbieter und Zahlungen PARALLEL über die API abrufen
            Task<List<Water_SupplierModel>?> supplierTask = gwsP.LoadDataAsync<Water_SupplierModel>(urlSupplier);
            Task<List<GWS_PaymentModel>?> paymentTask = gwsP.LoadDataAsync<GWS_PaymentModel>(urlPayments);

            // Warten, bis beide HTTP-Anfragen parallel abgeschlossen sind
            await Task.WhenAll(supplierTask, paymentTask);

            supplierList = supplierTask.Result;
            paymentList = paymentTask.Result;

            // 3. Early Exits (Frühzeitiger Ausstieg) statt tiefer If-Verschachtelungen
            if (supplierList == null || supplierList.Count == 0)
            {
                OpenDialog("Keine Wasser-Anbieter vorhanden!", "60px", "380px", false);
                return;
            }

            if (paymentList == null || paymentList.Count == 0)
            {
                OpenDialog("Keine Wasser-Zahlungen vorhanden!", "60px", "380px", false);
                return;
            }

            // HINWEIS: Das Sortieren der Listen entfällt komplett, da das Dictionary in
            // CalcChartData die Zuordnung ohnehin in O(1) unabhängig von der Reihenfolge erledigt.

            // 4. Daten verarbeiten und Chart berechnen
            await CalcChartData(supplierList, paymentList);
        }
        catch (Exception)
        {
            OpenDialog("Keine Wasser-Daten vorhanden!", "60px", "380px", false);
        }
        finally
        {
            // 5. Spinner im 'finally' garantiert ausschalten (greift auch bei Fehlern)
            this.spinnerVisibleProperty = false;

            StateHasChanged();
        }
    }
    #endregion

    #region CalcChartData
    /// <summary>
    /// Berechnung der Chart-Daten für Verbrauch, Kosten/m3 und Gesamtkosten
    /// </summary>
    /// <param name="suppliers"></param>
    /// <param name="payments"></param>
    /// <returns></returns>
    public async Task CalcChartData(List<Water_SupplierModel>? suppliers, List<GWS_PaymentModel>? payments)
    {
        // 1. Sicherer Null- und Leer-Check vorab (Verhindert Exceptions bei null)
        if (suppliers == null || suppliers.Count == 0 || payments == null || payments.Count == 0)
        {
            chart.ClearSeries();
            OpenDialog("Keine Wasser-Vergleichskosten vorhanden!", "60px", "380px", false);
            return;
        }

        GetStartDateEndDate(suppliers);

        // Externe Daten asynchron laden
        counterChangeList = await gwsP!.LoadDataAsync<Water_CounterChangeModel>(urlCounterChangeAllSuppliers);

        List<IConsumption> consumptionsYearly = await Task.Run(() => GWS_Calculation.CalcConsumptionYearly(suppliers, counterChangeList));

        if (consumptionsYearly == null || consumptionsYearly.Count == 0)
        {
            OpenDialog("Keine Wasser-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }

        // 2. Performance-Boost: Zahlungen vorab indizieren (O(1) statt Listen-Scan in der Schleife)
        var paymentLookup = payments
            .GroupBy(p => p.ID_Anbieter)
            .ToDictionary(g => g.Key, g => g.Sum(p => p.Zahlungen));

        double cons_m3;
        double cost_m3 = 0.0d;
        double cost_Total;

        // Flag, damit der Dialog bei fehlenden Kosten nur einmal aufpoppt
        bool hasShownNoCostDialog = false;

        // 3. Effiziente Schleife
        foreach (var cons in consumptionsYearly)
        {
            // Sicheres Auslesen des Nullable double? aus IConsumption
            cons_m3 = cons.Consumption.GetValueOrDefault();

            // Blitzschneller Zugriff auf die summierten Kosten aus dem Dictionary
            if (paymentLookup.TryGetValue(cons.SupplierId, out double? tempCost))
            {
                cost_Total = tempCost.GetValueOrDefault();
            }
            else
            {
                cost_Total = 0.0d;
            }

            // Berechnung & Dialog-Logik
            if (cons_m3 > 0.0d)
            {
                // Hinweis: Bleibt wie im Original reine Division (€/m³ statt ct/kWh)
                cost_m3 = cost_Total / cons_m3;
            }
            else
            {
                cost_m3 = 0.0d; // Definierten Standardwert setzen
                chart.ClearSeries();

                if (!hasShownNoCostDialog)
                {
                    OpenDialog("Keine Wasser-Kosten vorhanden!", "60px", "380px", false);
                    hasShownNoCostDialog = true; // Sperre für weitere Durchläufe aktivieren
                }
            }

            // Zuweisung an Cons_m3 und Cost_m3 (passend zur GetChartMinMaxRange aus Schritt 1)
            ChartPointList.Add(new ColumnChartData
            {
                Date = cons.Date,
                Cons_m3 = cons_m3,
                Cost_m3 = cost_m3,
                Cost_Total = cost_Total
            });
        }

        GetChartMinMaxRange(ChartPointList);
    }

    #endregion

    #region GetStartDateEndDate
    /// <summary>
    /// Auslesen des frühesten Startdatums und spätesten Enddatums aus der Liste der Anbieter
    /// </summary>
    /// <param name="suppliers"></param>
    public void GetStartDateEndDate(List<Water_SupplierModel>? suppliers)
    {
        // 1. Früher Ausstieg bei leeren Daten + sauberes Fallback auf 'null'
        if (suppliers == null || suppliers.Count == 0)
        {
            StartDate = null;
            EndDate = null;
            return;
        }

        DateTime? minStart = DateTime.MaxValue;
        DateTime? maxEnd = DateTime.MinValue;
        bool hasValidData = false;

        // Cache für DateTime.Now, damit es nicht in jeder Schleifeniteration neu abgefragt werden muss
        DateTime now = DateTime.Now;

        // 2. Einmaliger, schneller Durchlauf
        foreach (var supplier in suppliers)
        {
            // Lokale Variablen reduzieren mehrfache Property-Zugriffe
            var start = supplier.Zeitraum_Start;
            var end = supplier.Zeitraum_Ende;

            // Kombinierter Check: Nur abgelaufene Zeiträume mit validen Daten betrachten
            if (start.HasValue && end.HasValue && end.Value < now)
            {
                if (start.Value < minStart.Value) minStart = start;
                if (end.Value > maxEnd.Value) maxEnd = end;
                hasValidData = true;
            }
        }

        // 3. Zuweisung nur, wenn tatsächlich passende Daten gefunden wurden
        StartDate = hasValidData ? minStart : null;
        EndDate = hasValidData ? maxEnd : null;
    }
    #endregion

    #region GetChartMinMaxRange
    /// <summary>
    /// Berechnung der Min/Max-Werte für die Y-Achsen der Chart-Darstellung
    /// </summary>
    public void GetChartMinMaxRange(List<ColumnChartData> chartList)
    {
        // 1. Früher Abbruch
        if (chartList == null || !chartList.Any())
        {
            MinRangeCons_m3 = MaxRangeCons_m3 = 0.0d;
            MinRangeCost_m3 = MaxRangeCost_m3 = 0.0d;
            MinRangeCost_Total = MaxRangeCost_Total = 0.0d;
            return;
        }

        // 2. Initialisierung der Min-Werte und Intervalle
        MinRangeCons_m3 = 0.0d;
        MinRangeCost_m3 = 0.0d;
        MinRangeCost_Total = 0.0d;

        Interval_YAxis_m3 = 10.0d;
        Interval_YAxis_Cost_m3 = 1.0d;
        Interval_YAxis_Cost_Total = 50.0d;

        // 3. Startwerte für die Maximum-Suche aus dem ersten Element lesen
        // (Verhindert Probleme, falls alle Werte in der Liste 0 oder negativ sind)
        var firstItem = chartList.FirstOrDefault(x => x != null);
        if (firstItem == null) return;

        double maxCons = firstItem.Cons_m3;
        double maxCostM3 = firstItem.Cost_m3;
        double maxCostTotal = firstItem.Cost_Total;

        // Liste einmal komplett durchlaufen
        foreach (var item in chartList)
        {
            if (item == null) continue;

            if (item.Cons_m3 > maxCons) maxCons = item.Cons_m3;
            if (item.Cost_m3 > maxCostM3) maxCostM3 = item.Cost_m3;
            if (item.Cost_Total > maxCostTotal) maxCostTotal = item.Cost_Total;
        }

        // 4. Werte runden und Offsets addieren
        MaxRangeCons_m3 = Math.Round(maxCons, 0) * 1.05d; // 5% Puffer
        MaxRangeCost_m3 = Math.Round(maxCostM3, 0) * 1.05d; // 5% Puffer
        MaxRangeCost_Total = Math.Round(maxCostTotal, 0) * 1.05d; // 5% Puffer

    }
    #endregion

    #region OpenDialog
    /// <summary>
    /// Dialog öffnen mit Header, Höhe, Breite und optionalen Buttons
    /// </summary>
    private void OpenDialog(string header, string height="auto", string width="500px", bool showButtons=true)
    {
        Header = header;
        dialogHeight = height;
        dialogWidth = width;
        showDialogButtons = showButtons;
        this.DialogVisible = true;

        // Erzwingt das Neu-Rendern der UI (wichtig in Blazor für Dialoge)
        this.StateHasChanged();
    }
    #endregion

    #region LabelRender
    /// <summary>
    /// LabelRender für Achsenbeschriftung, um Suffixe wie "m³", "€/m³" oder "€" hinzuzufügen.
    /// </summary>
    /// <param name="args"></param>
    public void LabelRender(AxisLabelRenderEventArgs args)
    {
        // Absicherung gegen Null-Werte beim Laden/ Rendern der Achsen
        if (args?.Axis?.Name == null) return;

        // 1. Das passende Suffix anhand des Achsennamens ermitteln
        string? suffix = args.Axis.Name switch
        {
            "yAxisCons_m3" => " m³",
            "yAxisCost_m3" => " €/m³",
            "yAxisCost_Total" => " €",
            _ => null // Fallback für andere Achsen
        };

        // 2. String elegant anhängen, falls eine bekannte Achse getroffen wurde
        if (suffix != null)
        {
            args.Text += suffix;
        }
    }
    #endregion

    #region ToolTipRenderEvent
    /// <summary>
    /// Anzeige von x Nachkommastellen im Tooltip!
    /// </summary>
    /// <param name="args"></param>
    public void ToolTipRenderEvent(SharedTooltipRenderEventArgs args)
    {
        if (args?.Data == null || args.Text == null) return;

        for (int i = 0; i < args.Data.Count; i++)
        {
            var di = args.Data[i];
            if (di?.PointY == null) continue;

            // 1. Numerischen Wert direkt ermitteln ohne String-Fallback wo möglich
            if (!TryGetDouble(di.PointY, out double y)) continue;

            // 2. Einheit über Pattern Matching (C# 8+) ermitteln
            string? unit = di.SeriesName switch
            {
                "Kosten" => "€/m³",
                "Verbrauch" => "m³",
                "Gesamtkosten" => "€",
                _ => null
            };

            // 3. String-Zuweisung absichern (Index-Check)
            if (unit != null && i < args.Text.Count)
            {
                // Nachkommastellen
                string decimalFormat = di.SeriesName == "Kosten" ? "N2" : "N0";
                args.Text[i] = $"{di.SeriesName}: {y.ToString(decimalFormat, DisplayCulture)} {unit}";
            }
        }
    }
    #endregion
}