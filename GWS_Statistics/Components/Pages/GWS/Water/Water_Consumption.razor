    #region CalcAverageSum
    /// <summary>
    /// Berechnen Durchschnitt/Summe/Min/Max
    /// </summary>
    public void CalcAverageSum()
    {
        if (supplierData is null || ChartPointList is null || ChartPointList.Count == 0)
        {
            ConsMin_TW_m3 = 0;
            ConsMax_TW_m3 = 0;
            ConsSum_TW_m3 = 0;
            ConsSum_AW_m3 = 0;
            ConsAverage_TW_m3 = 0;
            ConsAverage_AW_m3 = 0;
            TempAverage = 0;
            return;
        }

        // 1. Allgemeine Durchschnitts-, Min- und Max-Werte direkt aus der Chart-Liste berechnen
        ConsAverage_TW_m3 = Math.Round(ChartPointList.Average(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        ConsAverage_AW_m3 = Math.Round(ChartPointList.Average(x => x.Cons_AW_m3).GetValueOrDefault(), 2);
        ConsMin_TW_m3 = Math.Round(ChartPointList.Min(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        ConsMax_TW_m3 = Math.Round(ChartPointList.Max(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        TempAverage = Math.Round(ChartPointList.Average(x => x.Temp).GetValueOrDefault(), 2);

        // =========================================================================
        // SUMMEN-BERECHNUNG (Direkt aus der Liste aggregiert)
        // =========================================================================

        // Fall A: Bei jährlich werden die Summen-Felder in der UI immer geleert
        if (DdlInterval == Interval.jährlich)
        {
            ConsSum_TW_m3 = null;
            ConsSum_AW_m3 = null;

            // Jahr mit dem höchsten Verbrauch ermitteln
            Year_MaxCons = ChartPointList
                .OrderByDescending(x => x.Cons_TW_m3)
                .Select(x => x.Date.Year)
                .FirstOrDefault();

            // Jahr mit dem niedrigsten Verbrauch ermitteln
            Year_MinCons = ChartPointList
                .OrderBy(x => x.Cons_TW_m3)
                .Select(x => x.Date.Year)
                .FirstOrDefault();
        }
        // Fall B: Bei täglich / monatlich ziehen wir die echten Summen direkt aus den Chart-Punkten
        else
        {
            ConsSum_TW_m3 = Math.Round(ChartPointList.Sum(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
            ConsSum_AW_m3 = Math.Round(ChartPointList.Sum(x => x.Cons_AW_m3).GetValueOrDefault(), 2);
        }
    }
    #endregion

    #region GetMockChartData
    /// <summary>
    /// Auslesen der Mock-Daten
    /// </summary>
    /// <param name="data"></param>
    /// <param name="startPeriod"></param>
    /// <param name="endPeriod"></param>
    public void GetMockChartData(DateTime? startPeriod, DateTime? endPeriod)
    {
        const int days = 364;
        DateTime dayToday = DateTime.Today; // .Today statt .Now, da Uhrzeit für den Tagesvergleich meist irrelevant ist
        DateTime startDate = startPeriod ?? new DateTime(1970, 1, 1);

        // Kapazität direkt zuweisen verhindert Speicher-Reallozierungen
        var temporaryList = new List<ColumnChartData>(days);

        for (int i = 0; i < days; i++)
        {
            DateTime currentDate = startDate.AddDays(i);
            if (currentDate > dayToday)
            {
                break;
            }

            // Random.Shared ist thread-safe und performanter (ab .NET 6)
            double consumption = Random.Shared.Next(0, 10);
            double temperature = Random.Shared.Next(-10, 30);

            temporaryList.Add(new ColumnChartData
            {
                Date = currentDate,
                Cons_TW_m3 = consumption,
                Temp = temperature,
            });
        }

        // Thread-Sicherheit erhöhen: Erst am Ende der UI/Klasse zuweisen
        ChartPointList = temporaryList;

        // Künstliche Verzögerung (falls für UI-Effekte gewollt), sonst Zeile komplett löschen
        //await Task.Delay(200);

        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region GetChartMinMaxRange
    /// <summary>
    /// Berechnen Chart Min/Max-Range
    /// </summary>
    public  void GetChartMinMaxRange(List<ColumnChartData> chartList)
    {
        // 1. Früher Abbruch
        if (chartList == null || !chartList.Any())
        {
            MinRangeCons = 0.0d;
            MaxRangeCons_TW_m3 = 0.0d;
            MaxRangeCons_AW_m3 = 0.0d;
            return;
        }

        // 2. Initialisierung der Min-Werte und Intervalle
        MinRangeCons = 0.0d;

        // 3. JETZT erst das Switch-Statement ausführen (da MaxRangeCons_TW_m3 nun bekannt ist!)
        (string label, int decimalPlaces, int interval) = DdlInterval switch
        {
            Interval.täglich => ("N2", 1, 4),
            Interval.monatlich => ("N1", 1, 4),
            Interval.jährlich => ("N0", 0, 3),
            _ => ("N0", 1, 4)
        };

        // Globale Format-Variable für das Razor-Markup füllen
        labelFormat = label;

        // 4. Startwerte für die Maximum-Suche aus dem ersten Element lesen
        // (Verhindert Probleme, falls alle Werte in der Liste 0 oder negativ sind)
        var firstItem = chartList.FirstOrDefault(x => x != null);
        if (firstItem == null) return;

        double maxCons_TW_m3 = firstItem.Cons_TW_m3 ?? 0.0d;
        double maxCons_AW_m3 = firstItem.Cons_AW_m3 ?? 0.0d;

        // Liste einmal komplett durchlaufen
        foreach (var item in chartList)
        {
            if (item == null) continue;

            if (item.Cons_TW_m3 > maxCons_TW_m3) maxCons_TW_m3 = item.Cons_TW_m3 ?? 0.0d;
            if (item.Cons_AW_m3 > maxCons_AW_m3) maxCons_AW_m3 = item.Cons_AW_m3 ?? 0.0d;
        }

        // 5. Werte runden und Offsets addieren
        MaxRangeCons_TW_m3 = Math.Round(maxCons_TW_m3 * 1.05d, decimalPlaces); // 5% Puffer
        MaxRangeCons_AW_m3 = Math.Round(maxCons_AW_m3 * 1.05d, decimalPlaces); // 5% Puffer

        // 6. Intervall berechnen
        Interval_YAxis = Math.Round(MaxRangeCons_TW_m3 / interval, decimalPlaces);
    }

