@page "/water_consumption"
@* @rendermode InteractiveServer *@

@using GWS_Statistics.Helper
@using GWS_Statistics.Calculation
@using System.Globalization
@using System.Net
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Data
@using System.ComponentModel
@using System.Reflection

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Water_ConsumptionModel> Logger
@inject NavigationManager NavigationManager
@inject SfDialogService DialogService

<PageTitle>Wasser- Verbräuche</PageTitle>

<div class="container">
    <div class="row">
        <div class="text-center fs-3 fw-bold">
            <span class="fa-solid fa-faucet-drip fa-3xs" aria-hidden="true"> </span>
            <label>Wasser- Verbräuche</label>
        </div>
    </div>
</div>

@* Auswahl Anbieter und Anzeigen Start-Datum/Ende-Datum*@
 <div class="card shadow-lg">
    <div class="container chartHeader bg-color-grey mb-1 mt-1 pb-2 border">
    <div class="row justify-content-center">

        <div class="col-6 col-xl-3">
            <div class="control-wrapper">
                <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                @if (supplierSelectEnabled)
                {
                    <SfDropDownList DataSource="@supplierList" TItem="Water_SupplierModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData!.Id" Enabled="@supplierSelectEnabled">
                        <DropDownListFieldSettings Text="Anbieter" Value="Id"></DropDownListFieldSettings>
                        <DropDownListEvents TItem="Water_SupplierModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                    </SfDropDownList>
                }
                else
                {
                    <SfTextBox Placeholder="Alle Anbieter" Readonly="true"></SfTextBox>
                }
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="control-wrapper">
                <label class="control-label fw-bold mb-sm-1 me-1">Interval</label>
                <SfDropDownList DataSource="@EnumInterval" TItem="string" TValue="Interval" @bind-Value="DdlInterval">
                    <DropDownListEvents TItem="string" TValue="Interval" ValueChange="@OnValueChangeInterval"></DropDownListEvents>
                </SfDropDownList>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="control-wrapper">
                <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                @if (supplierSelectEnabled)
                {
                    <SfDatePicker TValue="DateTime?" Value="@StartDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                }
                else
                {
                    <SfDatePicker TValue="DateTime?" Value="@StartDateYearly" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                }
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="control-wrapper">
                <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                @if (supplierSelectEnabled)
                {
                    <SfDatePicker TValue="DateTime?" Value="@EndDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                }
                else
                {
                    <SfDatePicker TValue="DateTime?" Value="@EndDateYearly" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                }
            </div>
        </div>
    </div>
</div>

@* Durchschnitt, Summe, Min, Max *@
    <div class="container chartHeader bg-color-grey mt-2 mb-1 py-1 border">
    <div class="row">
        @* Durchschnittsverbrauch *@
        <div class="col-6 col-xl-3">
            <div class="control-wrapper">
                <label class="control-label fw-bold mb-sm-1 me-1">Ø-Verbrauch TW/AW</label>
                <SfNumericTextBox TValue="double?" Value="@ConsAverage_TW_m3" Enabled="false" Format="####0.00 m³"></SfNumericTextBox>
                <div class="mt-1">
                    <SfNumericTextBox TValue="double?" Value="@ConsMin_TW_m3" Enabled="false" Format="####0.00 m³"></SfNumericTextBox>
                </div>
            </div>
        </div>

        @* Gesamtverbrauch *@
        <div class="col-6 col-xl-3">
            <div class="control-wrapper">
                <label class="control-label fw-bold mb-sm-1 me-1">&#8721-Verbrauch TW/AW</label>
                <SfNumericTextBox TValue="double?" Value="@ConsSum_TW_m3" Enabled="false" Format="####0.00 m³"></SfNumericTextBox>
                <div class="mt-1">
                    <SfNumericTextBox TValue="double?" Value="@ConsMin_TW_m3" Enabled="false" Format="####0.00 m³"></SfNumericTextBox>
                </div>
            </div>
        </div>

        @* Max/Min Verbrauch *@
        <div class="col-6 col-xl-3">
            <div class="control-wrapper">
                <label class="control-label fw-bold mb-sm-1 me-1">Max/Min TW</label>
                <SfNumericTextBox TValue="double?" Value="@ConsMax_TW_m3" Enabled="false" Format="####0.00 m³"></SfNumericTextBox>
                <div class="mt-1">
                    <SfNumericTextBox TValue="double?" Value="@ConsMin_TW_m3" Enabled="false" Format="####0.00 m³"></SfNumericTextBox>
                </div>
            </div>
        </div>

        @* Durchschnittstemperatur *@
        @if (DdlInterval != Interval.jährlich)
        {
            <div class="col-6 col-xl-3">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ø-Temperatur</label>
                    <SfNumericTextBox TValue="double?" Value="@TempAverage" Enabled="false" Format="##0.0 °C"></SfNumericTextBox>
                </div>
            </div>
        }
    </div>
</div>
</div>

@* Chart *@
<div class="control-section" id="target" align="center">
    <div class="card shadow-lg">
        <SfChart @ref="chart" Title="Übersicht" Width="@Width" Height="@Height" Palettes="@palettes">
            <ChartEvents 
                OnAxisLabelRender="LabelRender"
                SharedTooltipRender="ToolTipRenderEvent">
            </ChartEvents>

            <ChartTitleStyle Size="24px" 
                             Color="black" 
                             FontFamily=@fontFamily 
                             FontWeight="normal" 
                             FontStyle="normal">
            </ChartTitleStyle>

            <ChartArea Background="#8c8b87" Width="auto">
                <ChartAreaBorder Color="black" Width="1"></ChartAreaBorder>
            </ChartArea>

            <ChartMargin Left="20" Right="20" Top="10" Bottom="0"></ChartMargin>

            <ChartZoomSettings EnableMouseWheelZooming="true" EnablePinchZooming="true" EnableSelectionZooming="true"></ChartZoomSettings>

            <ChartPrimaryXAxis  RangePadding="ChartRangePadding.Additional"
                                ValueType="Syncfusion.Blazor.Charts.ValueType.DateTimeCategory"
                                EdgeLabelPlacement="EdgeLabelPlacement.None"
                                Interval="@IntervalDuration"
                                Format="@DateTimeFormat"
                                IntervalType="@IntervalType">

                <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                <ChartAxisLabelStyle FontFamily=@fontFamily></ChartAxisLabelStyle>
                <ChartAxisTitleStyle FontFamily=@fontFamily></ChartAxisTitleStyle>
                <ChartAxisCrosshairTooltip Fill="magenta" Enable="true"></ChartAxisCrosshairTooltip>
            </ChartPrimaryXAxis>

            <ChartPrimaryYAxis  Title="Verbrauch"
                                LabelFormat="{value} m³"
                                RangePadding="ChartRangePadding.Normal">

                <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                <ChartAxisLabelStyle FontFamily=@fontFamily></ChartAxisLabelStyle>
                <ChartAxisTitleStyle FontFamily=@fontFamily></ChartAxisTitleStyle>
                <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                <ChartAxisCrosshairTooltip Fill="magenta" Enable="false"></ChartAxisCrosshairTooltip>
            </ChartPrimaryYAxis>

            <ChartAxes>
                <ChartAxis  Name="yAxisCons"
                            Title="Verbrauch"
                            RangePadding="ChartRangePadding.Auto"
                            OpposedPosition="false"
                            Interval="@Interval_YAxis"
                            Minimum="0"
                            Maximum="@MaxRangeCons"
                            LabelFormat="@labelFormat">
                    <ChartAxisMajorGridLines Width="1"></ChartAxisMajorGridLines>
                </ChartAxis>

                <ChartAxis  Name="yAxisTemp"
                            Title="Temperatur"
                            RangePadding="ChartRangePadding.Auto"
                            OpposedPosition="true"
                            Interval="5"
                            Minimum="@MinRangeTemp"
                            Maximum="@MaxRangeTemp"
                            LabelFormat="N0">
                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                </ChartAxis>
            </ChartAxes>

            <ChartSeriesCollection>
                <ChartSeries    Type="ChartSeriesType.Column"
                                DataSource="@ChartPointList"
                                Visible="@serieConsm3_TW_Visible"
                                YAxisName="yAxisCons"
                                XName="Date"
                                YName="Cons_TW_m3"
                                Width="3"
                                GroupName="Consumption"
                                Name="Verbrauch-TW"
                                TooltipFormat="${series.name} : ${point.y}  m³">
                </ChartSeries>
                                
                @if (DdlInterval != Interval.jährlich)
                {
                    <ChartSeries Type="ChartSeriesType.Line"
                                 DataSource="@ChartPointList"
                                 YAxisName="yAxisTemp"
                                 Visible=@serieTempVisible
                                 XName="Date"
                                 YName="Temp"
                                 Width="1"
                                 Name="Temperatur"
                                 TooltipFormat="${series.name} : ${point.y} °C">
                    </ChartSeries>
                }
            </ChartSeriesCollection>

            <ChartCrosshairSettings Enable="true" LineType="LineType.Both"></ChartCrosshairSettings>

            <ChartLegendSettings Visible="true" EnableHighlight="true"></ChartLegendSettings>

            <ChartTooltipSettings Header="<b>${point.tooltip}</b>" Enable="true" Shared="true"></ChartTooltipSettings>
        </SfChart>

        <SfSpinner @bind-Visible="@spinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

        @* Dialog*@
        <div>
            <SfDialog Target="#target" Width="@dialogWidth" Height="@dialogHeight" AllowDragging="true" ShowCloseIcon="true" @bind-Visible="@DialogVisible" AllowPrerender="true" IsModal="true">
                <DialogTemplates>
                    <Header>@Header</Header>
                </DialogTemplates>
                <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>
                <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>
            </SfDialog>
        </div>
    </div>
</div>

<style>
    .e-dlg-overlay {
    background-color: slategray;
    opacity: 0.6;
    }

    .e-dialog .e-dlg-header-content {
    color: white;
    background-color: red;
    font-size: 24px;
    }

    .e-dialog .e-dlg-header {
    color: white;
    }

    .e-dialog .e-dlg-content {
    color: white;
    background-color: red;
    font-size: 16px;
    }

    .bg-color-grey {
    background: #deded9;
    }

    .control-wrapper {
    max-width: 250px;
    min-width: 80px;
    margin: 0 auto;
    }

    .control-label {
    font-size: 14px;
    margin: 6px 0px;
    }

    .tooltipStyle {
    border-radius: 25px;
    }

    .tooltipTextcolor {
    color: white;
    background-color: black;
    }
</style>

@code {
    // Variabledeklaration
    #region Variablendeklaration
    private bool success = false;
    bool supplierSelectEnabled = true;

    #region DialogBox
    DialogEffect animationEffect { get; set; } = DialogEffect.Zoom;
    bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string DialogText { get; set; } = string.Empty;
    private string dialogXValue = "center";
    private string dialogYValue = "center";
    private string dialogHeight = "130px";
    private string dialogWidth = "380px";
    #endregion

    #region Interval
    public IEnumerable<string> EnumInterval = Enum.GetNames(typeof(Interval));
    public Interval DdlInterval { get; set; } = Interval.täglich;

    public enum Interval
    {
        [Display(Name = "täglich")]
        täglich = 1,
        [Display(Name = "monatlich")]
        monatlich = 2,
        [Display(Name = "jährlich")]
        jährlich = 3
    }
    #endregion

    #region Spinner
    bool spinnerVisibleProperty { get; set; } = false;
    #endregion

    #region Daten
    private List<Water_SupplierModel>? supplierList = null;
    private List<Water_CounterModel>? counterList = null;
    private Water_SupplierModel? supplierData = new();
    private List<Water_CounterChangeModel>? counterChangeList = null;
    #endregion

    #region DateTime
    private DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    private DateTime MaxDate { get; set; } = DateTime.Now;
    private DateTime? StartDate { get; set; } = new DateTime(2000, 1, 1);
    private DateTime? EndDate { get; set; } = new DateTime(2000, 1, 1);
    private DateTime? StartDateYearly { get; set; } = DateTime.MaxValue;
    private DateTime? EndDateYearly { get; set; } = DateTime.MinValue;
    #endregion

    #region App-Settings
    MyAppConfigModel? settings;
    #endregion

    #region Url
    readonly string urlSupplier = "wasser/anbieter/";
    readonly string urlMeter = "wasser/zaehlerstaende/anbieter/";
    readonly string urlCounterChange = "wasser/zaehlerwechsel/anbieter/";
    readonly string urlCounterChangeAllSuppliers = "wasser/zaehlerwechsel";
    #endregion

    string? Header { get; set; }
    string? Content { get; set; }

    #region Http
    GWSProcessor? gwsP;
    #endregion

    #region PDF-Eigenschaften
    public List<PdfHeaderFooterContent> HeaderContent = new List<PdfHeaderFooterContent>
    {
        new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 4, X2 = 720, Y2 = 4}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },
        new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Wasser-Zählerstände", Position = new PdfPosition() { X = 350, Y = 20 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
        new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 40, X2 = 720, Y2 = 40}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },
        new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 8, HAlign = PdfHorizontalAlign.Right } }
    };

    public List<PdfHeaderFooterContent> FooterContent = new List<PdfHeaderFooterContent>
    {
        // new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Seite: ", Position = new PdfPosition() { X = 400, Y = 600 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
        // new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 10, HAlign = PdfHorizontalAlign.Right } }
    };
    #endregion

    #region Chart
    SfChart chart = new();
    public bool serieConsm3_TW_Visible = true;
    public bool serieConsm3_AW_Visible = false;
    public bool serieTempVisible = false;

    public string fontFamily { get; set; } = "Arial";
    // public Syncfusion.Blazor.Charts.IntervalType IntervalType { get; set; } = IntervalType.Months;
    public Syncfusion.Blazor.Charts.IntervalType IntervalType { get; set; } = IntervalType.Days;
    public int IntervalDuration { get; set; } = 1;

    public string DateTimeFormat { get; set; } = "dd.MM.yyyy";

    private Theme Theme { get; set; }
    public string Width { get; set; } = "100%";
    public string Height { get; set; } = "160%";
    public double Rotation { get; set; } = 0;
    public LabelIntersectAction Label { get; set; } = LabelIntersectAction.Trim;
    public String[] palettes = new String[] { "#03fcb6", "#0634bd" };  // Farben Serie: Verbrauch TW m3, Verbrauch AW m3, Temperatur
    public double Interval_YAxis { get; set; } = 0.5;
    public double MaxRangeCons { get; set; } = 2;
    public double MinRangeCons { get; set; } = 0;
    public double MaxRangeTemp { get; set; } = 40;
    public double MinRangeTemp { get; set; } = -10;

    public double? ConsAverage_TW_m3 { get; set; } = 0.0d; // Trinkwasser
    public double? ConsSum_TW_m3 { get; set; } = 0.0d; // Trinkwasser
    public double? ConsAverage_AW_m3 { get; set; } = 0.0d; // Abwasser
    public double? ConsSum_AW_m3 { get; set; } = 0.0d; // Abwasser
    public double? ConsMin_TW_m3 { get; set; } = 0.0d; // Trinkwasser
    public double? ConsMax_TW_m3 { get; set; } = 0.0d; // Trinkwasser
    public double? TempAverage { get; set; } = 0.0d;

    private string labelFormat = "N2";

    public List<ColumnChartData> ChartPointList { get; set; } = new List<ColumnChartData>();

    public class ColumnChartData
    {
        public DateTime Date { get; set; }
        public double? Cons_TW_m3 { get; set; }
        public double? Temp { get; set; }
    }
    #endregion

    #endregion

    #region OnInitializedAsync
    /// <summary>
    /// OnInitializedAsync
    /// </summary>
    /// <returns></returns>
    /// <exception cref="Exception"></exception>
    protected override async Task OnInitializedAsync()
    {
        int lastSupplierId = 0;
        int enumValue;
        bool success;

        this.spinnerVisibleProperty = true;

        // MyAppSettings.json auslesen und letzten gespeicherten Anbieter auslesen
        settings = await Task.Run(() => GetSetMyAppConfig.GetMyAppSettings.ReadSettings(myAppSettings));
        // Anzeigeintervall auslesen
        success = Int32.TryParse(settings!.Display_Interval!.Water, out enumValue);
        if (success)
        {
            DdlInterval = Enum.IsDefined(typeof(Interval), enumValue) ? DdlInterval = (Interval)enumValue : DdlInterval = Interval.täglich;
            supplierSelectEnabled = DdlInterval == Interval.jährlich ? false : true;
        }
        else
        {
            DdlInterval = Interval.täglich;
        }


        gwsP = new GWSProcessor(myHttpClient, settings.GWSUri);
        try
        {
            // Anbieterdaten auslesen (nur Anbieter und Id => durch WaterSupplierDataModel)
            supplierList = await gwsP.LoadDataAsync<Water_SupplierModel>(urlSupplier);

            if (supplierList != null && supplierList.Any()) // prüfen ob es Anbieterdaten gibt
            {
                // gespeicherten letzten Anbieter auslesen
                lastSupplierId = String.IsNullOrEmpty(settings.Supplier_Id!.Water) || settings.Supplier_Id.Water == "0" ? lastSupplierId = supplierList.Max(x => x.Id) : lastSupplierId = Int32.Parse(settings.Supplier_Id.Water);

                if (!supplierList.Any(s => s.Id == lastSupplierId)) // prüfen ob der gespeicherte Anbieter noch existiert
                {
                    lastSupplierId = supplierList.Max(x => x.Id); // wenn nicht, dann den letzten Anbieter auslesen
                }

                supplierData = supplierList
                                .Where(s => s.Id == lastSupplierId)
                                .Select(s => s).FirstOrDefault();

                if (supplierData != null)
                {
                    // Start-Datum/Ende-Datum auslesen
                    StartDate = supplierData.Zeitraum_Start ?? DateTime.Now;
                    EndDate = supplierData.Zeitraum_Ende ?? DateTime.Now;
                }
            }
            else
            {
                // es gibt keine gültigen Daten der Anbieter
                supplierData!.Id = 0;
            }

            counterList = await gwsP!.LoadDataAsync<Water_CounterModel>(urlMeter + Convert.ToString(supplierData!.Id)); // Daten des neu ausgewählten Anbieter laden

            // if (counterList?.Count != 0)
            if (counterList?.Any() == true)
            {
                counterList?.Sort((x, y) => x.Ablesetag.CompareTo(y.Ablesetag));
                await Task.Run(() => SelectChartData(DdlInterval));
            }
            else
            {
                ClearSumAverage();
                OpenDialog("Keine Wasser-Verbräuche vorhanden!", "60px", "380px", false);
            }
        }
        catch (Exception)
        {
            OpenDialog("Keine Wasser-Verbräuche vorhanden!", "60px", "380px", false);
        }

        // Spinner
        await Task.Delay(500); // muss sein sonst Runtime fault
        this.spinnerVisibleProperty = false;
    }
    #endregion

    #region ValueSelectHandler
    /// <summary>
    /// Ablesetage des ausgewählten Anbieters auslesen
    /// </summary>
    /// <param name="args"></param>
    private async Task ValueSelectHandler(SelectEventArgs<Water_SupplierModel> args)
    {
        this.spinnerVisibleProperty = true;
        //Anbieterdaten laden abhängig vom Dropdown "Anbieter"
        supplierData = supplierList!
                           .Where(s => s.Id == args.ItemData.Id)
                           .Select(s => s).FirstOrDefault();

        if (supplierData != null && supplierData.Id > 0)
        {
            StartDate = supplierData.Zeitraum_Start ?? DateTime.Now;
            EndDate = supplierData.Zeitraum_Ende ?? DateTime.Now;

            counterList = await gwsP!.LoadDataAsync<Water_CounterModel>(urlMeter + Convert.ToString(supplierData.Id)); // Daten des neu ausgewählten Anbieter laden

            counterChangeList = await gwsP!.LoadDataAsync<Water_CounterChangeModel>(urlCounterChange + Convert.ToString(supplierData.Id)); // Zählerwechsel des Anbieter laden

            if (counterList?.Any() == true)
            {
                counterList?.Sort((x, y) => x.Ablesetag.CompareTo(y.Ablesetag));
            }

            await Task.Run(() => SelectChartData(DdlInterval));

            success = await Task.Run(() => GetSetMyAppConfig.SetMyAppSettings.WriteSettings(myAppSettings, "Supplier_Id.Water", supplierData.Id.ToString())); // ausgewählten Anbieter in MyAppConfig speichern
            if (!success)
            {
                OpenDialog("Wasser-Anbieter nicht gespeichert!", "60px", "380px", false);
            }
        }
        else
        {
            ClearSumAverage();

            OpenDialog("Keine Wasser-Verbräuche vorhanden!", "60px", "380px", false);
        }

        // Spinner
        await Task.Delay(200);
        this.spinnerVisibleProperty = false;
    }
    #endregion

    #region OnValueChangeInterval
    /// <summary>
    /// OnValueChangeInterval
    /// </summary>
    /// <param name="data"></param>
    /// <param name="startPeriod"></param>
    /// <param name="endPeriod"></param>
    /// <exception cref="Exception"></exception>
    private async Task OnValueChangeInterval(ChangeEventArgs<Interval, string> args)
    {
        this.spinnerVisibleProperty = true;

        DdlInterval = (Interval)args.Value;
        supplierSelectEnabled = DdlInterval == Interval.jährlich ? false : true;
        int enumValue = (int)DdlInterval;

        await Task.Run(() => SelectChartData(DdlInterval));

        success = await Task.Run(() => GetSetMyAppConfig.SetMyAppSettings.WriteSettings(myAppSettings, "Display_Interval.Water", enumValue.ToString())); // ausgewähltes Intervall in MyAppConfig speichern
        if (!success)
        {
            OpenDialog("Wasser-Anbieter nicht gespeichert!", "60px", "380px", false);
        }

        // Spinner
        await Task.Delay(200);
        this.spinnerVisibleProperty = false;
    }
    #endregion

    #region GetChartDataDaily
    /// <summary>
    /// Interval täglich: Erzeugen der Chart-Daten
    /// </summary>
    /// <param name="supplier"></param>
    /// <param name="counters"></param>
    public async Task GetChartDataDaily(Water_SupplierModel? supplier, List<Water_CounterModel>? counters)
    {
        DateTimeFormat = "dd.MM.yy";
        if (counters != null && counters.Any())
        {
            IntervalDuration = counters.Count > 10 && counters.Count <= 30 ? IntervalDuration = 7 : IntervalDuration = 1;
            IntervalType = counters.Count > 30 ? IntervalType = IntervalType.Months : IntervalType = IntervalType.Days;
        }
        else
        {
            IntervalDuration = 1;
            IntervalType = IntervalType.Days;
        }

        ChartPointList.Clear();

        List<IConsumption> consumptions = await Task.Run(() => GWS_Calculation.CalcConsumptionDaily(supplier, counterChangeList, counters));

        if (consumptions == null || !consumptions.Any())
        {
            OpenDialog("Keine Wasser-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }
        foreach (var cons in consumptions)
        {
            ChartPointList.Add(new ColumnChartData { Date = cons.Date, Cons_TW_m3 = cons.Consumption, Temp = cons.Temperature });   //lulli: hier fehlt noch die Berechnung vom Abwasser 0.55
        }

        CalcAverageSum();
        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region GetChartDataMonthly
    /// <summary>
    /// Interval monatlich: Erzeugen der Chart-Daten
    /// </summary>
    /// <param name="supplier"></param>
    /// <param name="counters"></param>
    public async Task GetChartDataMonthly(Water_SupplierModel? supplier, List<Water_CounterModel>? counters)
    {
        IntervalDuration = 1;
        IntervalType = IntervalType.Months;
        DateTimeFormat = "MMM yy";
        ChartPointList.Clear();

        List<IConsumption> consumptionsMonthly = await Task.Run(() => GWS_Calculation.CalcConsumptionMonthly(supplier, counterChangeList, counters)); // dann monatlichen Verbrauch berechnen

        if (consumptionsMonthly == null || !consumptionsMonthly.Any())
        {
            OpenDialog("Keine Wasser-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }
        else
        {
            foreach (var cons in consumptionsMonthly!)
            {
                ChartPointList.Add(new ColumnChartData { Date = cons.Date, Cons_TW_m3 = cons.Consumption, Temp = cons.Temperature });
            }
        }

        CalcAverageSum();
        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region GetChartDataYearly
    /// <summary>
    /// Interval jährlich: Erzeugen der Chart-Daten
    /// </summary>
    /// <param name="supplier"></param>
    /// <param name="counters"></param>
    public async Task GetChartDataYearly(List<Water_SupplierModel>? suppliers)
    {
        IntervalDuration = 1;
        IntervalType = IntervalType.Months; // Achtung: hier muss Days stehen sonst werden gleiche Monatszeiträume auf X-Achse nicht angezeigt
        DateTimeFormat = "yyyy";
        ChartPointList.Clear();

        if (suppliers == null || !suppliers.Any())
        {
            OpenDialog("Wasser-Anbieter nicht vorhanden", "60px", "380px", false);
            return;
        }
        StartDateYearly = DateTime.MaxValue;
        EndDateYearly = DateTime.MinValue;
        foreach (Water_SupplierModel supplier in suppliers!)
        {
            if (supplier.Zeitraum_Start != null && supplier.Zeitraum_Ende != null)
            {
                if (supplier.Zeitraum_Ende < DateTime.Now)
                {
                    StartDateYearly = supplier.Zeitraum_Start < StartDateYearly ? supplier.Zeitraum_Start : StartDateYearly;
                    EndDateYearly = supplier.Zeitraum_Ende > EndDateYearly ? supplier.Zeitraum_Ende : EndDateYearly;
                }
            }
        }

        List<IConsumption> consumptionsYearly = await Task.Run(() => GWS_Calculation.CalcConsumptionYearly(suppliers, counterChangeList)); // dann monatlichen Verbrauch berechnen
        // if (consumptionsYearly.Count == 0)
        if (consumptionsYearly == null || !consumptionsYearly.Any())
        {
            OpenDialog("Keine Wasser-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }
        foreach (var cons in consumptionsYearly!)
        {
            ChartPointList.Add(new ColumnChartData { Date = cons.Date, Cons_TW_m3 = cons.Consumption, Temp = 0.0d });
        }

        CalcAverageSum();
        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region SelectChartData
    /// <summary>
    /// Auswählen der Chartdaten abhängig vom Intervall
    /// </summary>
    /// <param name="interval"></param>
    public async Task SelectChartData(Interval interval)
    {
        switch (interval)
        {
            case Interval.täglich:
                {
                    await GetChartDataDaily(supplierData, counterList);
                    break;
                }
            case Interval.monatlich:
                {
                    await GetChartDataMonthly(supplierData, counterList);
                    break;
                }
            case Interval.jährlich:
                {
                    counterChangeList = await gwsP!.LoadDataAsync<Water_CounterChangeModel>(urlCounterChangeAllSuppliers); // Zählerwechsel aller Anbieter laden
                    await GetChartDataYearly(supplierList);
                    break;
                }
            default:
                {
                    await GetChartDataDaily(supplierData, counterList);
                    break;
                }
        }
    }
    #endregion

    #region CalcAverageSum
    /// <summary>
    /// Berechnen Durchschnitt/Summe/Min/Max
    /// </summary>
    public void CalcAverageSum()
    {
        ConsAverage_TW_m3 = Math.Round(ChartPointList.Average(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        ConsSum_TW_m3 = Math.Round(ChartPointList.Sum(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        ConsAverage_TW_m3 = Math.Round(ChartPointList.Average(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        ConsSum_TW_m3 = Math.Round(ChartPointList.Sum(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        ConsMin_TW_m3 = Math.Round(ChartPointList.Min(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        ConsMax_TW_m3 = Math.Round(ChartPointList.Max(x => x.Cons_TW_m3).GetValueOrDefault(), 2);
        TempAverage = Math.Round(ChartPointList.Average(x => x.Temp).GetValueOrDefault(), 2);
    }
    #endregion

    #region GetMockChartData
    /// <summary>
    /// Auslesen der Mock-Daten
    /// </summary>
    /// <param name="data"></param>
    /// <param name="startPeriod"></param>
    /// <param name="endPeriod"></param>
    public void GetMockChartData(DateTime? startPeriod, DateTime? endPeriod)
    {
        const int days = 364;
        double? consumption = 0.0d;
        double? temperature = 0.0d;
        Random randomConsumption = new Random();
        Random randomTemperature = new Random();
        DateTime dayToday = DateTime.Now;

        DateTime newDate = startPeriod ?? new DateTime(1970, 1, 1);

        ChartPointList.Clear();

        for (int i = 0; i < days; i++)
        {
            consumption = randomConsumption.Next(0, 10);
            temperature = randomTemperature.Next(-10, 30);

            ChartPointList.Add(new ColumnChartData { Date = newDate, Cons_TW_m3 = consumption, Temp = temperature });

            newDate = newDate.AddDays(1);
            if (newDate > dayToday)
            {
                break;
            }
        }
        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region GetChartMinMaxRange
    /// <summary>
    /// Berechnen Chart Min/Max-Range
    /// </summary>
    public void GetChartMinMaxRange(List<ColumnChartData> chartList)
    {
        double maxValue = 0;

        if (chartList != null && chartList.Any())
        {
            // Y-Achse Verbrauch
            maxValue = ChartPointList.Max(x => x.Cons_TW_m3).GetValueOrDefault();
            MaxRangeCons = maxValue + maxValue / 20; // + 5%
            Interval_YAxis = MaxRangeCons / 4;

            switch (DdlInterval)
            {
                case Interval.jährlich:
                    labelFormat = "N0";
                    break;

                case Interval.monatlich:
                    labelFormat = "N1";
                    break;

                default:
                    labelFormat = "N1";
                    break;
            }

            // Y-Achse Temperatur
            if (DdlInterval != Interval.jährlich)
            {
                MinRangeTemp = Math.Round(ChartPointList.Min(t => t.Temp).GetValueOrDefault(), 0);
                MaxRangeTemp = Math.Round(ChartPointList.Max(t => t.Temp).GetValueOrDefault(), 0) + 2;
            }
           

            return;
        }

        MinRangeCons = 0;
        MaxRangeCons = 0;
        MinRangeTemp = 0;
        MaxRangeTemp = 0;
    }
    #endregion

