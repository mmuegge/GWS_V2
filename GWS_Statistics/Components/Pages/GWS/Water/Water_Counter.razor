@page "/water_counter"

@* @rendermode InteractiveServer *@
@* @attribute [StreamRendering] *@

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Globalization
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Water_SupplierModel> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService

<PageTitle>Wasser- Zählerstände</PageTitle>

@* Seiten-Überschrift *@
<div class="container">
        <div class="text-center fs-3 fw-bold">
            <span class="fa-solid fa-faucet-drip fa-3xs" aria-hidden="true"> </span>
            <label>Wasser- Zählerstände</label>
        </div>
</div>

@* Auswahl Anbieter *@
<div class="card shadow-lg p-2 mb-1">
    @* <- p-2 für den Abstand zum Schatten hinzugefügt *@
    @* Auswahl Anbieter und Anzeigen Start-Datum/Ende-Datum*@
    @* container-fluid --> Breite = 100% *@
    <div class="container-fluid bg-color-grey pb-2 border">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    <SfDropDownList DataSource="@supplierList" TItem="Water_SupplierDataModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData!.Id">
                        <DropDownListFieldSettings Text="Anbieter" Value="Id"></DropDownListFieldSettings>
                        <DropDownListEvents TItem="Water_SupplierDataModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                    </SfDropDownList>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@StartDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@EndDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>
</div>

@* Grid *@
@if (counterList != null && counterList.Count > 0)
{
    <div class="control-section" id="target" align="left">
        <SfGrid ID="Grid" @ref="sfDataGrid" DataSource="@counterList"
        AllowPaging="true"
        AllowFiltering="true"
        AllowReordering="true"
        AllowResizing="true"
        AllowExcelExport="true"
        AllowPdfExport="true"
        EnableHover="true"
        AllowTextWrap="true"
        AllowSelection="true"
        AllowSorting="true"
        Height="100%" Width="100%"
        Toolbar=@toolbar
        EnableStickyHeader="true">

            <GridEditSettings AllowAdding="true"
                AllowEditing="true"
                AllowDeleting="true"
                ShowDeleteConfirmDialog="true"
                Mode="EditMode.Dialog"
                Dialog="DialogParams">

                <HeaderTemplate>
                @{
                        var DialogHeader = GetDialogHeader((context as Water_CounterModel));
                        <span>@DialogHeader</span>
                    }
                </HeaderTemplate>
            </GridEditSettings>

            <GridEvents OnToolbarClick="ToolbarBtnClickHandler"
            RowCreating="RowCreatingHandler"
            RowEditing="RowEditingHandler"
            OnActionComplete="ActionCompleteHandler"
            TValue="Water_CounterModel">
            </GridEvents>

            <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn 
                    Field="Ablesetag" 
                    Direction="SortDirection.Descending">
                    </GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>

            <GridColumns>
                <GridColumn IsPrimaryKey="true" Field="@nameof(Water_CounterModel.ID_Tag)" Visible="false"
                AllowAdding="false"
                AllowEditing="false"
                AllowSorting="false"
                AllowFiltering="false"
                Width="35">
                </GridColumn>

                <GridColumn Field=@nameof(Water_CounterModel.Anbieter)
                Width="200"
                EditType="EditType.DropDownEdit"
                HeaderText=" Anbieter">

                    <EditTemplate>
                        <SfDropDownList Placeholder="Anbieter"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="int?" 
                        TItem="Water_SupplierDataModel"
                        DataSource="@supplierList" 
                        @bind-Value="@DropDownValueSupplier">

                            <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Anbieter")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Anbieter</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Water_CounterModel.Ablesetag)
                EditType="EditType.DatePickerEdit"
                Type="ColumnType.DateTime"
                Width="110"
                DefaultValue="DateTime.Now"
                HeaderText="Datum"
                Format="d">

                    <EditTemplate>
                        <SfDatePicker
                        Placeholder="Ablesetag"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="DateTime"
                        @bind-Value="@((context as Water_CounterModel)!.Ablesetag)">

                            @* <DatePickerEvents TValue="DateTime" ValueChange="DayChangedHandler"></DatePickerEvents> *@
                        </SfDatePicker>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Datum")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Datum</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Water_CounterModel.Uhrzeit)
                Format="HH:mm"
                Type="Syncfusion.Blazor.Grids.ColumnType.DateTime"
                Width="110"
                DefaultValue="DateTime.Now"
                HeaderText="Uhrzeit">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Uhrzeit")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Uhrzeit</b></span>
                        </SfTooltip>
                    </HeaderTemplate>

                    <EditTemplate>
                        <SfTimePicker Placeholder="Uhrzeit"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="DateTime?"
                        @bind-Value="@((context as Water_CounterModel)!.Uhrzeit)"
                        Format="HH:mm"
                        CssClass="customdatecss"
                        ShowClearButton="true">
                        </SfTimePicker>
                    </EditTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Water_CounterModel.Zaehlerstand)
                Format="0.#### m³"
                Width="125"
                HeaderText="Zählerstand Hauptzähler">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Zählerstand Hauptzähler"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="Double?"
                        @bind-Value="@((context as Water_CounterModel)!.Zaehlerstand)"
                        Format="0.#### m³">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("ZS-H")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>ZS-H</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Water_CounterModel.Zaehlerstand_aussen)
                Format="0.### m³"
                Width="125"
                HeaderText="Zählerstand Nebenzähler">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Zählerstand Nebenzähler"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="Double?"
                        @bind-Value="@((context as Water_CounterModel)!.Zaehlerstand_aussen)"
                        Format="0.### m³">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("ZS-N")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>ZS-N</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Water_CounterModel.Temperatur_aussen)
                Format="0 °C"
                Width="110"
                HeaderText="Temperatur aussen">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Temperatur aussen"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="double?"
                        @bind-Value="@temperatureOutside"
                        Format="0 °C">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("T-a")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>T-a</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Water_CounterModel.Temperatur_innen)
                Format="0 °C"
                Width="110"
                HeaderText="Temperatur innen">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Temperatur innen"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="double?"
                        @bind-Value="@temperatureInside"
                        Format="0 °C">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("T-i")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>T-i</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Water_CounterModel.Bemerkungen)
                Width="300"
                HeaderText="Bemerkung">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Bemerkung")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Bemerkung</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                    <GridCommandColumns>
                        <GridCommandColumn Type="CommandButtonType.Edit"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Delete"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Save"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Cancel"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                    </GridCommandColumns>
                </GridColumn>
            </GridColumns>
        </SfGrid>

        @* Spinner für den Export *@
        <SfSpinner Visible="@IsExporting"
                   Label="Datei wird generiert, bitte warten..."
                   Type="@SpinnerType.Material"
                   Size="40"
                   CssClass="e-spin-overlay e-custom-color">
        </SfSpinner>
    </div>
}
else
{
    <SfSpinner @bind-Visible="@spinnerVisibleProperty" 
               Type="SpinnerType.Tailwind"  
               CssClass="e-custom-color"
               Label="Lade Daten..."
               Size="40">
    </SfSpinner>
    
}


@* Dialog*@
<div>
    <SfDialog Target="#target"
                Width="@dialogWidth"
                Height="@dialogHeight"
                AllowDragging="true"
                ShowCloseIcon=" true"
                AllowPrerender="true"
                IsModal="true"
                CssClass="MyCss"
                @bind-Visible="@DialogVisible">

        <DialogTemplates>
            <Header>@header</Header>
        </DialogTemplates>

        <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>

        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

        @if (showDialogButtons)
        {
            <DialogButtons>
                <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
            </DialogButtons>
        }
    </SfDialog>
</div>

<style>
    .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
    }

    /* Dialog Editing*/
    .e-dialog .e-dlg-header-content {
        background-color: grey;
        font-size: 24px;
    }

    .e-dialog .e-dlg-header {
        color: white;
    }

    .e-dialog .e-dlg-content {
        color: white;
        background-color: lightgray;
        font-size: 16px;
    }

    .bg-color-grey {
        background: #deded9;
    }

    #toast_default .e-circle-check::before {
        content: "\e72b";
        font-size: 17px;
    }

    #toast_default .e-circle-close::before {
        content: "\e878";
        font-size: 17px;
    }

    .control-wrapper {
        max-width: 250px;
        min-width: 120px;
        margin: auto;
    }

    .control-label {
        font-size: 14px;
