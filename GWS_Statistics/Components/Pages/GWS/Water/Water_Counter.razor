    #region RowCreatingHandler
    /// <summary>
    /// ein neuer Datebsatz wird angelegt
    /// </summary>
    /// <param name="args"></param>
    public void RowCreatingHandler(RowCreatingEventArgs<Water_CounterModel> args)
    {
        // Best Practice: Sicherer Null-Check
        if (args?.Data is null) return;

        // 1. Anbieter-Daten direkt zuweisen
        if (supplierData != null)
        {
            DropDownValueSupplier = supplierData.Id;
            args.Data.ID_Anbieter = supplierData.Id;

            // Optimierung: Sie nutzen oben bereits supplierData. Wenn dort der Name (Anbieter)
            // bereits enthalten ist, können Sie sich die LINQ-Suche auf supplierList komplett sparen:
            args.Data.Anbieter = supplierData.Anbieter ?? "unbekannt";
        }

        // 2. Datum und Uhrzeit vorbelegen
        args.Data.Ablesetag = DateTime.Today;
        args.Data.Uhrzeit = DateTime.Now;

        // 3. Letzten Eintrag holen und Werte vorbelegen
        var lastCounter = counterList?.LastOrDefault();
        if (lastCounter != null)
        {
            args.Data.Zaehlerstand = lastCounter.Zaehlerstand;
            args.Data.Zaehlerstand_aussen = lastCounter.Zaehlerstand_aussen;
            args.Data.Temperatur_aussen = lastCounter.Temperatur_aussen;
            args.Data.Temperatur_innen = lastCounter.Temperatur_innen;
            args.Data.Bemerkungen = lastCounter.Bemerkungen;

            // Optimierung: Redundanten Null-Check (?) entfernt, da args.Data oben geprüft wurde.
            // Berücksichtigung Ihres Signalwerts (99) für den Fall, dass die letzte Temperatur NULL war:
            temperatureOutside = args.Data.Temperatur_aussen ?? 99;
            temperatureInside = args.Data.Temperatur_innen ?? 99;
        }
        else
        {
            // Falls die Liste komplett leer ist, Startwerte für die UI-Variablen setzen
            temperatureOutside = 99;
            temperatureInside = 99;
        }
    }
    #endregion

    #region RowEditingHandler
    /// <summary>
    /// Datenzeile wird editiert
    /// </summary>
    /// <param name="args"></param>
    public void RowEditingHandler(RowEditingEventArgs<Water_CounterModel> args)
    {
        // Best Practice: Null-Check für die Argumente und Daten
        if (args?.Data is null) return;

        // Daten aus Dropdown "Anbieter" auslesen und Anbieter-Feld in Grid vorbesetzen
        DropDownValueSupplier = args.Data.ID_Anbieter;

        temperatureOutside = args.Data?.Temperatur_aussen ?? 99;
        temperatureInside = args.Data?.Temperatur_innen ?? 99;
    }
    #endregion
