    public int? DropDownValueSupplier { get; set; } = 0;

    private bool save = false;
    private bool update = false;
    private bool success = false;

    readonly string urlSupplier = "wasser/anbieter/";
    readonly string urlCounterChangeSupplier = "wasser/zaehlerwechsel/anbieter/";
    readonly string urlCounterChange = "wasser/zaehlerwechsel/";

    string? Header { get; set; }
    string? Content { get; set; }

