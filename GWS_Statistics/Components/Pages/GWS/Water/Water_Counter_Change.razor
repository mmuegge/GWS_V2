    };
    #endregion

    #region OnInitializedAsync
    protected override async Task OnInitializedAsync()
    {
        // Spinner
        this.spinnerVisibleProperty = true;

        // MyAppSettings.json auslesen und letzten gespeicherten Anbieter auslesen
        settings = GetSetMyAppConfig.GetMyAppSettings.ReadSettings(myAppSettings);

        gwsP = new GWSProcessor(myHttpClient, settings!.GWSUri);
        try
        {
            // Anbieterdaten auslesen (nur Anbieter und Id => durch Water_SupplierDataModel)
            supplierDataList = await gwsP.LoadDataAsync<Water_SupplierDataModel>(urlSupplier);

            if (supplierDataList != null && supplierDataList.Any()) // prüfen ob es Anbieterdaten gibt
            {
                // gespeicherten letzten Anbieter auslesen
                supplierData!.Id = String.IsNullOrEmpty(settings.Supplier_Id!.Water) ? supplierData.Id = supplierDataList.Max(x => x.Id) : supplierData.Id = Int32.Parse(settings.Supplier_Id.Water);
                // Anbieter Start-Datum auslesen

                startDate = supplierDataList
                .Where(c => c.Id == supplierData.Id)
                .Select(c => c.Zeitraum_Start).FirstOrDefault();

                // Anbieter Ende-Datum auslesen
                endDate = supplierDataList
               .Where(c => c.Id == supplierData.Id)
               .Select(c => c.Zeitraum_Ende).FirstOrDefault();
            }
            else
            {
                // es gibt keine gültigen Daten der Anbieter
                supplierData!.Id = 0;
            }

            if (supplierData.Id > 0)
            {
                // Zählerwechsel anbieterabhängig auslesen
                counterChangeList = await gwsP.LoadDataAsync<Water_CounterChangeModel>(urlCounterChangeSupplier + Convert.ToString(supplierData.Id));
                if (counterChangeList == null || !counterChangeList.Any())
                {
                    OpenDialog("Keine Wasser-Zählerwechsel vorhanden!", "60px", "380px", false);
                }
            }

        }
        catch (Exception)
        {
            throw new Exception("Es konnten keine Zählerwechsel geladen werden");
        }

        // Spinner
        await Task.Delay(200);
        this.spinnerVisibleProperty = false;
    }
    #endregion

    #region ValueSelectHandler
    /// <summary>
    /// Auslesen Ablesetage des neuen ausgewählten Anbieters
    /// </summary>
    /// <param name="args"></param>
    private async Task ValueSelectHandler(SelectEventArgs<Water_SupplierDataModel> args)
    {
        supplierData = args.ItemData;

        if (supplierData.Id > 0)
        {
            // Spinner
            this.spinnerVisibleProperty = true;

            success = GetSetMyAppConfig.SetMyAppSettings.WriteSettings(myAppSettings, "Supplier_Id.Water", supplierData.Id.ToString());

            // Start-Zeitpunkt/Ende-Zeitpunkt auslesen
            startDate = args.ItemData.Zeitraum_Start;
            endDate = args.ItemData.Zeitraum_Ende;

            counterChangeList = await gwsP!.LoadDataAsync<Water_CounterChangeModel>(urlCounterChangeSupplier + Convert.ToString(supplierData.Id)); // Daten des neu ausgewählten Anbieter laden
            if (counterChangeList == null || !counterChangeList.Any())
            {
                OpenDialog("Keine Wasser-Zählerwechsel vorhanden!", "60px", "380px", false);
            }
            SfDataGrid?.Refresh();

            // Spinner
            await Task.Delay(200);
            this.spinnerVisibleProperty = false;
        }
    }
    #endregion

    #region ToolbarBtnClickHandler
    /// <summary>
    /// ToolbarBtnClickHandler
    ///
    /// </summary>
    /// <param name="args"></param>
    public async Task ToolbarBtnClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Id.Contains("_excelexport"))
        {
            ExcelExportProperties excelExportProperties = new();
            excelExportProperties.FileName = $"Wasserzaehler_{DateTime.Now.ToString("ddMMyyyy")}.xlsx";

            ExcelTheme Theme = new ExcelTheme();
            // Header
            ExcelStyle ThemeStyleHeader = new ExcelStyle()
                {
                    FontName = "Calibri",
                    FontSize = 12,
                    Bold = true,
                };
            Theme.Header = ThemeStyleHeader;
            // Data
            ExcelStyle ThemeStyleRecord = new ExcelStyle()
                {
                    FontName = "Calibri",
                    FontSize = 10,
                    Bold = false,
                };
            Theme.Record = ThemeStyleRecord;

            excelExportProperties.Theme = Theme;

            await SfDataGrid.ExportToExcelAsync(excelExportProperties);
        }
        else if (args.Item.Id.Contains("_pdfexport"))
        {
            PdfExportProperties pdfExportProperties = new();
            pdfExportProperties.IsRepeatHeader = true;
            pdfExportProperties.FileName = $"Wasseranbieter_{DateTime.Now.ToString("ddMMyyyy")}.pdf";
            pdfExportProperties.PageOrientation = Syncfusion.Blazor.Grids.PageOrientation.Landscape;

            PdfHeader pdfHeader = new()
                {
                    FromTop = 0,
                    Height = 80,
                    Contents = HeaderContent
                };

            PdfFooter pdfFooter = new()
                {
                    FromBottom = 0,
                    Height = 80,
                    Contents = FooterContent
                };

            PdfTheme Theme = new PdfTheme();

            PdfThemeStyle HeaderThemeStyle = new PdfThemeStyle()
                {
                    FontColor = "Blue",
                    FontName = "Calibri",
                    FontSize = 8,
                    Bold = true,
                };
            Theme.Header = HeaderThemeStyle;

            pdfExportProperties.Theme = Theme;

            pdfExportProperties.Header = pdfHeader;
            pdfExportProperties.Footer = pdfFooter;

            await SfDataGrid.ExportToPdfAsync(pdfExportProperties);
        }
        else if (args.Item.Id.Contains("XmlExport"))
        {
            Console.Write("Export to Xml function");        // wird nicht genutzt
        }
    }
    #endregion

    // #region ActionBeginHandler
    // /// <summary>
    // /// ActionBeginHandler
    // /// </summary>
    // /// <param name="args"></param>
    // public void ActionBeginHandler(ActionEventArgs<Water_CounterChangeModel> args)
