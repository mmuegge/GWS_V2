    //         if (!args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
    //         {
    //             // Add
    //             if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Add))
    //             {
    //                 // Daten aus Dropdown "Anbieter" auslesen und Anbieter-Feld in Grip vorbesetzen
    //                 args.Data.Id_Anbieter = supplierData!.Id;
    //                 args.Data.Anbieter = supplierDataList?
    //                                           .Where(x => x.Id == supplierData.Id)
    //                                           .Select(a => a.Anbieter)
    //                                           .FirstOrDefault();

    //             }
    //             else if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.BeginEdit))
    //             {
    //                 DropDownValueSupplier = args.Data.Id_Anbieter;
    //             }
    //         }
    //     }
    // }
    // #endregion

    #region ActionCompleteHandler
    /// <summary>
    /// ActionCompleteHandler
    /// </summary>
    /// <param name="args"></param>
    public async Task ActionCompleteHandler(ActionEventArgs<Water_CounterChangeModel> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
        {
            if (args.Action == "Add")
            {
                save = true;
                counterChangeData = args.Data;

                OpenDialog("Datensatz speichern ?", "130px", "220px", true);
            }
            else if (args.Action == "Edit")
            {
                update = true;
                counterChangeData = args.Data;

                OpenDialog("Datensatz ändern ?", "130px", "220px", true);
            }
        }
        else if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            if (args.Data.Id == 0)
            {
                counterChangeList = await gwsP!.LoadDataAsync<Water_CounterChangeModel>(urlCounterChangeSupplier + Convert.ToString(supplierData!.Id));
            }
            else
            {
                counterChangeData = await gwsP!.DeleteDataAsync<Water_CounterChangeModel>(urlCounterChange, Convert.ToString(args.Data.Id));  // Zählerwechsel löschen
                ShowToastMessage(true, "Datensatz gelöscht!");
            }
            SfDataGrid?.Refresh();
        }
    }
    #endregion

    #region CancelClick
    /// <summary>
    /// CancelClick
    /// </summary>
    ///
    private async Task CancelClick()
    {
        DialogVisible = false;
        // Zählerwechsel anbieterabhängig auslesen
        counterChangeList = await gwsP!.LoadDataAsync<Water_CounterChangeModel>(urlCounterChangeSupplier + Convert.ToString(supplierData!.Id));
        SfDataGrid?.Refresh();
    }
    #endregion

    #region YesClick
    /// <summary>
    /// YesClick
    /// </summary>
    ///
    private async Task YesClick()
    {
        DialogVisible = false;

        if (save) // Datensatz speichern
        {
            if (counterChangeData != null)
            {
                save = false;

                apiResponse = await gwsP!.PostDataAsync<Water_CounterChangeModel>(urlCounterChange, counterChangeData);

                if (apiResponse.MyHttpStatusCode == HttpStatusCode.Created)
                {
                    ShowToastMessage(true, "Datensatz gespeichert (created)!");
                    counterChangeList = await gwsP!.LoadDataAsync<Water_CounterChangeModel>(urlCounterChangeSupplier + Convert.ToString(supplierData!.Id));
                }
                else
                {
                    ShowToastMessage(false, "Datensatz nicht gespeichert!");
                }
            }
        }
        else if (update) // Datensatz updaten
        {
            update = false;

            if (counterChangeData != null)
            {
                string url = urlCounterChange + Convert.ToString(counterChangeData.Id);

                apiResponse = await gwsP!.UpdateDataAsync<Water_CounterChangeModel>(url, counterChangeData);  // Put
                ShowToastMessage(true, "Datensatz aktualisiert!");
                counterChangeList = await gwsP!.LoadDataAsync<Water_CounterChangeModel>(urlCounterChangeSupplier + Convert.ToString(supplierData!.Id));
            }
        }
        SfDataGrid?.Refresh();
    }
    #endregion

    #region ShowToastMessage
    /// <summary>
    /// ShowToastMessage
    /// </summary>
    /// <param name="success"></param>
    /// <param name="message"></param>
    /// <returns></returns>
    private void ShowToastMessage(bool success, string message)
    {
        if (success)
        {
            ShowToast("Erfolg", message, "e-toast-success", "e-circle-check");
        }
        else
        {
            ShowToast("Fehler", message, "e-toast-danger", "e-circle-close");
        }
    }
    #endregion

    #region ShowToast
    /// <summary>
    /// ShowToast
    /// </summary>
    /// <param name="title"></param>
    /// <param name="content"></param>
    /// <param name="cssClass"></param>
    /// <param name="icon"></param>
    private void ShowToast(string title, string content, string cssClass, string icon)
    {
        this.ToastService.Open(new ToastOption()
            {
                Title = title,
                Content = content,
                CssClass = cssClass,
                Icon = icon,
            });
    }
    #endregion

    #region GetTooltipContent
    /// <summary>
    /// GetTooltipContent
    /// </summary>
    /// <param name="headerText"></param>
    /// <returns></returns>
    public string GetTooltipContent(string headerText)
    {
        return ColumnDescriptions.ContainsKey(headerText) ? ColumnDescriptions[headerText] : "No description available.";
    }
    #endregion

    #region OpenDialog
    /// <summary>
    /// OpenDialog
    /// </summary>
    private void OpenDialog(string header, string height, string width, bool showButtons)
    {
        Header = header;
        dialogHeight = height;
        dialogWidth = width;
        showDialogButtons = showButtons;
        this.DialogVisible = true;
    }
    #endregion

    #region GetDialogHeader
    /// <summary>
    /// GetDialogHeader
    /// </summary>
    /// <param name="counterChange"></param>
    /// <returns></returns>
    public string GetDialogHeader(Water_CounterChangeModel? counterChange)
    {
        if (counterChange != null)
        {
            return counterChange.Id == 0
                ? "Zählerwechsel: neuer Zählerwechsel"
                : "Zählerwechsel: " + counterChange.Wechsel_Datum.ToString("dd.MM.yyyy");
        }
        else
        {
            return "Kein Zählerwechsel vorhanden!";
        }
    }
    #endregion

    #region RowCreatingHandler
    /// <summary>
    /// ein neuer Datebsatz wird angelegt
    /// </summary>
    /// <param name="args"></param>
    public void RowCreatingHandler(RowCreatingEventArgs<Water_CounterChangeModel> args)
    {
        // Daten aus Dropdown "Anbieter" auslesen und Anbieter-Feld in Grip vorbesetzen
        args.Data.Id_Anbieter = supplierData!.Id;
        args.Data.Anbieter = supplierDataList?
                                    .Where(x => x.Id == supplierData.Id)
                                    .Select(a => a.Anbieter)
                                    .FirstOrDefault();
    }
    #endregion

