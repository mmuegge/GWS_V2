@page "/water_counter_change"
@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Globalization
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Water_CounterChangeModel> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService

<PageTitle>Wasser- Zählerwechsel</PageTitle>

<div class="container">
    <div class="row">
        <div class="text-center fs-3 fw-bold">
            <span class="fa-solid fa-plug fa-3xs" aria-hidden="true"> </span>
            <label>Wasser- Zählerwechsel</label>
        </div>
        @* <span class="border-bottom border-dark mb-1"></span> *@
    </div>
</div>

@* Auswahl Anbieter*@
<div class="card shadow-lg mb-1">
    <div class="container bg-color-grey mb-3 mt-2 pb-4 border">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    <SfDropDownList DataSource="@supplierDataList" TItem="Water_SupplierDataModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData!.Id">
                        <DropDownListFieldSettings Text="Anbieter" Value="Id"></DropDownListFieldSettings>
                        <DropDownListEvents TItem="Water_SupplierDataModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                    </SfDropDownList>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@startDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@endDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>
</div>

@* Grid *@
<div class="control-section" id="target" align="left">
    <SfGrid ID="Grid" @ref="SfDataGrid" DataSource="@counterChangeList"
    AllowPaging="true"
    AllowFiltering="true"
    AllowReordering="true"
    AllowResizing="true"
    AllowExcelExport="true"
    AllowPdfExport="true"
    EnableHover="true"
    AllowTextWrap="true"
    AllowSelection="true"
    AllowSorting="true"
    Height="100%" Width="100%"
    Toolbar=@toolbar
    EnableStickyHeader="true">

        <GridEditSettings AllowAdding="true"
        AllowEditing="true"
        AllowDeleting="true"
        ShowDeleteConfirmDialog="true"
        Mode="Syncfusion.Blazor.Grids.EditMode.Dialog"
        Dialog="DialogParams">

            <HeaderTemplate>
                @{
                    var DialogHeader = GetDialogHeader((context as Water_CounterChangeModel));
                    <span>@DialogHeader</span>
                }
            </HeaderTemplate>
        </GridEditSettings>

        <GridEvents OnToolbarClick="ToolbarBtnClickHandler"
                    RowCreating="RowCreatingHandler"
                    RowEditing="RowEditingHandler"
                    OnActionComplete="ActionCompleteHandler"
                    TValue="Water_CounterChangeModel">
        </GridEvents>

        <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>

        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

        <GridSortSettings>
            <GridSortColumns>
                <GridSortColumn 
                    Field="Wechsel_Datum" 
                    Direction="SortDirection.Descending">
                </GridSortColumn>
            </GridSortColumns>
        </GridSortSettings>

        <GridColumns>
            <GridColumn IsPrimaryKey="true" Field="@nameof(Water_CounterChangeModel.Id)" Visible="false"
            AllowAdding="false"
            AllowEditing="false"
            AllowSorting="false"
            AllowFiltering="false"
            Width="35">
            </GridColumn>

            <GridColumn Field=@nameof(Water_CounterChangeModel.Anbieter)
            Width="200"
            EditType="EditType.DropDownEdit"
            HeaderText="Anbieter">

                <EditTemplate>
                    <SfDropDownList Placeholder="Anbieter"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="int?"
                    TItem="Water_SupplierDataModel"
                    DataSource="@supplierDataList"
                    @bind-Value="@DropDownValueSupplier">

                        <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                    </SfDropDownList>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Anbieter")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Anbieter</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Water_CounterChangeModel.Wechsel_Datum)
            Format="d"
            EditType="EditType.DatePickerEdit"
            Width="110"
            DefaultValue="DateTime.Now"
            HeaderText="Datum">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Datum")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Datum</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Water_CounterChangeModel.Zaehlerstand_alt)
            Format="0.#### m³"
            Width="110"
            HeaderText="Wasser Hauptzähler alt">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Wasser Hauptzähler alt"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="Double?"
                    @bind-Value="@((context as Water_CounterChangeModel)!.Zaehlerstand_alt)"
                    Format="0.#### m³">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("ZS-H-alt")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>ZS-H alt</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Water_CounterChangeModel.Zaehlerstand_neu)
            Format="0.### m³"
            Width="110"
            HeaderText="Wasser Hauptzähler neu">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Wasser Hauptzähler neu"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="Double?"
                    @bind-Value="@((context as Water_CounterChangeModel)!.Zaehlerstand_neu)"
                    Format="0.#### m³">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("ZS-H-neu")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>ZS-H neu</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

              <GridColumn Field=@nameof(Water_CounterChangeModel.Zaehlerstand_aussen_alt)
            Format="0.#### m³"
            Width="110"
            HeaderText="Wasser Nebenzähler alt">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Wasser Nebenzähler alt"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="Double?"
                    @bind-Value="@((context as Water_CounterChangeModel)!.Zaehlerstand_aussen_alt)"
                    Format="0.#### m³">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("ZS-N-alt")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>ZS-N alt</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

             <GridColumn Field=@nameof(Water_CounterChangeModel.Zaehlerstand_aussen_neu)
            Format="0.#### m³"
            Width="110"
            HeaderText="Wasser Nebenzähler neu">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Wasser Nebenzähler neu"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="Double?"
                    @bind-Value="@((context as Water_CounterChangeModel)!.Zaehlerstand_aussen_neu)"
                    Format="0.#### m³">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("ZS-N-neu")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>ZS-N neu</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Water_CounterChangeModel.Bemerkung)
            Width="300"
            HeaderText="Bemerkung">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Bemerkung")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Bemerkung</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                <GridCommandColumns>
                    <GridCommandColumn Type="CommandButtonType.Edit"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Delete"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Save"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Cancel"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                </GridCommandColumns>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfSpinner @bind-Visible="@spinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

@* Dialog*@
<div>
    <SfDialog Target="#target"
              Width="@dialogWidth"
              Height="@dialogHeight"
              AllowDragging="true"
              ShowCloseIcon="true"
              @bind-Visible="@DialogVisible"
              AllowPrerender="true"
              IsModal="true" 
              CssClass="MyCss">

        <DialogTemplates>
            <Header>@Header</Header>
        </DialogTemplates>

        <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>
        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

        @if (showDialogButtons)
        {
            <DialogButtons>
                <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
            </DialogButtons>
        }
    </SfDialog>
</div>

<style>
    .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
    }

    /* Dialog Editing*/
    .e-dialog .e-dlg-header-content {
        background-color: grey;
        font-size: 24px;
    }

    .e-dialog .e-dlg-header {
        color: white;
    }

    .e-dialog .e-dlg-content {
        color: white;
        background-color: lightgray;
        font-size: 16px;
    }

    .bg-color-grey {
        background: #deded9;
    }

    #toast_default .e-circle-check::before {
        content: "\e72b";
        font-size: 17px;
    }

    #toast_default .e-circle-close::before {
        content: "\e878";
        font-size: 17px;
    }

    .control-wrapper {
        max-width: 250px;
        min-width: 80px;
        margin: 0 auto;
    }

    .control-label {
        font-size: 14px;
        margin: 6px 0px;
    }

    /* Dialog: Datensatz ändern/löschen */
    .MyCss .e-dlg-header-content {
        background-color: red;
    }
</style>

@code 
{
    #region Variablendeklaration
    bool spinnerVisibleProperty { get; set; } = false;

    private DialogSettings DialogParams = new DialogSettings { MinHeight = "400px", Width = "450px" };
    public DialogEffect animationEffect = DialogEffect.Zoom;
    public bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string DialogText { get; set; } = string.Empty;
