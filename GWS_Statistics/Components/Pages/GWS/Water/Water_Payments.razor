    #region OnInitializedAsync
    protected override async Task OnInitializedAsync()
    {
        // Spinner anzeigen bis Daten ausgelesen wurden
        this.spinnerVisibleProperty = true;

        // MyAppSettings.json auslesen und letzten gespeicherten Anbieter auslesen
        settings = GetSetMyAppConfig.GetMyAppSettings.ReadSettings(myAppSettings)!;

        gwsP = new GWSProcessor(myHttpClient, settings.GWSUri);
        try
        {
            // Anbieterdaten auslesen (nur Anbieter und Id => durch Water_SupplierDataModel)
            supplierDataList = await gwsP.LoadDataAsync<Water_SupplierDataModel>(urlSupplier);

            if (supplierDataList != null && supplierDataList.Any()) // prüfen ob es Anbieterdaten gibt
            {
                // gespeicherten letzten Anbieter auslesen
                supplierData.Id = String.IsNullOrEmpty(settings.Supplier_Id!.Water) ? supplierData.Id = supplierDataList.Max(x => x.Id) : supplierData.Id = Int32.Parse(settings.Supplier_Id.Water);
                // Anbieter Start-Datum auslesen

                startDate = supplierDataList
                .Where(c => c.Id == supplierData.Id)
                .Select(c => c.Zeitraum_Start).FirstOrDefault();

                // Anbieter Ende-Datum auslesen
                endDate = supplierDataList
               .Where(c => c.Id == supplierData.Id)
               .Select(c => c.Zeitraum_Ende).FirstOrDefault();
            }
            else
            {
                // es gibt keine gültigen Daten der Anbieter
                supplierData.Id = 0;
            }

            if (supplierData.Id > 0)
            {
                // Zahlungen anbieterabhängig auslesen
                paymentList = await gwsP.LoadDataAsync<GWS_PaymentModel>(urlPaymentsSupplier + Convert.ToString(supplierData.Id));
                if (paymentList == null || !paymentList.Any())
                {
                    OpenDialog("Keine Wasser-Zahlungen vorhanden!", "60px", "380px", false);
                }
            }

            // Zahlungsarten laden
            paymentsMethodList = await gwsP.LoadDataAsync<GWS_PaymentsMethodModel>(urlPaymentsMethod);
        }
        catch (Exception)
        {
            throw new Exception("Es konnten keine Wasser-Zahlungen geladen werden");
        }

        #region Spinner
        await Task.Delay(200);
        this.spinnerVisibleProperty = false;
        #endregion

    }
    #endregion

    #region ValueSelectHandler
    /// <summary>
    /// Auslesen Ablesetage des neuen ausgewählten Anbieters
    /// </summary>
    /// <param name="args"></param>
    private async Task ValueSelectHandler(SelectEventArgs<Water_SupplierDataModel> args)
    {
        supplierData = args.ItemData;

        if (supplierData.Id > 0)
        {
            // Spinner
            this.spinnerVisibleProperty = true;
            success = GetSetMyAppConfig.SetMyAppSettings.WriteSettings(myAppSettings, "Supplier_Id.Water", supplierData.Id.ToString());

            // Start-Zeitpunkt/Ende-Zeitpunkt auslesen
            startDate = args.ItemData.Zeitraum_Start;
            endDate = args.ItemData.Zeitraum_Ende;

            paymentList = await gwsP!.LoadDataAsync<GWS_PaymentModel>(urlPaymentsSupplier + Convert.ToString(supplierData.Id)); // Daten des neu ausgewählten Anbieter laden
            if (paymentList == null || !paymentList.Any())
            {
                OpenDialog("Keine Wasser-Zahlungen vorhanden!", "60px", "380px", false);
            }
            SfDataGrid?.Refresh();

            // Spinner
            await Task.Delay(200);
            this.spinnerVisibleProperty = false;
        }
    }
    #endregion

