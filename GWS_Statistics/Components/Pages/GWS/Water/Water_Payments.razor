    #region ActionCompleteHandler
    /// <summary>
    /// ActionCompleteHandler
    /// </summary>
    /// <param name="args"></param>
    public async Task ActionCompleteHandler(ActionEventArgs<GWS_PaymentModel> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
        {
            if (args.Action == "Add")
            {
                save = true;
                paymentData = args.Data;

                OpenDialog("Datensatz speichern ?", "130px", "220px", true);
            }
            else if (args.Action == "Edit")
            {
                // prüfen Anbieter geändert wurde (Anbieter-Name passt nicht zur Id_Anbieter??)
                if (DropDownValueSupplier != null && DropDownValueSupplier !=args.Data.ID_Anbieter)
                {
                    string? anbieter = supplierDataList!.Where(id => id.Id == DropDownValueSupplier)
                                                       .Select(name => name.Anbieter).FirstOrDefault();
                    if (anbieter != null)
                    {
                        args.Data.ID_Anbieter = DropDownValueSupplier.GetValueOrDefault();
                        args.Data.Anbieter = anbieter;
                    }
                }

                update = true;
                paymentData = args.Data;
                OpenDialog("Datensatz ändern ?", "130px", "220px", true);
            }
        }
        else if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            if (args.Data.ID_Zahlung == 0)
            {
                paymentList = await gwsP!.LoadDataAsync<GWS_PaymentModel>(urlPaymentsSupplier + Convert.ToString(supplierData.Id));
            }
            else
            {
                paymentData = await gwsP!.DeleteDataAsync<GWS_PaymentModel>(urlPayment, Convert.ToString(args.Data.ID_Zahlung));
                ShowToastMessage(true, "Datensatz gelöscht!");
            }
            SfDataGrid?.Refresh();
        }
    }
