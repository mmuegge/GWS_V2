    #region GetDialogHeader
    /// <summary>
    /// GetDialogHeader
    /// </summary>
    /// <param name="counter"></param>
    /// <returns></returns>
    public string GetDialogHeader(GWS_PaymentModel payment)
    {
        return payment.ID_Zahlung == 0
            ? "Einzahlung: neue Einzahlung"
            : "Einzahlung: " + payment.Datum.ToString("dd.MM.yyyy");
    }
