    #region ClearSumAverage
    /// <summary>
    /// Reset the sum and average values to zero
    /// </summary>
    private void ClearSumAverage()
    {
        sumPayments = 0;
        sumCosts = 0;
        sumBonus = 0;
        sumCredit = 0;
        sumConsumptions = 0;
    }
    #endregion
