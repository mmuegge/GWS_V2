    private string dialogYValue = "center";
    private string dialogHeight = "130px";

    public int? DropDownValueSupplier { get; set; } = 0;

    readonly string urlBoiler = "gas/therme/";

    string? Header { get; set; }
    string? Content { get; set; }

    GWSProcessor? gwsP;
    ApiResponse? apiResponse;

    private SfGrid<Gas_BoilerModel> SfDataGrid = new();

    private List<Gas_BoilerModel>? boilerList = null;
    private Gas_BoilerModel? boilerData = new();

    private List<object> toolbar = new List<object>() { "Add", "Cancel", "Search", "ExcelExport", "PdfExport" };

    public DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    public DateTime MaxDate { get; set; } = new DateTime(DateTime.Now.Year, 12, 31);
    public DateTime DefaultDate { get; set; } = new DateTime(DateTime.Now.Year, 12, 31);

