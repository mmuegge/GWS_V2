    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (firstRender)
    //     {
    //         await JSRuntime.InvokeVoidAsync("bindKeyDownEvent", SfDataGrid.ID, DotNetObjectReference.Create(this));
    //     }
    // }

    #region OnInitializedAsync
    /// <summary>
    /// OnInitializedAsync
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        // Spinner
        this.SpinnerVisibleProperty = true;

        // MyAppSettings.json auslesen und letzten gespeicherten Anbieter auslesen
        settings = GetSetMyAppConfig.GetMyAppSettings.ReadSettings(myAppSettings);

        gwsP = new GWSProcessor(myHttpClient, settings!.GWSUri);
        try
        {
            // Thermedaten auslesen
            boilerList = await gwsP.LoadDataAsync<Gas_BoilerModel>(urlBoiler);

            if (boilerList == null || !boilerList.Any())
            {
                OpenDialog("Keine Thermedaten vorhanden!", "60px", false);
            }
        }
        catch (Exception)
        {
            throw new Exception("Es konnten keine Thermedaten geladen werden");
        }

        // Spinner
        await Task.Delay(200);
        this.SpinnerVisibleProperty = false;
    }
    #endregion

    #region ToolbarBtnClickHandler
    /// <summary>
    /// ToolbarBtnClickHandler
    ///
    /// </summary>
    /// <param name="args"></param>
    public async Task ToolbarBtnClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        isDeleteProcessed = args.Item.Text == "Delete" ? true : false;

        if (args.Item.Id.Contains("_excelexport"))
        {
            ExcelExportProperties excelExportProperties = new();
            excelExportProperties.FileName = $"Gastherme_{DateTime.Now.ToString("ddMMyyyy")}.xlsx";

            ExcelTheme Theme = new ExcelTheme();
            // Header
            ExcelStyle ThemeStyleHeader = new ExcelStyle()
                {
                    FontName = "Calibri",
                    FontSize = 12,
                    Bold = true,
                };
            Theme.Header = ThemeStyleHeader;
            // Data
            ExcelStyle ThemeStyleRecord = new ExcelStyle()
                {
                    FontName = "Calibri",
                    FontSize = 10,
                    Bold = false,
                };
            Theme.Record = ThemeStyleRecord;

            excelExportProperties.Theme = Theme;

            await SfDataGrid.ExportToExcelAsync(excelExportProperties);
        }
        else if (args.Item.Id.Contains("_pdfexport"))
        {
            PdfExportProperties pdfExportProperties = new();
            pdfExportProperties.IsRepeatHeader = true;
            pdfExportProperties.FileName = $"Gastherme_{DateTime.Now.ToString("ddMMyyyy")}.pdf";
            pdfExportProperties.PageOrientation = Syncfusion.Blazor.Grids.PageOrientation.Landscape;

            PdfHeader pdfHeader = new()
                {
                    FromTop = 0,
                    Height = 80,
                    Contents = HeaderContent
                };

            PdfFooter pdfFooter = new()
                {
                    FromBottom = 0,
                    Height = 80,
                    Contents = FooterContent
                };

            PdfTheme Theme = new PdfTheme();

            PdfThemeStyle HeaderThemeStyle = new PdfThemeStyle()
                {
                    FontColor = "Blue",
                    FontName = "Calibri",
                    FontSize = 8,
                    Bold = true,
                };
            Theme.Header = HeaderThemeStyle;

            pdfExportProperties.Theme = Theme;

            pdfExportProperties.Header = pdfHeader;
            pdfExportProperties.Footer = pdfFooter;

            await SfDataGrid.ExportToPdfAsync(pdfExportProperties);
        }
        else if (args.Item.Id.Contains("XmlExport"))
        {
            Console.Write("Export to Xml function");        // wird nicht genutzt
        }
    }
    #endregion

    // #region ActionBeginHandler
    // /// <summary>
    // /// ActionBeginHandler
    // /// </summary>
    // /// <param name="args"></param>
    // public void ActionBeginHandler(ActionEventArgs<Gas_BoilerModel> args)
    // {
    //     isDeleteProcessed = false;
    //     if (args.Data != null)
    //     {
    //         if (!args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
    //         {
    //             // Add
    //             if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Add))
    //             {
    //                 // letzte Einträge holen und Variablen vorbesetzen
    //                 if (boilerList != null && boilerList.Any())
    //                 {
    //                     Gas_BoilerModel? lastBoiler = boilerList?.FirstOrDefault();

    //                     if (lastBoiler != null)
    //                     {
    //                         args.Data.Verbrauchsjahr = lastBoiler.Verbrauchsjahr.AddYears(1); // 1 Jahr addieren
    //                         args.Data.Gesamt_Verbrauch = lastBoiler.Gesamt_Verbrauch;
    //                         args.Data.Heizung_Verbrauch = lastBoiler.Heizung_Verbrauch;
    //                         args.Data.Warmwasser_Verbrauch = lastBoiler.Warmwasser_Verbrauch;
    //                         args.Data.Strom_Verbrauch = lastBoiler.Strom_Verbrauch;
    //                         args.Data.Bemerkung = lastBoiler.Bemerkung;
    //                     }
    //                 }
    //             }
    //         }
    //     }
    // }
    // #endregion

    #region ActionCompleteHandler
    /// <summary>
    /// ActionCompleteHandler
    /// </summary>
    /// <param name="args"></param>
    public async Task ActionCompleteHandler(ActionEventArgs<Gas_BoilerModel> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
        {
            if (args.Action == "Add")
            {
                save = true;
                boilerData = args.Data;

                OpenDialog("Datensatz speichern ?", "130px", true);
            }
            else if (args.Action == "Edit")
            {
                update = true;
                boilerData = args.Data;

                OpenDialog("Datensatz ändern ?", "130px", true);
            }
        }
        else if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            if (args.Data.Id == 0)
            {
                boilerList = await gwsP!.LoadDataAsync<Gas_BoilerModel>(urlBoiler);
            }
            else
            {
                boilerData = await gwsP!.DeleteDataAsync<Gas_BoilerModel>(urlBoiler, Convert.ToString(args.Data.Id));
                ShowToastMessage(true, "Datensatz gelöscht!");
            }
            SfDataGrid?.Refresh();
        }
    }
    #endregion

    #region CancelClick
    /// <summary>
    /// CancelClick
    /// </summary>
    private async void CancelClick()
    {
        DialogVisible = false;
        boilerList = await gwsP!.LoadDataAsync<Gas_BoilerModel>(urlBoiler);  // Daten neu laden
        SfDataGrid?.Refresh();
    }
    #endregion

    #region YesClick
    /// <summary>
    /// YesClick
    /// </summary>
    private async void YesClick()
    {
        DialogVisible = false;

        if (save) // Datensatz speichern
        {
            if (boilerData != null)
            {
                save = false;

                apiResponse = await gwsP!.PostDataAsync<Gas_BoilerModel>(urlBoiler, boilerData);  // POST

                if (apiResponse.MyHttpStatusCode == HttpStatusCode.Created)
                {
                    ShowToastMessage(true, "Datensatz gespeichert (created)!");
                    boilerList = await gwsP!.LoadDataAsync<Gas_BoilerModel>(urlBoiler);  // Daten neu laden
                }
                else
                {
                    ShowToastMessage(false, "Datensatz nicht gespeichert!");
                }
            }
        }
        else if (update) // Datensatz updaten
        {
            update = false;

            if (boilerData != null)
            {
                string url = urlBoiler + Convert.ToString(boilerData.Id);

                apiResponse = await gwsP!.UpdateDataAsync<Gas_BoilerModel>(url, boilerData);  // Put
                ShowToastMessage(true, "Datensatz aktualisiert!");
                boilerList = await gwsP!.LoadDataAsync<Gas_BoilerModel>(urlBoiler);  // Daten neu laden
            }
        }
        SfDataGrid?.Refresh();
    }
    #endregion

    #region ShowToastMessage
    /// <summary>
    /// ShowToastMessage
    /// </summary>
    /// <param name="success"></param>
    /// <param name="message"></param>
    /// <returns></returns>
    private void ShowToastMessage(bool success, string message)
    {
        if (success)
        {
            ShowToast("Erfolg", message, "e-toast-success", "e-circle-check");
        }
        else
        {
            ShowToast("Fehler", message, "e-toast-danger", "e-circle-close");
        }
    }
    #endregion

    #region ShowToast
    /// <summary>
    /// ShowToast
    /// </summary>
    /// <param name="title"></param>
    /// <param name="content"></param>
    /// <param name="cssClass"></param>
    /// <param name="icon"></param>
    private void ShowToast(string title, string content, string cssClass, string icon)
    {
        this.ToastService.Open(new ToastOption()
            {
                Title = title,
                Content = content,
                CssClass = cssClass,
                Icon = icon,
            });
    }
    #endregion

    #region GetTooltipContent
    /// <summary>
    /// GetTooltipContent(string headerText)
    /// </summary>
    /// <param name="headerText"></param>
    /// <returns></returns>
    // Method to get tooltip content dynamically based on HeaderText
    public string GetTooltipContent(string headerText)
    {
        return ColumnDescriptions.ContainsKey(headerText) ? ColumnDescriptions[headerText] : "No description available.";
    }
    #endregion

    #region CloseDialog
    /// <summary>
    /// CloseDialog
    /// </summary>
    private void CloseDialog()
    {
        this.DialogVisible = false;
    }
    #endregion

    #region OpenDialog
    /// <summary>
    /// CloseDialog
    /// </summary>
    private void OpenDialog(string header, string height, bool showButtons)
    {
        Header = header;
        dialogHeight = height;
        showDialogButtons = showButtons;
        this.DialogVisible = true;
    }
    #endregion

    #region GetDialogHeader
    /// <summary>
    /// GetDialogHeader
    /// </summary>
    /// <param name="supplier"></param>
    /// <returns></returns>
    public string GetDialogHeader(Gas_BoilerModel boiler)
    {
        return boiler.Id == 0
            ? "Verbrauchsjahr: neuer Verbrauch"
            : "Verbrauchsjahr: " + boiler.Verbrauchsjahr.ToString("yyyy");
    }
    #endregion

    // not used
    [JSInvokable]
    public void DeleteKeyPressed(bool isDeleteInvoked)
    {
        isDeleteProcessed = isDeleteInvoked;
        StateHasChanged();

    }

    // not used
    public void RowDeletedHandler(RowDeletedEventArgs<Gas_BoilerModel> args)
    {
        isDeleteProcessed = false;
    }

    // not used
    public void DoubleClickHandler(RecordDoubleClickEventArgs<Gas_BoilerModel> args)
    {
        isDeleteProcessed = false;
    }

    // wird ausgelöst wenn auf ein Commandbutton geklickt wurde (edit oder delete)
    public void OnCommandClicked(CommandClickEventArgs<Gas_BoilerModel> args)
    {
        isDeleteProcessed = args.CommandColumn.Type == CommandButtonType.Delete ? true : false;
    }

    #region RowCreatingHandler
    /// <summary>
    ///  RowCreatingHandler
    /// </summary>
    /// <param name="args"></param>
    public void RowCreatingHandler(RowCreatingEventArgs<Gas_BoilerModel> args)
    {
        isDeleteProcessed = false;

        // letzte Einträge holen und Variablen vorbesetzen
        if (boilerList != null && boilerList.Any())
        {
            Gas_BoilerModel? lastBoiler = boilerList?.FirstOrDefault();

            if (lastBoiler != null)
            {
                args.Data.Verbrauchsjahr = lastBoiler.Verbrauchsjahr.AddYears(1); // 1 Jahr addieren
                args.Data.Gesamt_Verbrauch = lastBoiler.Gesamt_Verbrauch;
                args.Data.Heizung_Verbrauch = lastBoiler.Heizung_Verbrauch;
                args.Data.Warmwasser_Verbrauch = lastBoiler.Warmwasser_Verbrauch;
                args.Data.Strom_Verbrauch = lastBoiler.Strom_Verbrauch;
                args.Data.Bemerkung = lastBoiler.Bemerkung;
            }
        }
    }
    #endregion
}