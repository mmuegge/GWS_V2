@page "/gas_boiler"

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Gas_Boiler> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService
@inject IJSRuntime JSRuntime;

<PageTitle>Gas- Thermedaten</PageTitle>

@* Seiten-Überschrift *@
<div class="container">
    <div class="row">
        <div class="col col-md-12">
            <div class="text-center fs-3 fw-bold">
                <span class="fa-solid fa-fire-flame-simple fa-3xs" aria-hidden="true"> </span>
                <label>Gas- Therme Verbrauchsdaten</label>
            </div>
        </div>
    </div>
</div>

@* Grid *@
@if (boilerList != null)
{
    <div class="control-section elevated-grid-container" id="target" align="center">
        <SfGrid ID="SfDataGrid" @ref="sfDataGrid" DataSource="@boilerList"
                AllowPaging="true"
                AllowFiltering="true"
                AllowReordering="true"
                AllowResizing="true"
                AllowExcelExport="true"
                AllowPdfExport="true"
                EnableHover="true"
                AllowTextWrap="true"
                AllowSelection="true"
                AllowSorting="true"
                Height="100%" 
                Width="100%"
                Toolbar=@toolbar
                AutoFit="true"
                EnableStickyHeader="true">

            <GridEditSettings 
                AllowAdding="true" 
                AllowEditing="true" 
                AllowDeleting="true" 
                ShowDeleteConfirmDialog="false" 
                Mode="EditMode.Dialog" 
                Dialog="dialogParams">

                <HeaderTemplate>
                    @{
                        var dialogHeader = GetDialogHeader((context as Gas_BoilerModel)!);
                        <span>@dialogHeader</span>
                    }
                </HeaderTemplate>

                <Template>
                    @{
                        var boilerData = (context as Gas_BoilerModel)!;
                    }
        
                    <div style="padding: 10px;">
                        <div class="form-row" style="margin-bottom: 15px;">
                            <div class="form-group col-md-12">
                                <SfDatePicker TValue="DateTime" @bind-Value="boilerData.Verbrauchsjahr" FloatLabelType="FloatLabelType.Always" Placeholder="Datum" Format="d"></SfDatePicker>
                            </div>
                        </div>
            
                        <div class="form-row" style="margin-bottom: 15px;">
                            <div class="form-group col-md-12">
                                <SfNumericTextBox TValue="double?" @bind-Value="boilerData.Gesamt_Verbrauch" FloatLabelType="FloatLabelType.Always" Placeholder="Gesamt-Verbrauch" Format="##0 kWh"></SfNumericTextBox>
                            </div>
                        </div>

                        <div class="form-row" style="margin-bottom: 15px;">
                            <div class="form-group col-md-12">
                                <SfNumericTextBox TValue="double?" @bind-Value="boilerData.Heizung_Verbrauch" FloatLabelType="FloatLabelType.Always" Placeholder="Heizung-Verbrauch" Format="##0 kWh"></SfNumericTextBox>
                            </div>
                        </div>

                        <div class="form-row" style="margin-bottom: 15px;">
                            <div class="form-group col-md-12">
                                <SfNumericTextBox TValue="double?" @bind-Value="boilerData.Warmwasser_Verbrauch" FloatLabelType="FloatLabelType.Always" Placeholder="Warmwasser-Verbrauch" Format="##0 kWh"></SfNumericTextBox>
                            </div>
                        </div>

                        <div class="form-row" style="margin-bottom: 15px;">
                            <div class="form-group col-md-12">
                                <SfNumericTextBox TValue="double?" @bind-Value="boilerData.Strom_Verbrauch" FloatLabelType="FloatLabelType.Always" Placeholder="Strom-Verbrauch" Format="##0.00 kWh"></SfNumericTextBox>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-12">
                                <SfTextBox @bind-Value="boilerData.Bemerkung" FloatLabelType="FloatLabelType.Always" Placeholder="Bemerkung"></SfTextBox>
                            </div>
                        </div>
                    </div>
                </Template>
            </GridEditSettings>

            <GridEvents OnToolbarClick="ToolbarBtnClickHandler"
                        RowCreating="RowCreatingHandler"
                        OnActionBegin="ActionBeginHandler"
                        TValue="Gas_BoilerModel">
            </GridEvents>

            <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>

            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn 
                    Field="Verbrauchsjahr" 
                    Direction="SortDirection.Descending">
                    </GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>

            <GridColumns>
                @* der Primärschlüssel muss unbedingt angegeben werden auch wenn er nicht sichtbar ist *@
                <GridColumn 
                    Field="@nameof(Gas_BoilerModel.Id)" 
                    IsPrimaryKey="true" 
                    Visible="false"
                    Width="0"
                    AllowSorting="false"
                    AllowFiltering="false"
                    AllowEditing="false">
                </GridColumn>

                <GridColumn Field=@nameof(Gas_BoilerModel.Verbrauchsjahr)
                            Format="d"
                            EditType="EditType.DatePickerEdit"
                            Width="110"
                            DefaultValue="DateTime.Now"
                            HeaderText="Datum">

                        <HeaderTemplate>
                            <SfTooltip Content="@GetTooltipContent("CY")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                                <span><b>Datum</b></span>
                            </SfTooltip>
                        </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Gas_BoilerModel.Gesamt_Verbrauch)
                    Format="##0 kWh"
                    Width="105"
                    HeaderText="Gesamt-Verbrauch">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Gesamt-Verbrauch"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="double?"
                        @bind-Value="@((context as Gas_BoilerModel)!.Gesamt_Verbrauch)"
                        Format="##0 kWh">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("CT")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Gesamt</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=Heizung_Verbrauch
                Format="##0 kWh"
                Width="115"
                HeaderText="Heizung-Verbrauch">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Heizung-Verbrauch"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="double?"
                        @bind-Value="@((context as Gas_BoilerModel)!.Heizung_Verbrauch)"
                        Format="##0 kWh">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("CH")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Heizung</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=Warmwasser_Verbrauch
                Format="##0 kWh"
                Width="105"
                HeaderText="Warmwasser-Verbrauch">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Warmwasser-Verbrauch"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="double?"
                        @bind-Value="@((context as Gas_BoilerModel)!.Warmwasser_Verbrauch)"
                        Format="##0 kWh">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("CW")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Wasser</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=Strom_Verbrauch
                Format="##0.00 kWh"
                Width="105"
                HeaderText="Strom-Verbrauch">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Strom-Verbrauch"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="double?"
                        @bind-Value="@((context as Gas_BoilerModel)!.Strom_Verbrauch)"
                        Format="##0.00 kWh">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("CE")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Strom</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=Bemerkung
                Width="230"
                HeaderText="Bemerkung">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("RM")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Bemerkung</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                    <GridCommandColumns>
                        <GridCommandColumn Type="CommandButtonType.Edit"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Delete"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Save"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Cancel"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                    </GridCommandColumns>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}
else
{
    <SfSpinner  @bind-Visible="@spinnerVisibleProperty" 
                Type="SpinnerType.Tailwind"
                CssClass="e-custom-color"
                Label="Lade Daten..." 
                Size="40">
    </SfSpinner>
}

@* Dialog*@
<div>
    <SfDialog Target="body"
              Width=@dialogWidth
              Height=@dialogHeight
              AllowDragging="true"
              ShowCloseIcon=" true"
              @bind-Visible="DialogVisible"
              AllowPrerender="false"
              IsModal="true"
              CssClass="MyCss">

        <DialogTemplates>
            <Header>@header</Header>
        </DialogTemplates>

        <DialogPositionData X="center" Y="center"></DialogPositionData>

        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

        @if (showDialogButtons)
        {
            <DialogButtons>
                <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
            </DialogButtons>
        }
    </SfDialog>
</div>

<style>
    /* 1. Zwingt das gesamte Spinner-Container-System nach ganz vorne */
    .e-spinner-pane.e-spin-overlay {
        z-index: 99999 !important;
        background-color: rgba(0, 0, 0, 0.4) !important; /* Macht den Hintergrund dunkel-transparent */
    }

        /* 2. Zwingt das Ladesymbol und den Text, sich abzuheben */
        .e-spinner-pane.e-spin-overlay .e-spinner-inner {
            z-index: 100000 !important;
        }

        /* 3. HIER WIRD DER TEXT ERZWUNGEN UND SCHÖN FORMATIERT */
        .e-spinner-pane.e-spin-overlay .e-spin-label {
            color: #FFFFFF !important; /* Reines Weiß, damit es auf dem dunklen Overlay lesbar ist */
            font-weight: bold !important; /* Fett gedruckt */
            font-size: 16px !important; /* Etwas größer für bessere Lesbarkeit */
            margin-top: 10px !important; /* Abstand zum drehenden Rad */
            display: block !important; /* Sicherstellen, dass es nicht auf hidden steht */
        }

    .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
    }

    /* Dialog Editing*/
    .e-dialog .e-dlg-header-content {
        background-color: grey;
        font-size: 24px;
    }

    .e-dialog .e-dlg-header {
        color: white;
    }

    .e-dialog .e-dlg-content {
        color: white;
        background-color: lightgray;
        font-size: 16px;
    }

    .bg-color-grey {
        background: #deded9;
    }

    #toast_default .e-circle-check::before {
        content: "\e72b";
        font-size: 17px;
    }

    #toast_default .e-circle-close::before {
        content: "\e878";
        font-size: 17px;
    }

    /* Dialog: Datensatz ändern/löschen */
    .MyCss .e-dlg-header-content {
        background-color: red;
    }
</style>
     

@code
{
    #region Variablendeklaration
    private bool spinnerVisibleProperty { get; set; } = false;

    private DialogSettings dialogParams = new DialogSettings { MinHeight = "400px", Width = "450px" };
    public DialogEffect animationEffect = DialogEffect.Zoom;
    public bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string dialogText { get; set; } = string.Empty;
    private string dialogHeight = "130px";
    private string dialogWidth = "380px";

    public int? DropDownValueSupplier { get; set; } = 0;

    readonly string urlBoiler = "gas/therme/";

    string? header { get; set; }
    string? content { get; set; }

    GWSProcessor? gwsP;
    ApiResponse? apiResponse;

    private SfGrid<Gas_BoilerModel> sfDataGrid = new();

    private enum GridOperation { None, Add, Edit, Delete }
    private GridOperation currentOperation = GridOperation.None;

    private List<Gas_BoilerModel>? boilerList = null;
    private Gas_BoilerModel? boilerData = new();

    private List<object> toolbar = new List<object>() { "Add", "Cancel", "Search", "ExcelExport", "PdfExport" };

    public DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    public DateTime MaxDate { get; set; } = new DateTime(DateTime.Now.Year, 12, 31);
    public DateTime DefaultDate { get; set; } = new DateTime(DateTime.Now.Year, 12, 31);

    MyAppConfigModel? settings;

    // Dictionary for column descriptions
    public Dictionary<string, string> ColumnDescriptions = new()
    {
        { "CY", "Verbrauchsjahr" },
        { "CT", "Gesamtverbrauch" },
        { "CH", "Verbrauch Heizung" },
        { "CW", "Verbrauch Warmwasser" },
        { "CE", "Verbrauch Strom" },
        { "RM", "Bemerkung" }
    };

    // PDF-Export Properties
    public List<PdfHeaderFooterContent> HeaderContent = new List<PdfHeaderFooterContent>
    {
    new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 4, X2 = 720, Y2 = 4}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },
    new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Gastherme", Position = new PdfPosition() { X = 350, Y = 20 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
    new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 40, X2 = 720, Y2 = 40}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },

    new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 8, HAlign = PdfHorizontalAlign.Right } }
    };

    public List<PdfHeaderFooterContent> FooterContent = new List<PdfHeaderFooterContent>
    {
        // new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Seite: ", Position = new PdfPosition() { X = 400, Y = 600 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
        // new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 10, HAlign = PdfHorizontalAlign.Right } }
    };
    #endregion

    #region OnInitializedAsync
    /// <summary>
    /// OnInitializedAsync
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        // Spinner
        this.spinnerVisibleProperty = true;

        try
        {
            // 1. Einstellungen asynchron laden & parsen
            settings = await GetSetMyAppConfig.GetMyAppSettings.ReadSettingsAsync(myAppSettings);

            // 2. API-Prozessor initialisieren und Stammdaten laden
            gwsP = new GWSProcessor(myHttpClient, settings!.GWSUri);

            // Thermedaten auslesen
            boilerList = await gwsP.LoadDataAsync<Gas_BoilerModel>(urlBoiler);

            if (!boilerList!.Any())
            {
                OpenDialog("Keine Thermedaten vorhanden!", "60px", "380px", false);
            }
        }
        catch (Exception)
        {
            throw new InvalidOperationException("Es konnten keine Thermedaten geladen werden");
        }
        finally
        {
            // Spinner
            this.spinnerVisibleProperty = false;
        }
    }
    #endregion

    #region ToolbarBtnClickHandler
    /// <summary>
    /// Toolbar-Button-Klick-Handler für das Grid.
    /// Behandelt Excel- und PDF-Exporte, zeigt einen Spinner während des Exports an und blendet bestimmte Spalten temporär aus.
    /// </summary>
    /// <param name="args"></param>

    // Variable zur Steuerung des Lade-Spinners im UI
    private bool IsExporting { get; set; }

    public async Task ToolbarBtnClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        string? itemId = args.Item?.Id;
        if (string.IsNullOrEmpty(itemId)) return;

        try
        {
            // 1. Spinner aktivieren & UI aktualisieren
            IsExporting = true;

            // Test Spinner sichtbar machen
            // 2. ERZWINGEN, dass Blazor das UI JETZT sofort neu zeichnet
            // StateHasChanged();
            // 3. TEST: 3 Sekunden warten, um zu sehen, ob der Spinner auftaucht
            // await Task.Delay(3000);

            string dateSuffix = DateTime.Now.ToString("ddMMyyyy");

            if (itemId.Contains("_excelexport", StringComparison.OrdinalIgnoreCase))
            {
                var excelExportProperties = new ExcelExportProperties
                {
                    FileName = $"Gastherme_{dateSuffix}.xlsx",
                    Theme = new ExcelTheme
                    {
                        Header = new ExcelStyle { FontName = "Calibri", FontSize = 12, Bold = true },
                        Record = new ExcelStyle { FontName = "Calibri", FontSize = 10, Bold = false }
                    }
                };

                // 2. Optionale Optimierung: Bestimmte Spalten vor Export verstecken
                await ToggleActionColumnsAsync(hide: true);

                await sfDataGrid.ExportToExcelAsync(excelExportProperties);
            }
            else if (itemId.Contains("_pdfexport", StringComparison.OrdinalIgnoreCase))
            {
                var pdfExportProperties = new PdfExportProperties
                {
                    IsRepeatHeader = true,
                    FileName = $"Gastherme_{dateSuffix}.pdf",
                    PageOrientation = Syncfusion.Blazor.Grids.PageOrientation.Landscape,
                    Header = new PdfHeader { FromTop = 0, Height = 80, Contents = HeaderContent },
                    Footer = new PdfFooter { FromBottom = 0, Height = 80, Contents = FooterContent },
                    Theme = new PdfTheme
                    {
                        Header = new PdfThemeStyle { FontColor = "Blue", FontName = "Calibri", FontSize = 8, Bold = true }
                    }
                };

                await ToggleActionColumnsAsync(hide: true);

                await sfDataGrid.ExportToPdfAsync(pdfExportProperties);
            }
        }
        catch (Exception ex)
        {
            // Hier optionales Logging oder Benutzer-Fehlermeldung integrieren
            Console.WriteLine($"Export fehlgeschlagen: {ex.Message}");
        }
        finally
        {
            // 3. Spalten wieder einblenden & Spinner deaktivieren (läuft IMMER durch)
            await ToggleActionColumnsAsync(hide: false);
            IsExporting = false;
        }
    }

    // Hilfsmethode zum Ein-/Ausblenden von Grid-Spalten (z.B. "Aktionen" oder "Id")
    private async Task ToggleActionColumnsAsync(bool hide)
    {
        // Nutzen Sie die Field-Namen Ihrer Spalten, die nicht exportiert werden sollen
        var columnsToToggle = new[] { "Id", "Actions" };

        foreach (var field in columnsToToggle)
        {
            if (hide)
            {
                await sfDataGrid.HideColumnAsync(field);
            }
            else
            {
                await sfDataGrid.ShowColumnAsync(field);
            }
        }
    }
    #endregion

    #region CancelClick
    /// <summary>
    /// CancelClick
    /// </summary>
    private async void CancelClick()
    {
        // Schließt den Dialog sofort visuell
        DialogVisible = false;

        // Setzt den aktuellen Operationstyp zurück, um sicherzustellen, dass keine Aktion mehr aussteht
        currentOperation = GridOperation.None;

        // DIE RETTUNG: Daten frisch von der API laden, um die UI-Änderungen zu verwerfen
        if (gwsP is not null && boilerData is not null)
        {
            // Nutzen Sie hier die URL-Variable, die Sie auch beim initialen Laden verwenden (z.B. urlCounter)
            // Lädt gezielt die Zählerstände für den aktuell ausgewählten Anbieter neu
            boilerList = await gwsP.LoadDataAsync<Gas_BoilerModel>(urlBoiler);
        }

        // Grid zwingen, die frischen Daten anzuzeigen
        if (sfDataGrid is not null)
        {
            await sfDataGrid.Refresh();
        }
    }
    #endregion

    #region YesClick
    /// <summary>
    /// YesClick
    /// </summary>
    private async void YesClick()
    {
        DialogVisible = false;
        if (gwsP is null || boilerData is null || currentOperation == GridOperation.None) return;

        try
        {
            bool isSuccess = false;
            string successMessage = string.Empty;
            string defaultErrorMessage = "Aktion konnte nicht ausgeführt werden.";

            // Vor jedem Aufruf die alte API-Response zurücksetzen!
            apiResponse = null;

            switch (currentOperation)
            {
                case GridOperation.Add:
                    apiResponse = await gwsP.PostDataAsync<Gas_BoilerModel>(urlBoiler, boilerData);
                    isSuccess = apiResponse?.MyHttpStatusCode == HttpStatusCode.Created;
                    successMessage = "Datensatz erfolgreich gespeichert!";
                    defaultErrorMessage = "Datensatz konnte nicht gespeichert werden.";
                    break;

                case GridOperation.Edit:
                    string urlEdit = $"{urlBoiler.TrimEnd('/')}/{boilerData.Id}";
                    apiResponse = await gwsP.UpdateDataAsync<Gas_BoilerModel>(urlEdit, boilerData);
                    isSuccess = apiResponse?.MyHttpStatusCode == HttpStatusCode.NoContent;
                    successMessage = "Datensatz erfolgreich aktualisiert!";
                    defaultErrorMessage = "Datensatz konnte nicht aktualisiert werden.";
                    break;

                case GridOperation.Delete:
                    string deleteUrl = urlBoiler.EndsWith("/") ? urlBoiler : urlBoiler + "/";
                    string idToDelete = boilerData.Id.ToString();

                    var deletedData = await gwsP.DeleteDataAsync<Gas_BoilerModel>(deleteUrl, idToDelete);

                    // Falls DeleteDataAsync intern doch die apiResponse befüllt,
                    // wäre es ideal, diese hier zuzuweisen. Wenn nicht, reicht das:
                    isSuccess = deletedData is not null;
                    successMessage = "Datensatz erfolgreich gelöscht!";
                    defaultErrorMessage = "Datensatz konnte nicht gelöscht werden.";
                    break;
            }

            if (isSuccess)
            {
                ShowToast(true, successMessage);

                // Zwinge das Grid zum sofortigen UI-Update, indem du das Element lokal entfernst
                if (boilerList is not null)
                {
                    var itemToRemove = boilerList.FirstOrDefault(x => x.Id == boilerData.Id);
                    if (itemToRemove is not null)
                    {
                        boilerList.Remove(itemToRemove);
                    }
                }

                // Erst danach im Hintergrund die Liste frisch vom Server holen
                boilerList = await gwsP.LoadDataAsync<Gas_BoilerModel>(urlBoiler);
            }
            else
            {
                string errorMessage = defaultErrorMessage;
                // Die Prüfung stellt sicher, dass wir nicht aus Versehen alte Response-Daten anzeigen
                if (apiResponse is not null && !string.IsNullOrWhiteSpace(apiResponse.MyResponseString))
                {
                    errorMessage = $"Fehler ({apiResponse.MyHttpStatusCode}): {apiResponse.MyResponseString}";
                }
                ShowToast(false, errorMessage);
            }

            if (sfDataGrid is not null)
            {
                await sfDataGrid.Refresh();
            }
        }
        catch (Exception ex)
        {
            ShowToast(false, $"Netzwerkfehler: {ex.Message}");
        }
        finally
        {
            currentOperation = GridOperation.None;
        }
    }
    #endregion

    #region ShowToast
    /// <summary>
    /// ShowToast
    /// </summary>
    /// <param name="title"></param>
    /// <param name="content"></param>
    /// <param name="cssClass"></param>
    /// <param name="icon"></param>
    private void ShowToast(bool success, string message)
    {
        var (title, cssClass, icon) = success switch
        {
            true => ("Erfolg", "e-toast-success", "e-circle-check"),
            false => ("Fehler", "e-toast-danger", "e-circle-close")
        };

        this.ToastService.Open(new()
        {
            Title = title,
            Content = message ?? string.Empty,
            CssClass = cssClass,
            Icon = icon,
        });
    }
    #endregion

    #region GetTooltipContent
    /// <summary>
    /// Methode zum Abrufen des Tooltip-Inhalts basierend auf dem Header-Text. Wenn keine Beschreibung verfügbar ist, wird ein Standardtext zurückgegeben.
    /// </summary>
    /// <param name="headerText"></param>
    /// <returns></returns>
    public string GetTooltipContent(string headerText)
    {
        return ColumnDescriptions.ContainsKey(headerText) ? ColumnDescriptions[headerText] : "Keine Beschreibung verfügbar.";
    }
    #endregion

    #region OpenDialog
    /// <summary>
    /// Dialog öffnen mit Header, Höhe, Breite und optionalen Buttons
    /// </summary>
    private void OpenDialog(string header, string height = "auto", string width = "500px", bool showButtons = true)
    {
        this.header = header;
        dialogHeight = height;
        dialogWidth = width;
        showDialogButtons = showButtons;
        this.DialogVisible = true;

        // Erzwingt das Neu-Rendern der UI (wichtig in Blazor für Dialoge)
        this.StateHasChanged();
    }
    #endregion

    #region GetDialogHeader
    /// <summary>
    /// Dialog-Header basierend auf dem aktuellen Wasser-Anbieter-Datensatz abrufen
    /// </summary>
    /// <param name="supplier"></param>
    /// <returns></returns>
    public string GetDialogHeader(Gas_BoilerModel? supplier) =>
        supplier is not { Id: > 0 }
            ? "Verbrauchsjahr: neuer Verbrauch"
            : $"Verbrauchsjahr: {supplier.Verbrauchsjahr:yyyy}";
    #endregion

    #region RowCreatingHandler
    /// <summary>
    /// Handler für die Zeilenerstellung im Grid. Setzt Standardwerte für neue Zeilen basierend auf dem letzten Eintrag.
    /// </summary>
    /// <param name="args"></param>
    public void RowCreatingHandler(RowCreatingEventArgs<Gas_BoilerModel> args)
    {
        if (args?.Data == null) return;

        // 1. Anbieter-Daten direkt zuweisen (Vermeidung von LINQ-Suche auf Listen)
        if (boilerData != null)
        {
            args.Data.Id = boilerData.Id;

            var selectedBoiler = boilerList?.FirstOrDefault(x => x.Id == boilerData.Id);
            if (selectedBoiler != null)
            {
                args.Data.Id = selectedBoiler.Id;
            }
        }

        // 3. Effizientes Holen des letzten Eintrags (Vermeidung von Any() + LastOrDefault())
        var lastYearConsumption = boilerList?.OrderByDescending(b => b.Verbrauchsjahr).FirstOrDefault();
        if (lastYearConsumption != null)
        {
            args.Data.Verbrauchsjahr = lastYearConsumption.Verbrauchsjahr.AddYears(1);
            args.Data.Bemerkung = lastYearConsumption.Bemerkung;
        }
    }
    #endregion

    #region ActionBeginHandler
    /// <summary>
    /// Handler für Aktionen im Grid (Add, Edit, Delete). Stoppt die Standardaktion und öffnet einen Bestätigungsdialog.
    /// </summary>
    /// <param name="args"></param>
    /// <returns></returns>
    public async Task ActionBeginHandler(ActionEventArgs<Gas_BoilerModel> args)
    {
        if (args == null) return;

        switch (args.RequestType)
        {
            case Syncfusion.Blazor.Grids.Action.Save:
                if (args.Data is null) return; // Prüfung gezielt hier
                args.Cancel = true;
                boilerData = args.Data;

                if (args.Action == "Add")
                {
                    currentOperation = GridOperation.Add;
                    OpenDialog("Datensatz speichern ?", "130px", "220px", true);
                }
                else if (args.Action == "Edit")
                {
                    currentOperation = GridOperation.Edit;
                    OpenDialog("Datensatz ändern ?", "130px", "220px", true);
                }
                break;

            case Syncfusion.Blazor.Grids.Action.Delete:
                // 1. Automatische Grid-Löschung SOFORT stoppen, ohne Vorbedingungen!
                args.Cancel = true;

                // Syncfusion liefert die Daten bei Delete manchmal in RowData statt Data
                var rowData = args.Data ?? args.RowData;
                if (rowData is null) return;

                // Sicherheitshalber prüfen, ob eine gültige ID vorliegt
                if (rowData.Id <= 0)
                {
                    ShowToast(false, "Ungültiger Datensatz. Löschen nicht möglich!");
                    return;
                }

                // 2. Daten für die 'YesClick'-Methode zwischenspeichern
                boilerData = rowData;
                currentOperation = GridOperation.Delete;

                // 3. Bestätigungsdialog für das Löschen öffnen
                OpenDialog("Datensatz wirklich löschen ?", "130px", "300px", true);
                break;
        }
    }
    #endregion
}