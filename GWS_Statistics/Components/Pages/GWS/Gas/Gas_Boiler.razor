@page "/gas_boiler"

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Globalization
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Gas_Boiler> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService
@inject IJSRuntime JSRuntime;

<PageTitle>Gas- Thermedaten</PageTitle>

<div class="container">
    <div class="row">
        <div class="col col-md-12">
            <div class="text-center fs-3 fw-bold">
                <span class="fa-solid fa-fire-flame-simple fa-3xs" aria-hidden="true"> </span>
                <label>Gas- Therme Verbrauchsdaten</label>
            </div>
        </div>
    </div>
</div>

<div class="control-section" id="target" align="center">
    <SfGrid ID="SfDataGrid" @ref="SfDataGrid" DataSource="@boilerList"
    AllowPaging="true"
    AllowFiltering="true"
    AllowReordering="true"
    AllowResizing="true"
    AllowExcelExport="true"
    AllowPdfExport="true"
    EnableHover="true"
    AllowTextWrap="true"
    AllowSelection="true"
    AllowSorting="true"
    Height="100%" Width="100%"
    Toolbar=@toolbar
    EnableStickyHeader="true">

        <GridEditSettings AllowAdding="true"
        AllowEditing="true"
        AllowDeleting="true"
        ShowDeleteConfirmDialog="true"
        Mode="EditMode.Dialog"
        Dialog="DialogParams">

            <HeaderTemplate>
                @{
                    var DialogHeader = GetDialogHeader((context as Gas_BoilerModel)!);
                    <span>@DialogHeader</span>
                }
            </HeaderTemplate>
        </GridEditSettings>

        <GridEvents OnToolbarClick="ToolbarBtnClickHandler"
                    CommandClicked="OnCommandClicked"
                    RowCreating="RowCreatingHandler"
                    OnActionComplete="ActionCompleteHandler"
                    TValue="Gas_BoilerModel">
        </GridEvents>

        <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>

        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

        <GridSortSettings>
            <GridSortColumns>
                <GridSortColumn 
                    Field="Verbrauchsjahr" 
                    Direction="SortDirection.Descending">
                </GridSortColumn>
            </GridSortColumns>
        </GridSortSettings>

        <GridColumns>
            <GridColumn IsPrimaryKey="true" Field="@nameof(Gas_BoilerModel.Id)" Visible="false"
                        AllowAdding="false"
                        AllowEditing="false"
                        AllowSorting="false"
                        AllowFiltering="false"
                        Width="35">
            </GridColumn>

            <GridColumn Field=@nameof(Gas_BoilerModel.Verbrauchsjahr)
                        Format="d"
                        EditType="EditType.DatePickerEdit"
                        Width="110"
                        DefaultValue="DateTime.Now"
                        HeaderText="Datum">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("CY")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Datum</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=Gesamt_Verbrauch
            Format="##0 kWh"
            Width="105"
            HeaderText="Gesamt-Verbrauch">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Gesamt-Verbrauch"
                                      FloatLabelType="FloatLabelType.Always"
                                      TValue="double?"
                                      @bind-Value="@((context as Gas_BoilerModel)!.Gesamt_Verbrauch)"
                                      Format="##0 kWh">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("CT")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Gesamt</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=Heizung_Verbrauch
                        Format="##0 kWh"
                        Width="115"
                        HeaderText="Heizung-Verbrauch">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Heizung-Verbrauch"
                                      FloatLabelType="FloatLabelType.Always"
                                      TValue="double?"
                                      @bind-Value="@((context as Gas_BoilerModel)!.Heizung_Verbrauch)"
                                      Format="##0 kWh">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("CH")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Heizung</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=Warmwasser_Verbrauch
                        Format="##0 kWh"
                        Width="105"
                        HeaderText="Warmwasser-Verbrauch">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Warmwasser-Verbrauch"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="double?"
                        @bind-Value="@((context as Gas_BoilerModel)!.Warmwasser_Verbrauch)"
                        Format="##0 kWh">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("CW")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Wasser</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=Strom_Verbrauch
            Format="##0.00 kWh"
            Width="105"
            HeaderText="Strom-Verbrauch">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Strom-Verbrauch"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="double?"
                    @bind-Value="@((context as Gas_BoilerModel)!.Strom_Verbrauch)"
                    Format="##0.00 kWh">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("CE")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Strom</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=Bemerkung
            Width="230"
            HeaderText="Bemerkung">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("RM")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Bemerkung</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                <GridCommandColumns>
                    <GridCommandColumn Type="CommandButtonType.Edit"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Delete"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Save"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Cancel"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                </GridCommandColumns>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfSpinner @bind-Visible="@SpinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

@* Dialog*@
<div>
    <SfDialog Target="#target"
              Width="320px"
              Height=@dialogHeight
              AllowDragging="true"
              ShowCloseIcon=" true"
              @bind-Visible="DialogVisible"
              AllowPrerender="true"
              IsModal="true"
              CssClass="MyCss">

        <DialogTemplates>
            <Header>@Header</Header>
        </DialogTemplates>

        <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>

        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

        @if (showDialogButtons)
        {
            <DialogButtons>
                <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
            </DialogButtons>
        }
    </SfDialog>
</div>

@if (!isDeleteProcessed)
{
    <style>
        .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
        }

        /* Dialog Editing*/
        .e-dialog .e-dlg-header-content {
        background-color: grey;
        font-size: 24px;
        }

        .e-dialog .e-dlg-header {
        color: white;
        }

        .e-dialog .e-dlg-content {
        color: black;
        background-color: lightgray;
        font-size: 16px;
        }

        .bg-color-grey {
        background: #deded9;
        }

        #toast_default .e-circle-check::before {
        content: "\e72b";
        font-size: 17px;
        }

        #toast_default .e-circle-close::before {
        content: "\e878";
        font-size: 17px;
        }

        .control-wrapper {
        max-width: 250px;
        min-width: 80px;
        margin: 0 auto;
        }

        .control-label {
        font-size: 14px;
        margin: 6px 0px;
        }

        /* Dialog: Datensatz ändern */
        .MyCss .e-dlg-header-content {
        background-color: red;
        }

        .dialog-label {
        color: black;
        font-size: 14px;
        margin-bottom: 2px;
        }
    </style>
}
else
{
    <style>
        .e-dialog .e-dlg-content {
            color: white;
            background-color: red;
            font-size: 16px;
        }

        .e-dlg-header-content {
            margin-bottom: 2px;
        }
    </style>
}

