@page "/gas_counter"

@* @rendermode InteractiveServer *@
@* @attribute [StreamRendering] *@

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Gas_SupplierModel> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService

<PageTitle>Gas- Zählerstände</PageTitle>

@* Seiten-Überschrift *@
<div class="container">
        <div class="text-center fs-3 fw-bold">
            <span class="fa-solid fa-fire-flame-simple fa-3xs" aria-hidden="true"> </span>
            <label>Gas- Zählerstände</label>
        </div>
</div>

@* Auswahl Anbieter *@
<div class="card shadow-lg p-2 mb-1">
    @* <- p-2 für den Abstand zum Schatten hinzugefügt *@
    @* Auswahl Anbieter und Anzeigen Start-Datum/Ende-Datum*@
    @* container-fluid --> Breite = 100% *@
    <div class="container-fluid bg-color-grey pb-2 border">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    <SfDropDownList DataSource="@supplierList" TItem="Gas_SupplierDataModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData!.Id">
                        <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                        <DropDownListEvents TItem="Gas_SupplierDataModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                    </SfDropDownList>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@StartDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            <div class="col-12 col-lg-4 mb-2">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@EndDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>
</div>

@* Grid *@
@if (counterList != null && counterList.Count > 0)
{
    <div class="control-section elevated-grid-container" id="target" align="center">
        <SfGrid ID="Grid" @ref="sfDataGrid" 
                DataSource="@counterList"
                AllowPaging="true"
                AllowFiltering="true"
                AllowReordering="true"
                AllowResizing="true"
                AllowExcelExport="true"
                AllowPdfExport="true"
                EnableHover="true"
                AllowTextWrap="true"
                AllowSelection="true"
                AllowSorting="true"
                Height="100%" 
                Width="100%"
                Toolbar=@toolbar
                EnableStickyHeader="true">

                <GridEditSettings 
                    AllowAdding="true"
                    AllowEditing="true"
                    AllowDeleting="true"
                    ShowDeleteConfirmDialog="false"
                    Mode="EditMode.Dialog"
                    Dialog="dialogParams">

                    <HeaderTemplate>
                    @{
                        var DialogHeader = GetDialogHeader((context as Gas_CounterModel));
                        <span>@DialogHeader</span>
                    }
                    </HeaderTemplate>

                    <Template>
                        @{
                            var gasCounterData = (context as Gas_CounterModel)!;
                        }

                            <div style="padding: 10px;">
                                <div class="form-row" style="margin-bottom: 15px;">
                                    <SfDropDownList TValue="int"
                                                    TItem="Gas_SupplierDataModel"
                                                    @bind-Value="gasCounterData.ID_Anbieter"
                                                    DataSource="@supplierList"
                                                    FloatLabelType="FloatLabelType.Always"
                                                    Placeholder="Anbieter">
                                        <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>

                                <div class="form-row" style="margin-bottom: 15px;">
                                    <div class="form-groupcol-md-12">
                                        <SfDatePicker TValue="DateTime" @bind-Value="gasCounterData.Ablesetag" FloatLabelType="FloatLabelType.Always" Placeholder="Ablesetag"></SfDatePicker>
                                    </div>
                                </div>

                                <div class="form-row" style="margin-bottom: 15px;">
                                    <div class="form-group" style="flex: 1;">
                                        <SfTimePicker TValue="DateTime?" @bind-Value="gasCounterData.Uhrzeit" FloatLabelType="FloatLabelType.Always" Placeholder="Uhrzeit" Format="HH:mm"></SfTimePicker>
                                    </div>
                                </div>

                                <div class="form-row" style="margin-bottom: 15px;">
                                    <div class="form-group" style="flex: 1;">
                                <SfNumericTextBox TValue="double?" @bind-Value="gasCounterData.Zaehlerstand" FloatLabelType="FloatLabelType.Always" Placeholder="Zählerstand" Format="###.000 m³"></SfNumericTextBox>
                                    </div>
                                </div>

                                <div class="form-row" style="margin-bottom: 15px;">
                                    <div class="form-group" style="flex: 1;">
                                <SfNumericTextBox TValue="double?" @bind-Value="gasCounterData.Temperatur_aussen" FloatLabelType="FloatLabelType.Always" Placeholder="Temperatur Außen" Format="0 °C"></SfNumericTextBox>
                                    </div>
                                </div>

                                <div class="form-row" style="margin-bottom: 15px;">
                                    <div class="form-group" style="flex: 1;">
                                <SfNumericTextBox TValue="double?" @bind-Value="gasCounterData.Temperatur_innen" FloatLabelType="FloatLabelType.Always" Placeholder="Temperatur Innen" Format="0 °C"></SfNumericTextBox>
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-12">
                                        <SfTextBox @bind-Value="gasCounterData.Bemerkungen" FloatLabelType="FloatLabelType.Always" Placeholder="Bemerkung"></SfTextBox>
                                    </div>
                                </div>
                            </div>
                    </Template>
            </GridEditSettings>


            <GridEvents 
                OnToolbarClick="ToolbarBtnClickHandler"
                RowCreating="RowCreatingHandler"
                RowDeleting="RowDeletingHandler"
                RowUpdating="RowUpdatingHandler"
                TValue="Gas_CounterModel">
            </GridEvents>

            <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn 
                    Field="Ablesetag" 
                    Direction="SortDirection.Descending">
                    </GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>

            <GridColumns>
                @* der Primärschlüssel muss unbedingt angegeben werden auch wenn er nicht sichtbar ist *@
                <GridColumn  
                    Field="@nameof(Gas_CounterModel.ID_Tag)"
                    IsPrimaryKey="true"
                    Visible="false"
                    Width="0"
                    AllowSorting="false"
                    AllowFiltering="false"
                    AllowEditing="false">
                </GridColumn>

                <GridColumn 
                    Field=@nameof(Gas_CounterModel.ID_Anbieter) 
                    Width="200" 
                    EditType="EditType.DropDownEdit" 
                    HeaderText="Anbieter">

                    @* Zeigt im normalen Grid-Modus den Text statt der ID an --> *@
                    <Template>
                        @{
                            var supplier = (context as Gas_CounterModel);
                            var supplierName = supplierList?.FirstOrDefault(s => s.Id == supplier?.ID_Anbieter)?.Anbieter;
                            <span>@supplierName</span>
                        }
                    </Template>

                    <EditTemplate>
                        <SfDropDownList Placeholder="Anbieter wählen"
                                        FloatLabelType="FloatLabelType.Always"
                                        ID="ID_Anbieter"
                                        TItem="Gas_SupplierDataModel"
                                        TValue="int"
                                        @bind-Value="@((context as Gas_CounterModel)!.ID_Anbieter)"
                                        DataSource="@supplierList">
                            @* Value="Id" (int) wird in ID_Anbieter gespeichert, Text="Anbieter" (string) wird angezeigt *@
                            <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Anbieter")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Anbieter</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Gas_CounterModel.Ablesetag)
                    EditType="EditType.DatePickerEdit"
                    Type="ColumnType.DateTime"
                    Width="110"
                    DefaultValue="DateTime.Now"
                    HeaderText="Datum"
                    Format="d">

                    <EditTemplate>
                        <SfDatePicker
                        Placeholder="Ablesetag"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="DateTime"
                        @bind-Value="@((context as Gas_CounterModel)!.Ablesetag)">

                            @* <DatePickerEvents TValue="DateTime" ValueChange="DayChangedHandler"></DatePickerEvents> *@
                        </SfDatePicker>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Datum")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Datum</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Gas_CounterModel.Uhrzeit)
                    Format="HH:mm"
                    EditType="EditType.TimePickerEdit"
                    Type="Syncfusion.Blazor.Grids.ColumnType.DateTime"
                    Width="110"
                    DefaultValue="DateTime.Now"
                    HeaderText="Uhrzeit">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Uhrzeit")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Uhrzeit</b></span>
                        </SfTooltip>
                    </HeaderTemplate>

                    <EditTemplate>
                        <SfTimePicker Placeholder="Uhrzeit"
                            FloatLabelType="FloatLabelType.Always"
                            TValue="DateTime?"
                            @bind-Value="@((context as Gas_CounterModel)!.Uhrzeit)"
                            Format="HH:mm"
                            CssClass="customdatecss"
                            ShowClearButton="true">
                            </SfTimePicker>
                    </EditTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Gas_CounterModel.Zaehlerstand)
                Format="###.000 m³"
                Width="125"
                HeaderText="Zählerstand">

                    <EditTemplate>
                        <SfNumericTextBox Placeholder="Zählerstand"
                        FloatLabelType="FloatLabelType.Always"
                        TValue="Double?"
                        @bind-Value="@((context as Gas_CounterModel)!.Zaehlerstand)"
                        Format="###.#### m³">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("ZS")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>ZS</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Gas_CounterModel.Temperatur_aussen)
                    Format="0 °C"
                    Width="110"
                    HeaderText="Temperatur aussen">

                    <EditTemplate>
                        <SfNumericTextBox 
                            Placeholder="Temperatur aussen"
                            FloatLabelType="FloatLabelType.Always"
                            TValue="double?"
                            @bind-Value="@((context as Gas_CounterModel)!.Temperatur_aussen)"
                            Format="0 °C">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("T-a")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>T-a</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Gas_CounterModel.Temperatur_innen)
                    Format="0 °C"
                    Width="110"
                    HeaderText="Temperatur innen">

                    <EditTemplate>
                        <SfNumericTextBox 
                            Placeholder="Temperatur innen"
                            FloatLabelType="FloatLabelType.Always"
                            TValue="double?"
                            @bind-Value="@((context as Gas_CounterModel)!.Temperatur_innen)"
                            Format="0 °C">
                        </SfNumericTextBox>
                    </EditTemplate>

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("T-i")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>T-i</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn Field=@nameof(Gas_CounterModel.Bemerkungen)
                Width="300"
                HeaderText="Bemerkung">

                    <HeaderTemplate>
                        <SfTooltip Content="@GetTooltipContent("Bemerkung")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                            <span><b>Bemerkung</b></span>
                        </SfTooltip>
                    </HeaderTemplate>
                </GridColumn>

                <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                    <GridCommandColumns>
                        <GridCommandColumn Type="CommandButtonType.Edit"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Delete"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Save"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Cancel"
                        ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                        </GridCommandColumn>
                    </GridCommandColumns>
                </GridColumn>
            </GridColumns>
        </SfGrid>

        @* Spinner für den Export *@
        <SfSpinner Visible="@IsExporting"
                   Label="Datei wird generiert, bitte warten..."
                   Type="@SpinnerType.Material"
                   Size="40"
                   CssClass="e-spin-overlay e-custom-color">
        </SfSpinner>
    </div>
}
else
{
    <SfSpinner @bind-Visible="@spinnerVisibleProperty" 
               Type="SpinnerType.Tailwind" 
               CssClass="e-custom-color"
               Label="Lade Daten..."
               Size="40">
    </SfSpinner>
}

@* Dialog*@
<div>
    <SfDialog Target="body"
              Width="@dialogWidth"
              Height=@dialogHeight
              AllowDragging="true"
              ShowCloseIcon=" true"
              AllowPrerender="false"
              IsModal="true"
              CssClass="MyCss"
              @bind-Visible="@DialogVisible">

        <DialogTemplates>
            <Header>@header</Header>
        </DialogTemplates>

        <DialogPositionData X="center" Y="center"></DialogPositionData>

        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

        @if (showDialogButtons)
        {
            <DialogButtons>
                <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
            </DialogButtons>
        }
    </SfDialog>
</div>

<style>
