    #region OnInitializedAsync
    /// <summary>
    /// OnInitializedAsync
    /// </summary>
    /// <returns></returns>
    /// <exception cref="Exception"></exception>
    protected override async Task OnInitializedAsync()
    {
        int lastSupplierId;

        // Spinner anzeigen bis Daten ausgelesen wurden
        this.spinnerVisibleProperty = true;

        // MyAppSettings.json auslesen und letzten gespeicherten Anbieter auslesen
        settings = GetSetMyAppConfig.GetMyAppSettings.ReadSettings(myAppSettings);

        gwsP = new GWSProcessor(myHttpClient, settings!.GWSUri);
        try
        {
            // Anbieterdaten auslesen (nur Anbieter und Id => durch Gas_SupplierDataModel)
            supplierDataList = await gwsP.LoadDataAsync<Gas_SupplierDataModel>(urlSupplier);

            if (supplierDataList != null && supplierDataList.Any()) // prüfen ob es Anbieterdaten gibt
            {
                // gespeicherten letzten Anbieter auslesen
                lastSupplierId = String.IsNullOrEmpty(settings.Supplier_Id!.Gas) ? lastSupplierId = supplierDataList.Max(x => x.Id) : lastSupplierId = Int32.Parse(settings.Supplier_Id.Gas);

                supplierData = supplierDataList
                                .Where(s => s.Id == lastSupplierId)
                                .Select(s => s).FirstOrDefault();

                if (supplierData != null)
                {
                    // Start-Datum auslesen
                    StartDate = supplierData.Zeitraum_Start ?? DateTime.Now;
                    EndDate = supplierData.Zeitraum_Ende ?? DateTime.Now;
                }
            }
            else
            {
                // es gibt keine gültigen Daten der Anbieter
                if (supplierData != null)
                {
                    supplierData.Id = 0;
                }
            }

            if (supplierData != null && supplierData.Id > 0)
            {
                // Zählerstände anbieterabhängig auslesen
                counterList = await gwsP.LoadDataAsync<Gas_CounterModel>(urlMeter + Convert.ToString(supplierData.Id));
                if (counterList == null || !counterList.Any())
                {
                    OpenDialog("Keine Gas-Zählerstände vorhanden!", "60px", "380px", false);
                }
            }
        }
        catch (Exception)
        {
            throw new Exception("Es konnten keine Gas-Zählerstände geladen werden");
        }

        // Auslesen der akt. Temperaturen von Loxone
        await ReadLoxoneTemperatures(settings.Loxone!.User, settings.Loxone.Password);
        temperatureInside = loxoneTemp?.Innentemperatur;
        temperatureOutside = loxoneTemp?.Aussentemperatur;

        #region Spinner
        await Task.Delay(800);
        this.spinnerVisibleProperty = false;
        #endregion
    }
    #endregion

    #region ToolbarBtnClickHandler
    /// <summary>
    /// ToolbarBtnClickHandler
    ///
    /// </summary>
    /// <param name="args"></param>
    public async Task ToolbarBtnClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Id.Contains("_excelexport"))
        {
            ExcelExportProperties excelExportProperties = new();
            excelExportProperties.FileName = $"Gaszaehler_{DateTime.Now.ToString("ddMMyyyy")}.xlsx";

            ExcelTheme Theme = new ExcelTheme();
            // Header
            ExcelStyle ThemeStyleHeader = new ExcelStyle()
                {
                    FontName = "Calibri",
                    FontSize = 12,
                    Bold = true,
                };
            Theme.Header = ThemeStyleHeader;
            // Data
            ExcelStyle ThemeStyleRecord = new ExcelStyle()
                {
                    FontName = "Calibri",
                    FontSize = 10,
                    Bold = false,
                };
            Theme.Record = ThemeStyleRecord;

            excelExportProperties.Theme = Theme;

            await SfDataGrid.ExportToExcelAsync(excelExportProperties);
        }
        else if (args.Item.Id.Contains("_pdfexport"))
        {
            PdfExportProperties pdfExportProperties = new();
            pdfExportProperties.IsRepeatHeader = true;
            pdfExportProperties.FileName = $"Gasanbieter_{DateTime.Now.ToString("ddMMyyyy")}.pdf";
            pdfExportProperties.PageOrientation = Syncfusion.Blazor.Grids.PageOrientation.Landscape;

            PdfHeader pdfHeader = new()
                {
                    FromTop = 0,
                    Height = 80,
                    Contents = HeaderContent
                };

            PdfFooter pdfFooter = new()
                {
                    FromBottom = 0,
                    Height = 80,
                    Contents = FooterContent
                };

            PdfTheme Theme = new PdfTheme();

            PdfThemeStyle HeaderThemeStyle = new PdfThemeStyle()
                {
                    FontColor = "Blue",
                    FontName = "Calibri",
                    FontSize = 8,
                    Bold = true,
                };
            Theme.Header = HeaderThemeStyle;

            pdfExportProperties.Theme = Theme;

            pdfExportProperties.Header = pdfHeader;
            pdfExportProperties.Footer = pdfFooter;

            await SfDataGrid.ExportToPdfAsync(pdfExportProperties);
        }
        else if (args.Item.Id.Contains("XmlExport"))
        {
            Console.Write("Export to Xml function");        // wird nicht genutzt
        }
    }
    #endregion

    // #region ActionBeginHandler
