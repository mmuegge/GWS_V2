    #region ActionCompleteHandler
    /// <summary>
    /// ActionCompleteHandler
    /// </summary>
    /// <param name="args"></param>
    public async Task ActionCompleteHandler(ActionEventArgs<Gas_CounterModel> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
        {
            if (args.Action == "Add")
            {
                save = true;

                counterData = args.Data;
                // Ablesedatum Uhrzeit korrigieren
                var corDate = new DateTime(counterData.Ablesetag.Year, counterData.Ablesetag.Month, counterData.Ablesetag.Day, 0, 0, 0);
                counterData.Ablesetag = corDate;
                // Ableseuhrzeit korrigieren
                var corTime = new DateTime(corDate.Year, corDate.Month, corDate.Day, counterData.Uhrzeit.GetValueOrDefault().Hour, counterData.Uhrzeit.GetValueOrDefault().Minute, counterData.Uhrzeit.GetValueOrDefault().Second);
                counterData.Uhrzeit = corTime;
                // Loxone-Temperaturen schreiben
                counterData.Temperatur_aussen = temperatureOutside; // Loxone Temperatur Aussen aus SfNumericTextbox auslesen
                counterData.Temperatur_innen = temperatureInside; // Temperatur Innen aus SfNumericTextbox auslesen

                // Anbieterdaten schreiben
                if (DropDownValueSupplier != null)
                {
                    counterData.ID_Anbieter = Convert.ToInt32(DropDownValueSupplier);

                    if (counterData.ID_Anbieter != 0)
                    {
                        string? supplierName = supplierDataList?.Where(x => x.Id == counterData.ID_Anbieter)
                                                                .Select(a => a.Anbieter)
                                                                .FirstOrDefault();
                        counterData.Anbieter = (supplierName != null) ? supplierName : "unbekannt";    // Anbietername auslesen oder auf "unbekannt" setzen
                    }
                }

                OpenDialog("Datensatz speichern ?", "130px", "220px", true);
            }
            else if (args.Action == "Edit")
            {
                if (DropDownValueSupplier != null && DropDownValueSupplier!= args.Data.ID_Anbieter)
                {
                    args.Data.ID_Anbieter = DropDownValueSupplier.GetValueOrDefault();
                    string? supplierName = supplierDataList?.Where(x => x.Id == DropDownValueSupplier)
                                                                .Select(a => a.Anbieter)
                                                                .FirstOrDefault();
                    args.Data.Anbieter = supplierName;
                }
                
                update = true;
                counterData = args.Data;
                OpenDialog("Datensatz ändern ?", "130px", "220px", true);
            }
        }
        else if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            if (args.Data.ID_Tag == 0)
            {
                counterList = await gwsP!.LoadDataAsync<Gas_CounterModel>(urlMeter + Convert.ToString(supplierData?.Id));
                ShowToastMessage(false, "Datensatz nicht gelöscht!");
            }
            else
            {
                // Datensatz löschen
                // Ablesetag für DELETE formatieren URL : 2021.10.24
                string readingDay = $"{args.Data.Ablesetag.Year}.{args.Data.Ablesetag.Month}.{args.Data.Ablesetag.Day}";
                counterData = await gwsP!.DeleteDataAsync<Gas_CounterModel>(urlMeterDay, readingDay);
                ShowToastMessage(true, "Datensatz gelöscht!");
            }
            SfDataGrid?.Refresh();
        }
    }
    #endregion

    #region CancelClick
    /// <summary>
    /// CancelClick
    /// </summary>
    private async Task CancelClick()
    {
        DialogVisible = false;
        dayChanged = false;
        counterList = await gwsP!.LoadDataAsync<Gas_CounterModel>(urlMeter + Convert.ToString(supplierData!.Id));  // Daten neu laden
        SfDataGrid?.Refresh();
    }
    #endregion

    #region YesClick
    /// <summary>
    /// YesClick
    /// </summary>
    private async Task YesClick()
    {
        DialogVisible = false;

        if (save) // Datensatz speichern
        {
            save = false;
            if (counterData != null)
            {
                apiResponse = await gwsP!.PostDataAsync<Gas_CounterModel>(urlMeterDay, counterData);  // POST

                if (apiResponse.MyHttpStatusCode == HttpStatusCode.Created)
                {
                    ShowToastMessage(true, "Datensatz gespeichert (created)!");
                    counterList = await gwsP!.LoadDataAsync<Gas_CounterModel>(urlMeter + Convert.ToString(supplierData!.Id));
                }
                else
                {
                    ShowToastMessage(false, "Datensatz nicht gespeichert!");
                }
            }
        }
        else if (update) // Datensatz updaten
        {
            update = false;

            if (counterData != null)
            {
                if (dayChanged) // Datum wurde im Grid geändert, Zeit auf neues Datum setzen
                {
                    counterData.Uhrzeit = new DateTime(counterData.Ablesetag.Year, counterData.Ablesetag.Month, counterData.Ablesetag.Day, counterData.Uhrzeit!.Value.Hour, counterData.Uhrzeit!.Value.Minute,0);
                    dayChanged = false;
                }
                
                // Format Ablesetag : 2021.10.24
                //string readingDay = $"{counterData.Ablesetag.Year}.{counterData.Ablesetag.Month}.{counterData.Ablesetag.Day}";
                string readingDayId = $"{counterData.ID_Tag}";
                string url = urlMeterDay + "id/" + readingDayId;

                apiResponse = await gwsP!.UpdateDataAsync<Gas_CounterModel>(url, counterData);  // Put
                if (apiResponse.MyHttpStatusCode == HttpStatusCode.NoContent)
                {
                    ShowToastMessage(true, "Datensatz aktualisiert!");
                }
                else if (apiResponse.MyHttpStatusCode == HttpStatusCode.NotFound)
                {
                    ShowToastMessage(false, $"Datensatz nicht vorhanden! ({readingDayId})");
                    counterList = await gwsP.LoadDataAsync<Gas_CounterModel>(urlMeter + Convert.ToString(supplierData!.Id));
                }
            }
        }
        SfDataGrid?.Refresh();
    }
    #endregion

    #region ValueSelectHandler
    /// <summary>
    /// Ablesetage des ausgewählten Anbieters auslesen
    /// </summary>
    /// <param name="args"></param>
    private async Task ValueSelectHandler(SelectEventArgs<Gas_SupplierDataModel> args)
    {
        supplierData = args.ItemData;

        if (supplierData.Id > 0)
        {
            // Spinner
            this.spinnerVisibleProperty = true;

            success = GetSetMyAppConfig.SetMyAppSettings.WriteSettings(myAppSettings, "Supplier_Id.Gas", supplierData.Id.ToString());

            StartDate = args.ItemData.Zeitraum_Start ?? DateTime.Now;
            EndDate = args.ItemData.Zeitraum_Ende ?? DateTime.Now;

            counterList = await gwsP!.LoadDataAsync<Gas_CounterModel>(urlMeter + Convert.ToString(supplierData.Id)); // Daten des neu ausgewählten Anbieter laden
            if (counterList == null || !counterList.Any())
            {
                OpenDialog("Keine Gas-Zählerstände vorhanden!", "60px", "380px", false);
            }

            SfDataGrid?.Refresh();

            // Spinner
            await Task.Delay(200);
            this.spinnerVisibleProperty = false;
        }
    }
    #endregion

    #region ShowToastMessage
    /// <summary>
    /// ShowToastMessage
    /// </summary>
    /// <param name="success"></param>
    /// <param name="message"></param>
    /// <returns></returns>
    private void ShowToastMessage(bool success, string message)
    {
        if (success)
        {
            ShowToast("Erfolg!", message, "e-toast-success", "e-circle-check");
        }
        else
        {
            ShowToast("Fehler!", message, "e-toast-danger", "e-circle-close");
        }
    }
    #endregion

