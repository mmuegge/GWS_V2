@page "/gas_counter"

@* @rendermode InteractiveServer *@
@* @attribute [StreamRendering] *@

@using GWS_Statistics.Components.Services
@using GWS_Statistics.Helper
@using System.Globalization
@using System.Net

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Gas_SupplierModel> Logger
@inject ToastService ToastService
@inject SfDialogService DialogService

<PageTitle>Gas- Zählerstände</PageTitle>

<div class="container">
    <div class="row">
        <div class="col col-md-12">
            @*   <p class="text-center fs-2 fw-bold">Gas- Zählerstände</p> *@
            <div class="text-center fs-3 fw-bold">
                <span class="fa-solid fa-fire-flame-simple fa-3xs" aria-hidden="true"> </span>
                <label>Gas- Zählerstände</label>
            </div>
        </div>
        @* <span class="border-bottom border-dark mb-1"></span> *@
    </div>
</div>

@* Auswahl Anbieter und Anzeigen Start-Datum/Ende-Datum*@
<div class="card shadow-lg mb-1">
    <div class="container bg-color-grey mb-3 mt-2 pb-4 border">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    <SfDropDownList DataSource="@supplierDataList" TItem="Gas_SupplierDataModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData!.Id">
                        <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                        <DropDownListEvents TItem="Gas_SupplierDataModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                    </SfDropDownList>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@StartDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@EndDate" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>
</div>

@* Grid *@
<div class="control-section" id="target" align="left">
    <SfGrid ID="Grid" @ref="SfDataGrid" DataSource="@counterList"
    AllowPaging="true"
    AllowFiltering="true"
    AllowReordering="true"
    AllowResizing="true"
    AllowExcelExport="true"
    AllowPdfExport="true"
    EnableHover="true"
    AllowTextWrap="true"
    AllowSelection="true"
    AllowSorting="true"
    Height="100%" Width="100%"
    Toolbar=@toolbar
    EnableStickyHeader="true">

        <GridEditSettings AllowAdding="true"
        AllowEditing="true"
        AllowDeleting="true"
        ShowDeleteConfirmDialog="true"
        Mode="EditMode.Dialog"
        Dialog="DialogParams">

            <HeaderTemplate>
                @{
                    var DialogHeader = GetDialogHeader((context as Gas_CounterModel)!);
                    <span>@DialogHeader</span>
                }
            </HeaderTemplate>
        </GridEditSettings>

        <GridEvents OnToolbarClick="ToolbarBtnClickHandler"
                    RowCreating="RowCreatingHandler"
                    RowEditing="RowEditingHandler"
                    OnActionComplete="ActionCompleteHandler"
                    TValue="Gas_CounterModel">
        </GridEvents>

        <GridPageSettings PageSize="20" PageSizes="true"></GridPageSettings>
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>

        <GridSortSettings>
            <GridSortColumns>
                <GridSortColumn 
                    Field="Ablesetag" 
                    Direction="SortDirection.Descending">
                </GridSortColumn>
            </GridSortColumns>
        </GridSortSettings>

        <GridColumns>
            <GridColumn IsPrimaryKey="true" Field="@nameof(Gas_CounterModel.ID_Tag)" Visible="false"
            AllowAdding="false"
            AllowEditing="false"
            AllowSorting="false"
            AllowFiltering="false"
            Width="35">
            </GridColumn>

            <GridColumn Field=@nameof(Gas_CounterModel.Anbieter)
            Width="200"
            EditType="EditType.DropDownEdit"
            HeaderText="Anbieter">

                <EditTemplate>
                    <SfDropDownList Placeholder="Anbieter"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="int?" 
                    TItem="Gas_SupplierDataModel"
                    DataSource="@supplierDataList" 
                    @bind-Value="@DropDownValueSupplier">

                        <DropDownListFieldSettings Value="Id" Text="Anbieter"></DropDownListFieldSettings>
                    </SfDropDownList>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Anbieter")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Anbieter</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Gas_CounterModel.Ablesetag)
                        EditType="EditType.DatePickerEdit"
                        Type="ColumnType.DateTime"
                        Width="110"
                        DefaultValue="DateTime.Now"
                        HeaderText="Datum"
                        Format="d">

                        <EditTemplate>
                            <SfDatePicker
                                Placeholder="Ablesetag"
                                FloatLabelType="FloatLabelType.Always"
                                TValue="DateTime"
                                @bind-Value="@((context as Gas_CounterModel)!.Ablesetag)">

                                <DatePickerEvents TValue="DateTime" ValueChange="DayChangedHandler"></DatePickerEvents>
                            </SfDatePicker>
                        </EditTemplate>

                        <HeaderTemplate>
                            <SfTooltip Content="@GetTooltipContent("Datum")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                                <span><b>Datum</b></span>
                            </SfTooltip>
                        </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Gas_CounterModel.Uhrzeit)
            Format="HH:mm"
            EditType="EditType.TimePickerEdit"
            Type="Syncfusion.Blazor.Grids.ColumnType.DateTime"
            Width="110"
            DefaultValue="DateTime.Now"
            HeaderText="Uhrzeit">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Uhrzeit")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Uhrzeit</b></span>
                    </SfTooltip>
                </HeaderTemplate>

                <EditTemplate>
                    <SfTimePicker Placeholder="Uhrzeit"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="DateTime?"
                    @bind-Value="@((context as Gas_CounterModel)!.Uhrzeit)"
                    Format="HH:mm"
                    CssClass="customdatecss"
                    ShowClearButton="true">
                    </SfTimePicker>
                </EditTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Gas_CounterModel.Zaehlerstand)
            Format="###.000 m³"
            Width="125"
            HeaderText="Zählerstand">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Zählerstand"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="Double?"
                    @bind-Value="@((context as Gas_CounterModel)!.Zaehlerstand)"
                    Format="###.#### m³">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("ZS")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>ZS</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Gas_CounterModel.Temperatur_aussen)
            Format="0 °C"
            Width="110"
            HeaderText="Temperatur aussen">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Temperatur aussen"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="double?"
                    @bind-Value="@temperatureOutside"
                    Format="0 °C">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("T-a")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>T-a</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Gas_CounterModel.Temperatur_innen)
            Format="0 °C"
            Width="110"
            HeaderText="Temperatur innen">

                <EditTemplate>
                    <SfNumericTextBox Placeholder="Temperatur innen"
                    FloatLabelType="FloatLabelType.Always"
                    TValue="double?"
                    @bind-Value="@temperatureInside"
                    Format="0 °C">
                    </SfNumericTextBox>
                </EditTemplate>

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("T-i")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>T-i</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn Field=@nameof(Gas_CounterModel.Bemerkungen)
            Width="300"
            HeaderText="Bemerkung">

                <HeaderTemplate>
                    <SfTooltip Content="@GetTooltipContent("Bemerkung")" Position="Syncfusion.Blazor.Popups.Position.BottomCenter">
                        <span><b>Bemerkung</b></span>
                    </SfTooltip>
                </HeaderTemplate>
            </GridColumn>

            <GridColumn HeaderText="Funktion" Width="20%" MinWidth="110">
                <GridCommandColumns>
                    <GridCommandColumn Type="CommandButtonType.Edit"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-edit",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Delete"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss ="e-icons e-delete",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Save"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-update",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                    <GridCommandColumn Type="CommandButtonType.Cancel"
                    ButtonOption="@(new CommandButtonOptions(){
                                                    IconCss="e-icons e-cancel-icon",
                                                    CssClass="e-flat"
                                               })">
                    </GridCommandColumn>
                </GridCommandColumns>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfSpinner @bind-Visible="@spinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

@* Dialog*@
<div>
    <SfDialog Target="#target"
                      Width="@dialogWidth"
                      Height=@dialogHeight
                      AllowDragging="true"
                      ShowCloseIcon=" true"
                      AllowPrerender="true"
                      IsModal="true"
                      CssClass="MyCss"
                      @bind-Visible="@DialogVisible">

        <DialogTemplates>
            <Header>@Header</Header>
        </DialogTemplates>

        <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>

        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>

        @if (showDialogButtons)
        {
            <DialogButtons>
                <DialogButton Content="Ja" IsPrimary="true" OnClick="@YesClick" />
                <DialogButton Content="Abbrechen" OnClick="@CancelClick" />
            </DialogButtons>
        }
    </SfDialog>
</div>

<style>
    .e-dlg-overlay {
    background-color: slategray;
    opacity: 0.6;
    }

    /* Dialog Editing*/
    .e-dialog .e-dlg-header-content {
    background-color: grey;
    font-size: 24px;
    }

    .e-dialog .e-dlg-header {
    color: white;
    }

    .e-dialog .e-dlg-content {
    color: white;
    background-color: lightgray;
    font-size: 16px;
    }

    .bg-color-grey {
    background: #deded9;
    }

    #toast_default .e-circle-check::before {
    content: "\e72b";
    font-size: 17px;
    }

    #toast_default .e-circle-close::before {
    content: "\e878";
    font-size: 17px;
    }

    .control-wrapper {
    max-width: 250px;
    min-width: 120px;
    margin: auto;
    }

    .control-label {
    font-size: 14px;
    margin: 2px 0px;
    }

    /* Dialog: Datensatz ändern */
    .MyCss .e-dlg-header-content {
    background-color: red;
    }

    .dialog-label {
    color: black;
    font-size: 14px;
    margin-bottom: 2px;
    }
</style>

