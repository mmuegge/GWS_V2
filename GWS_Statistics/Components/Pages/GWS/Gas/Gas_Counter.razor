    readonly string urlMeterDay = "gas/zaehlerstand/";

    string? Header { get; set; }
    string? Content { get; set; }

    GWSProcessor? gwsP;
    ApiResponse? apiResponse;

    LoxoneTemperatures? loxoneTemp = new();

