    #region RowCreatingHandler
    /// <summary>
    /// ein neuer Datensatz wird angelegt
    /// </summary>
    /// <param name="args"></param>
    public void RowCreatingHandler(RowCreatingEventArgs<Gas_CounterModel> args)
    {
        // Best Practice: Sicherer Null-Check
        if (args?.Data is null) return;

        // 1. Anbieter-Daten direkt zuweisen
        if (supplierData != null)
        {
            DropDownValueSupplier = supplierData.Id;
            args.Data.ID_Anbieter = supplierData.Id;

            // Optimierung: Sie nutzen oben bereits supplierData. Wenn dort der Name (Anbieter)
            // bereits enthalten ist, können Sie sich die LINQ-Suche auf supplierList komplett sparen:
            args.Data.Anbieter = supplierData.Anbieter ?? "unbekannt";
        }

        // 2. Datum und Uhrzeit vorbelegen
        args.Data.Ablesetag = DateTime.Today;
        args.Data.Uhrzeit = DateTime.Now;

        // 3. Letzten Eintrag holen und Werte vorbelegen
        var lastCounter = counterList?.LastOrDefault();
        if (lastCounter != null)
        {
            args.Data.Zaehlerstand = lastCounter.Zaehlerstand;
            args.Data.Temperatur_aussen = lastCounter.Temperatur_aussen;
            args.Data.Temperatur_innen = lastCounter.Temperatur_innen;
            args.Data.Bemerkungen = lastCounter.Bemerkungen;

            // Optimierung: Redundanten Null-Check (?) entfernt, da args.Data oben geprüft wurde.
            // Berücksichtigung Ihres Signalwerts (99) für den Fall, dass die letzte Temperatur NULL war:
            // temperatureOutside = args.Data.Temperatur_aussen ?? 99;
            // temperatureInside = args.Data.Temperatur_innen ?? 99;
        }
        else
        {
            // Falls die Liste komplett leer ist, Startwerte für die UI-Variablen setzen
            args.Data.Zaehlerstand = 0;
            args.Data.Temperatur_aussen = 0;
            args.Data.Temperatur_innen = 0;
            args.Data.Bemerkungen = "keine letzten Daten";
        }
    }
    #endregion

    #region RowUpdatingHandler
    /// <summary>
    /// Datenzeile wird aktualisiert
    /// </summary>
    /// <param name="args"></param>
    public void RowUpdatingHandler(RowUpdatingEventArgs<Gas_CounterModel> args)
    {
        if (args?.Data is null) return;

        // args.Cancel = true; // Only available in RowUpdating, NOT RowUpdated
        counterData = args.Data;

        if (args.Action == SaveActionType.Added)
        {
            currentOperation = GridOperation.Add;
            OpenDialog("Datensatz speichern ?", "130px", "220px", true);
        }
        else if (args.Action == SaveActionType.Edited)
        {
            currentOperation = GridOperation.Edit;
            OpenDialog("Datensatz ändern ?", "130px", "220px", true);
        }
    }
    #endregion

    #region RowDeletingHandler
    /// <summary>
    /// Datenzeile wird gelöscht
    /// </summary>
    /// <param name="args"></param>
    public void RowDeletingHandler(RowDeletingEventArgs<Gas_CounterModel> args)
    {
        if (args is null) return;

        var selectedRecord = args.Datas?.FirstOrDefault();
        if (selectedRecord is null) return;

        // 1. Automatische Grid-Löschung stoppen, damit dein Dialog die Kontrolle behält
        args.Cancel = true;

        // Sicherheitshalber prüfen, ob eine gültige ID vorliegt
        if (selectedRecord.ID_Tag <= 0)
        {
            ShowToast(false, "Ungültiger Datensatz. Löschen nicht möglich!");
            return;
        }

        // 2. Daten für die 'YesClick'-Methode zwischenspeichern
        counterData = selectedRecord;
        currentOperation = GridOperation.Delete;

        // 3. Bestätigungsdialog für das Löschen öffnen
        OpenDialog("Datensatz wirklich löschen ?", "130px", "300px", true);
    }
    #endregion

