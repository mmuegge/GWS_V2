    #region GetChartDataYearly
    /// <summary>
    /// Interval jährlich: Erzeugen der Chart-Daten
    /// </summary>
    /// <param name="supplier"></param>
    /// <param name="counters"></param>
    public async Task GetChartDataYearly(List<Gas_SupplierModel>? suppliers)
    {
        double? cons_kWh = 0.0d;
        IntervalDuration = 1;
        IntervalType = IntervalType.Months; // Achtung: hier muss Days stehen sonst werden gleiche Monatszeiträume auf X-Achse nicht angezeigt????
        DateTimeFormat = "yyyy";
        ChartPointList.Clear();

        if (suppliers?.Any() == false)
        {
            OpenDialog("Gas-Anbieter nicht vorhanden", "60px", "380px", false);
            return;
        }
        StartDateYearly = DateTime.MaxValue;
        EndDateYearly = DateTime.MinValue;
        foreach (Gas_SupplierModel supplier in suppliers!)
        {
            if (supplier.Zeitraum_Start != null && supplier.Zeitraum_Ende != null)
            {
                if (supplier.Zeitraum_Ende < DateTime.Now)
                {
                    StartDateYearly = supplier.Zeitraum_Start < StartDateYearly ? supplier.Zeitraum_Start : StartDateYearly;
                    EndDateYearly = supplier.Zeitraum_Ende > EndDateYearly ? supplier.Zeitraum_Ende : EndDateYearly;
                }
            }
        }

        List<IConsumption> consumptionsYearly = await Task.Run(() => GWS_Calculation.CalcConsumptionYearly(suppliers, counterChangeList)); // dann monatlichen Verbrauch berechnen

        if (consumptionsYearly?.Any() == false)
        {
            OpenDialog("Keine Gas-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }

        foreach (var cons in consumptionsYearly!)
        {
            // var gasValues = suppliers.Where(s => s.Id == cons.SupplierId).Select(s => new { s.Brennwert, s.Zustandszahl }).FirstOrDefault(); // Auslesen von Brennwert/Zustandszahl des jeweiligen Anbieters
            var gasValues = suppliers.Where(s => s.Id == cons.SupplierId).Select(s => new { s.Brennwert, s.Zustandszahl }).FirstOrDefault();

            cons_kWh = gasValues != null ? cons.Consumption * gasValues.Brennwert * gasValues.Zustandszahl : 0.0d; // Berechnen des Verbrauches in kWh

            ChartPointList.Add(new ColumnChartData { Date = cons.Date, Cons_m3 = cons.Consumption, Cons_kWh = cons_kWh, Temp = 0.0d });
        }

        CalcAverageSum();
        GetChartMinMaxRange(ChartPointList);

    }
    #endregion

    #region SelectChartData
    /// <summary>
    /// Auswählen der Chartdaten abhängig vom Intervall
    /// </summary>
    /// <param name="interval"></param>
    public async Task SelectChartData(Interval interval)
    {
        switch (interval)
        {
            case Interval.täglich:
                {
                    await GetChartDataDaily(supplierData, counterList);
                    break;
                }
            case Interval.monatlich:
                {
                    await GetChartDataMonthly(supplierData, counterList);
                    break;
                }
            case Interval.jährlich:
                {
                    counterChangeList = await gwsP!.LoadDataAsync<Gas_CounterChangeModel>(urlCounterChangeAllSuppliers); // Zählerwechsel aller Anbieter laden
                    await GetChartDataYearly(supplierList);
                    break;
                }
            default:
                {
                    await GetChartDataDaily(supplierData, counterList);
                    break;
                }
        }
    }
    #endregion

    #region CalcAverageSum
    /// <summary>
    /// Berechnen Durchschnitt/Summe/Min/Max
    /// </summary>
    public void CalcAverageSum()
    {
        ConsAverage_m3 = Math.Round(ChartPointList.Average(x => x.Cons_m3).GetValueOrDefault(), 2);
        ConsSum_m3 = Math.Round(ChartPointList.Sum(x => x.Cons_m3).GetValueOrDefault(), 2);
        ConsAverage_kWh = Math.Round(ChartPointList.Average(x => x.Cons_kWh).GetValueOrDefault(), 2);
        ConsSum_kWh = Math.Round(ChartPointList.Sum(x => x.Cons_kWh).GetValueOrDefault(), 2);
        ConsMin_kWh = Math.Round(ChartPointList.Min(x => x.Cons_kWh).GetValueOrDefault(), 2);
        ConsMax_kWh = Math.Round(ChartPointList.Max(x => x.Cons_kWh).GetValueOrDefault(), 2);
        TempAverage = Math.Round(ChartPointList.Average(x => x.Temp).GetValueOrDefault(), 2);
    }
    #endregion

    #region GetMockChartData
    /// <summary>
    /// Auslesen der Mockdaten
    /// </summary>
    /// <param name="data"></param>
    /// <param name="startPeriod"></param>
    /// <param name="endPeriod"></param>
    public async Task GetMockChartData(DateTime? startPeriod, DateTime? endPeriod)
    {
        const int days = 364;
        double? consumption = 0.0d;
        double? consumption_kWh = 0.0d;
        double? temperature = 0.0d;
        Random randomConsumption = new Random();
        Random randomTemperature = new Random();
        DateTime dayToday = DateTime.Now;

        DateTime newDate = startPeriod ?? new DateTime(1970, 1, 1);

        //ChartPointList.Clear();
        ChartPointList = new List<ColumnChartData>();

        for (int i = 0; i < days; i++)
        {
            consumption = randomConsumption.Next(0, 10);
            temperature = randomTemperature.Next(-10, 30);
            consumption_kWh = consumption * Factor_kWh;

            ChartPointList.Add(new ColumnChartData { Date = newDate, Cons_m3 = consumption, Temp = temperature, Cons_kWh = consumption_kWh });

            newDate = newDate.AddDays(1);
            if (newDate > dayToday)
            {
                break;
            }
        }
        await Task.Delay(200);
        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region GetChartMinMaxRange
    /// <summary>
    /// Berechnen Chart Min/Max-Range
    /// </summary>
    public void GetChartMinMaxRange(List<ColumnChartData> chartList)
    {
        double maxValue = 0;

        if (chartList != null && chartList.Any())
        {
            // Y-Achsen Verbrauch
            MinRangeCons = 0.0d;

            // Y-Achse kWh
            maxValue = ChartPointList.Max(v => v.Cons_kWh).GetValueOrDefault();
            MaxRangeCons_kWh = maxValue + maxValue / 20; // +5%
            Interval_YAxis_kWh = MaxRangeCons_kWh / 4;

            // Y-Achse m3
            MaxRangeCons_m3 = MaxRangeCons_kWh / 5;
            Interval_YAxis_m3 = MaxRangeCons_m3 / 4;

            // Y-Achse Temperatur
            if (DdlInterval != Interval.jährlich)
            {
                MinRangeTemp = Math.Round(ChartPointList.Min(v => v.Temp).GetValueOrDefault(), 0);
                MaxRangeTemp = Math.Round(ChartPointList.Max(v => v.Temp).GetValueOrDefault(), 0) + 2;
            }
           
            return;
        }

        MinRangeCons = 0;
        MaxRangeCons_kWh = 0;
        MaxRangeCons_m3 = 0;
        MinRangeTemp = 0;
        MaxRangeTemp = 0;
    }
    #endregion

