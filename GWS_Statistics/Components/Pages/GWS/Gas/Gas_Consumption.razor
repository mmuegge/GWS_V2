    #region LabelRender
    /// <summary>
    /// LabelRender
    /// </summary>
    /// <param name="args"></param>
    public void LabelRender(AxisLabelRenderEventArgs args)
    {
        string suffix = args.Axis.Name switch
        {
            "yAxisCons" => " kWh",
            "yAxisCons-m3" => " m³",
            "yAxisTemp" => " °C",
            _ => string.Empty
        };

        args.Text = $"{args.Text}{suffix}";
    }
