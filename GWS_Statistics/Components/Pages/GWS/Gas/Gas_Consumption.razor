@page "/gas_consumption"
@* @rendermode InteractiveServer *@

@using GWS_Statistics.Helper
@using GWS_Statistics.Calculation
@using System.Globalization
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Data

@inject MyAppConfigModel myAppSettings
@inject HttpClient myHttpClient
@inject ILogger<Gas_ConsumptionModel> Logger
@inject NavigationManager NavigationManager
@inject SfDialogService DialogService

<PageTitle>Gas- Verbräuche</PageTitle>

@* Seiten-Überschrift *@
<div class="container">
    <div class="row">
        <div class="text-center fs-3 fw-bold">
            <span class="fa-solid fa-fire-flame-simple fa-3xs" aria-hidden="true"> </span>
            <label>Gas- Verbräuche</label>
        </div>
    </div>
</div>

@* Auswahl Anbieter *@
<div class="card shadow-lg p-2 mb-1">
    <div class="container-fluid bg-color-grey pb-2 border">
        <div class="row justify-content-center">

            @* Anbieter *@
            <div class="col-6 col-xl-3">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Anbieter</label>
                    @if (supplierSelectEnabled)
                    {
                        <SfDropDownList DataSource="@supplierList" TItem="Gas_SupplierModel" TValue="int" Placeholder="Anbieter auswählen" @bind-Value="@supplierData!.Id">
                            <DropDownListFieldSettings Text="Anbieter" Value="Id"></DropDownListFieldSettings>
                            <DropDownListEvents TItem="Gas_SupplierModel" TValue="int" OnValueSelect="@ValueSelectHandler"></DropDownListEvents>
                        </SfDropDownList>
                    }
                    else
                    {
                        <SfTextBox Placeholder="Alle Anbieter" Readonly="true"></SfTextBox>
                    }
                </div>
            </div>

            @* Intervall *@
            <div class="col-6 col-xl-3">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Interval</label>
                    <SfDropDownList DataSource="@EnumInterval" TItem="string" TValue="Interval" @bind-Value="@DdlInterval">
                        <DropDownListEvents TItem="string" TValue="Interval" ValueChange="@OnValueChangeInterval"></DropDownListEvents>
                    </SfDropDownList>
                </div>
            </div>

            @* Start-Datum *@
            <div class="col-6 col-xl-3">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Start-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@(supplierSelectEnabled ? StartDate : StartDateYearly)" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>

            @* Ende-Datum *@
            <div class="col-6 col-xl-3">
                <div class="control-wrapper">
                    <label class="control-label fw-bold mb-sm-1 me-1">Ende-Datum</label>
                    <SfDatePicker TValue="DateTime?" Value="@(supplierSelectEnabled ? EndDate : EndDateYearly)" Min="@MinDate" Format="dd.MM.yyyy" AllowEdit="false" Readonly="true"></SfDatePicker>
                </div>
            </div>
        </div>
    </div>

    <div>
    @* Durchschnitt, Summe, Min, Max *@
        <div class="container-fluid bg-color-grey mt-2 pb-2 border">
            <div class="row">
                @* Durchschnittsverbrauch *@
                <div class="col-6 col-xl-3 mb-2">
                    <div class="control-wrapper">
                        <label class="control-label fw-bold mb-sm-1 me-1">Ø-Verbrauch</label>
                        <SfNumericTextBox TValue="double?" Value="@ConsAverage_kWh" Enabled="false" Format="####0.00 kWh"></SfNumericTextBox>
                        <div class="mt-1">
                            <SfNumericTextBox TValue="double?" Value="@ConsAverage_m3" Enabled="false" Format="##0.00 m³" Readonly="true"></SfNumericTextBox>
                        </div>
                    </div>
                </div>

                @* Gesamtverbrauch *@
                <div class="col-6 col-xl-3 mb-2">
                    <div class="control-wrapper">
                        <label class="control-label fw-bold mb-sm-1 me-1">&#8721-Verbrauch</label>
                        <SfNumericTextBox TValue="double?" Value="@ConsSum_kWh" Enabled="false" Format="####0.00 kWh"></SfNumericTextBox>
                        <div class="mt-1">
                            <SfNumericTextBox TValue="double?" Value="@ConsSum_m3" Enabled="false" Format="####0.00 m³"></SfNumericTextBox>
                        </div>
                    </div>
                </div>

                @* Max/Min Verbrauch *@
                <div class="col-6 col-xl-3 mb-2">
                    <div class="control-wrapper">
                        <label class="control-label fw-bold mb-sm-1 me-1">Max/Min</label>
                        <SfNumericTextBox TValue="double?" Value="@ConsMax_kWh" Enabled="false" Format="####0.00 kWh"></SfNumericTextBox>
                        <div class="mt-1">
                            <SfNumericTextBox TValue="double?" Value="@ConsMin_kWh" Enabled="false" Format="####0.00 kWh"></SfNumericTextBox>
                        </div>
                    </div>
                </div>

                @* Durchschnittstemperatur *@
                @if (DdlInterval != Interval.jährlich)
                {
                    <div class="col-6 col-xl-3 mb-2">
                        <div class="control-wrapper">
                            <label class="control-label fw-bold mb-sm-1 me-1">Ø-Temperatur</label>
                            <SfNumericTextBox TValue="double?" Value="@TempAverage" Enabled="false" Format="##0.0 °C"></SfNumericTextBox>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Chart *@
@if (ChartPointList != null && ChartPointList.Count > 0)
{
    <div class="control-section" id="target" align="center">
        <div class="card shadow-lg">
            <SfChart @ref="chart" Title="Übersicht" Width="@Width" Height="@Height" Palettes="@palettes">
                <ChartEvents 
                OnAxisLabelRender="LabelRender"
                SharedTooltipRender="ToolTipRenderEvent">
                </ChartEvents>

                <ChartTitleStyle Size="24px"
                Color="black"
                FontFamily=@fontFamily
                FontWeight="normal"
                FontStyle="normal">
                </ChartTitleStyle>

                <ChartArea Background="#8c8b87"
                Width="auto">
                    <ChartAreaBorder Color="black" Width="1"></ChartAreaBorder>
                </ChartArea>

                <ChartMargin Left="20" Right="20" Top="10" Bottom="0"></ChartMargin>

                <ChartZoomSettings EnableMouseWheelZooming="true" EnablePinchZooming="true" EnableSelectionZooming="true"></ChartZoomSettings>

                <ChartPrimaryXAxis RangePadding="ChartRangePadding.Additional"
                ValueType="Syncfusion.Blazor.Charts.ValueType.DateTimeCategory"
                EdgeLabelPlacement="EdgeLabelPlacement.None"
                Interval="@IntervalDuration"
                Format="@DateTimeFormat"
                IntervalType="@IntervalType">

                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    <ChartAxisLabelStyle FontFamily=@fontFamily></ChartAxisLabelStyle>
                    <ChartAxisTitleStyle FontFamily=@fontFamily></ChartAxisTitleStyle>
                    <ChartAxisCrosshairTooltip Fill="magenta" Enable="true"></ChartAxisCrosshairTooltip>
                </ChartPrimaryXAxis>

                <ChartPrimaryYAxis Title="Verbrauch"
                LabelFormat="{value}"
                RangePadding="ChartRangePadding.Normal">

                    <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                    <ChartAxisLabelStyle FontFamily=@fontFamily></ChartAxisLabelStyle>
                    <ChartAxisTitleStyle FontFamily=@fontFamily></ChartAxisTitleStyle>
                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    <ChartAxisCrosshairTooltip Fill="magenta" Enable="false"></ChartAxisCrosshairTooltip>
                </ChartPrimaryYAxis>

                <ChartAxes>
                    <ChartAxis Name="yAxisCons"
                    Title="Verbrauch (kWh)"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="false"
                    Interval="@Interval_YAxis_kWh"
                    Minimum="0"
                    Maximum="@MaxRangeCons_kWh"
                    LabelFormat="@labelFormat">
                        <ChartAxisMajorGridLines Width="1"></ChartAxisMajorGridLines>
                    </ChartAxis>

                    <ChartAxis Name="yAxisCons-m3"
                    Title="Verbrauch (m3)"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="false"
                    Interval="@Interval_YAxis_m3"
                    Minimum="0"
                    Maximum="@MaxRangeCons_m3"
                    LabelFormat="N0">
                        <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    </ChartAxis>

                    <ChartAxis Name="yAxisTemp"
                    Title="Temperatur"
                    RangePadding="ChartRangePadding.Auto"
                    OpposedPosition="true"
                    Interval="5"
                    Minimum="@MinRangeTemp"
                    Maximum="@MaxRangeTemp"
                    LabelFormat="N0">
                        <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    </ChartAxis>
                </ChartAxes>

                <ChartSeriesCollection>
                    <ChartSeries Type="ChartSeriesType.Column"
                    DataSource="@ChartPointList"
                    YAxisName="yAxisCons"
                    Visible="@serieConskWh_Visible"
                    XName="Date"
                    YName="Cons_kWh"
                    Width="3"
                    GroupName="Consumption"
                    Name="Verbrauch (kWh)"
                    TooltipFormat="${series.name} : ${point.y} kWh">
                    </ChartSeries>

                    <ChartSeries Type="ChartSeriesType.Column"
                    DataSource="@ChartPointList"
                    YAxisName="yAxisCons-m3"
                    Visible="@serieConsm3_Visible"
                    XName="Date"
                    YName="Cons_m3"
                    Width="3"
                    GroupName="Consumption"
                    Name="Verbrauch (m³)"
                    TooltipFormat="${series.name} : ${point.y} m³">
                    </ChartSeries>

                    @if (DdlInterval != Interval.jährlich)
                    {
                        <ChartSeries Type="ChartSeriesType.Line"
                        DataSource="@ChartPointList"
                        YAxisName="yAxisTemp"
                        Visible=@serieTempVisible
                        XName="Date"
                        YName="Temp"
                        Width="1"
                        Name="Temperatur"
                        TooltipFormat="${series.name} : ${point.y} °C">
                        </ChartSeries>
                    }
                </ChartSeriesCollection>

                <ChartCrosshairSettings Enable="true" LineType="LineType.Both"></ChartCrosshairSettings>

                <ChartLegendSettings Visible="true" EnableHighlight="true"></ChartLegendSettings>

                <ChartTooltipSettings Header="<b>${point.tooltip}</b>" Enable="true" Shared="true"></ChartTooltipSettings>
            </SfChart>

            <SfSpinner @bind-Visible="@spinnerVisibleProperty" Type="SpinnerType.Tailwind" Size="40" CssClass="e-custom-color"></SfSpinner>

        </div>
    </div>
}
else
{
    <SfSpinner @bind-Visible="@spinnerVisibleProperty" Label="Lade Daten..." Size="40"></SfSpinner>
}

@* Dialog*@
<div>
    <SfDialog Target="#target" Width="@dialogWidth" Height="@dialogHeight" AllowDragging="true" ShowCloseIcon="true" @bind-Visible="@DialogVisible" AllowPrerender="true" IsModal="true">
        <DialogTemplates>
            <Header>@Header</Header>
        </DialogTemplates>
        <DialogPositionData X="@dialogXValue" Y="@dialogYValue"></DialogPositionData>
        <DialogAnimationSettings Effect="@animationEffect"></DialogAnimationSettings>
    </SfDialog>
</div>

<style>
    .e-dlg-overlay {
        background-color: slategray;
        opacity: 0.6;
    }

    .e-dialog .e-dlg-header-content {
        color: white;
        background-color: red;
        font-size: 24px;
    }

    .e-dialog .e-dlg-header {
        color: white;
    }

    .e-dialog .e-dlg-content {
        color: white;
        background-color: red;
        font-size: 16px;
    }

    .bg-color-grey {
        background: #deded9;
    }

    .control-wrapper {
        max-width: 250px;
        min-width: 80px;
        margin: 0 auto;
    }

    .control-label {
        font-size: 14px;
        margin: 6px 0px;
    }

    .tooltipStyle {
        border-radius: 25px;
    }

    .tooltipTextcolor {
        color: white;
        background-color: black;
    }
</style>

@code {
    // Variabledeklaration
    #region Variablen
    private bool success = false;
    bool supplierSelectEnabled = true;

    #region DialogBox
    DialogEffect animationEffect { get; set; } = DialogEffect.Zoom;
    bool DialogVisible { get; set; } = false;
    private bool showDialogButtons = false;
    private string DialogText { get; set; } = string.Empty;
    private string dialogXValue = "center";
    private string dialogYValue = "center";
    private string dialogHeight = "130px";
    private string dialogWidth = "380px";
    #endregion

    #region Interval
    public IEnumerable<string> EnumInterval = Enum.GetNames(typeof(Interval));
    public Interval DdlInterval { get; set; } = Interval.täglich;
    #endregion

    #region Spinner
    bool spinnerVisibleProperty { get; set; } = false;
    #endregion

    #region Daten
    private List<Gas_SupplierModel>? supplierList = null;
    private List<Gas_CounterModel>? counterList = new();
    private Gas_SupplierModel? supplierData = new();
    private List<Gas_CounterChangeModel>? counterChangeList = null;
    #endregion

    #region DateTime
    private DateTime MinDate { get; set; } = new DateTime(1990, 1, 1);
    private DateTime MaxDate { get; set; } = DateTime.Now;
    private DateTime? StartDate { get; set; } = new DateTime(2000, 1, 1);
    private DateTime? EndDate { get; set; } = new DateTime(2000, 1, 1);
    private DateTime? StartDateYearly { get; set; } = DateTime.MaxValue;
    private DateTime? EndDateYearly { get; set; } = DateTime.MinValue;
    #endregion

    #region App-Settings
    MyAppConfigModel? settings;
    #endregion

    #region Url
    readonly string urlSupplier = "gas/anbieter/";
    readonly string urlMeter = "gas/zaehlerstaende/anbieter/";
    readonly string urlCounterChange = "gas/zaehlerwechsel/anbieter/";
    readonly string urlCounterChangeAllSuppliers = "gas/zaehlerwechsel";
    #endregion

    string? Header { get; set; }
    string? Content { get; set; }

    #region Http
    GWSProcessor? gwsP;
    #endregion

    #region PDF-Eigenschaften
    public List<PdfHeaderFooterContent> HeaderContent = new List<PdfHeaderFooterContent>
    {
        new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 4, X2 = 720, Y2 = 4}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },
        new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Gas-Zählerstände", Position = new PdfPosition() { X = 350, Y = 20 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
        new PdfHeaderFooterContent() { Type = ContentType.Line, Points= new PdfPoints { X1 = 0, Y1 = 40, X2 = 720, Y2 = 40}, Style = new PdfContentStyle() { PenColor = "#000080", DashStyle=PdfDashStyle.Solid } },
        new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 8, HAlign = PdfHorizontalAlign.Right } }
    };

    public List<PdfHeaderFooterContent> FooterContent = new List<PdfHeaderFooterContent>
    {
        // new PdfHeaderFooterContent() { Type = ContentType.Text, Value = "Seite: ", Position = new PdfPosition() { X = 400, Y = 600 }, Style = new PdfContentStyle() { TextBrushColor = "#000000", FontSize = 10 } },
        // new PdfHeaderFooterContent() { Type = ContentType.PageNumber,  PageNumberType = PdfPageNumberType.Numeric, Position = new PdfPosition() { X = 470, Y = 650 }, Style = new PdfContentStyle() { TextBrushColor = "red", FontSize = 10, HAlign = PdfHorizontalAlign.Right } }
    };
    #endregion

    #region Chart
    SfChart chart = new();
    public bool serieConskWh_Visible = true;
    public bool serieConsm3_Visible = false;
    public bool serieTempVisible = false;

    public string fontFamily { get; set; } = "Arial";
    //public IntervalType IntervalType { get; set; } = IntervalType.Months;
    public IntervalType IntervalType { get; set; } = IntervalType.Days;
    public int IntervalDuration { get; set; } = 1;

    public string DateTimeFormat { get; set; } = "dd.MM.yyyy";

    private Theme Theme { get; set; }
    public string Width { get; set; } = "100%";
    public string Height { get; set; } = "160%";
    public double Rotation { get; set; } = 0;
    public LabelIntersectAction Label { get; set; } = LabelIntersectAction.Trim;
    public String[] palettes = new String[] { "#f2ae1b", "#f5ec42", "#0634bd" };  // Farben Serie: Verbrauch kWh, Verbrauch m3, Temperatur
    public double Interval_YAxis_kWh { get; set; } = 30;
    public double Interval_YAxis_m3 { get; set; } = 20;
    public double MaxRangeCons_kWh { get; set; } = 20;
    public double MaxRangeCons_m3 { get; set; } = 10;
    public double MinRangeCons { get; set; } = 0;
    public double MaxRangeTemp { get; set; } = 40;
    public double MinRangeTemp { get; set; } = -10;

    public double? ConsAverage_kWh { get; set; } = 0;
    public double? ConsSum_kWh { get; set; } = 0;
    public double ConsAverage_m3 { get; set; } = 0;
    public double? ConsSum_m3 { get; set; } = 0;
    public double? ConsMin_kWh { get; set; } = 0;
    public double? ConsMax_kWh { get; set; } = 0;
    public double Factor_kWh { get; set; } = 0;
    public double? TempAverage { get; set; } = 0;

    public string labelFormat = "N0";

    public List<ColumnChartData> ChartPointList { get; set; } = new List<ColumnChartData>();

    public class ColumnChartData
    {
        public DateTime Date { get; set; }
        public double? Cons_m3 { get; set; }
        public double? Cons_kWh { get; set; }
        public double? Temp { get; set; }
    }

    public class GasCalc
    {
        public double Brennwert { get; set; }
        public double Zustandszahl { get; set; }
    }
    #endregion

    #endregion

    #region OnInitializedAsync
    /// <summary>
    /// Startet die asynchrone Initialisierung der Komponente, lädt die Konfiguration und die Strom-Anbieter-Daten.
    /// </summary>
    /// <returns></returns>
    /// <exception cref="Exception"></exception>
    protected override async Task OnInitializedAsync()
    {
        this.spinnerVisibleProperty = true;

        try
        {
            // 1. Einstellungen asynchron laden & parsen
            settings = await GetSetMyAppConfig.GetMyAppSettings.ReadSettingsAsync(myAppSettings);

            if (settings?.Display_Interval?.Gas != null && int.TryParse(settings.Display_Interval.Gas, out int enumValue) && Enum.IsDefined(typeof(Interval), enumValue))
            {
                DdlInterval = (Interval)enumValue;
                supplierSelectEnabled = DdlInterval != Interval.jährlich;
            }
            else
            {
                DdlInterval = Interval.täglich;
                supplierSelectEnabled = true;
            }

            // 2. API-Prozessor initialisieren und Stammdaten laden (Null-Safe)
            gwsP = new GWSProcessor(myHttpClient, settings?.GWSUri ?? string.Empty);

            supplierList = await gwsP.LoadDataAsync<Gas_SupplierModel>(urlSupplier);

            int targetSupplierId = 0;

            if (supplierList != null && supplierList.Count > 0)
            {
                // ID-Ermittlung: Max() nur einmal berechnen
                int maxSupplierId = supplierList.Max(x => x.Id);

                if (string.IsNullOrEmpty(settings?.Supplier_Id?.Gas) || settings.Supplier_Id.Gas == "0")
                {
                    targetSupplierId = maxSupplierId;
                }
                else if (int.TryParse(settings.Supplier_Id.Gas, out int parsedId) && supplierList.Any(s => s.Id == parsedId))
                {
                    targetSupplierId = parsedId;
                }
                else
                {
                    targetSupplierId = maxSupplierId;
                }

                // Anbieter direkt heraussuchen
                supplierData = supplierList.FirstOrDefault(s => s.Id == targetSupplierId);

                if (supplierData != null)
                {
                    StartDate = supplierData.Zeitraum_Start ?? DateTime.Now;
                    EndDate = supplierData.Zeitraum_Ende ?? DateTime.Now;

                    // Faktor Umrechnung m3 => kWh
                    double brennwert = supplierData.Brennwert ?? 1.0d;
                    double zustandszahl = supplierData.Zustandszahl ?? 1.0d;
                    Factor_kWh = brennwert * zustandszahl;
                }
            }
            else
            {
                // Null-Safe Absicherung für die ID
                supplierData ??= new Gas_SupplierModel();
                supplierData.Id = 0;
            }

            // 3. Zählerdaten & Zählerwechsel parallel laden (Performance-Boost)
            string supplierIdStr = (supplierData?.Id ?? 0).ToString();
            var counterTask = gwsP.LoadDataAsync<Gas_CounterModel>($"{urlMeter}{supplierIdStr}");
            var changeTask = gwsP.LoadDataAsync<Gas_CounterChangeModel>($"{urlCounterChange}{supplierIdStr}");

            // Beide Netzwerk-Anfragen laufen gleichzeitig
            await Task.WhenAll(counterTask, changeTask);

            counterList = await counterTask;
            counterChangeList = await changeTask;

            // 4. Verbräuche verarbeiten
            if (counterList != null && counterList.Count > 0)
            {
                counterList.Sort((x, y) => x.Ablesetag.CompareTo(y.Ablesetag));
                await Task.Run(() => SelectChartData(DdlInterval));
            }
            else
            {
                HandleMissingData();
            }
        }
        catch (Exception)
        {
            HandleMissingData();
        }
        finally
        {
            // Durch das 'finally' wird der Spinner jetzt auch bei Abstürzen sicher abgeschaltet.
            this.spinnerVisibleProperty = false;

            StateHasChanged();
        }
    }

    // Hilfsmethode zur Vermeidung von doppeltem Code
    private void HandleMissingData()
    {
        ClearSumAverage();
        OpenDialog("Keine Gas-Verbräuche vorhanden!", "60px", "380px", false);
    }
    #endregion

    #region ValueSelectHandler
    /// <summary>
    /// neuen Anbieter ausgewählt, Ablesetage des ausgewählten Anbieters auslesen
    /// </summary>
    /// <param name="args"></param>
    private async Task ValueSelectHandler(SelectEventArgs<Gas_SupplierModel> args)
    {
        // 1. Früher Abbruch bei ungültigen Argumenten
        if (args?.ItemData == null) return;

        this.spinnerVisibleProperty = true;

        // In Blazor oft nötig, damit der Spinner SOFORT gezeichnet wird,
        // bevor die blockierenden asynchronen Operationen starten
        StateHasChanged();

        try
        {
            // 2. Vereinfachtes LINQ (FirstOrDefault sucht direkt mit Lambda)
            supplierData = supplierList?.FirstOrDefault(s => s.Id == args.ItemData.Id);

            if (supplierData != null && supplierData.Id > 0)
            {
                // 3. Konstanten/Zuweisungen bündeln
                StartDate = supplierData.Zeitraum_Start ?? DateTime.Now;
                EndDate = supplierData.Zeitraum_Ende ?? DateTime.Now;

                double brennwert = supplierData.Brennwert ?? 1.0d;
                double zustandszahl = supplierData.Zustandszahl ?? 1.0d;
                Factor_kWh = brennwert * zustandszahl;

                // 4. String-Interpolation statt veraltetem Convert.ToString()
                string supplierIdStr = supplierData.Id.ToString();

                // Parallelisierung der API-Aufrufe zur Performance-Optimierung
                var counterTask = gwsP!.LoadDataAsync<Gas_CounterModel>($"{urlMeter}{supplierIdStr}");
                var changeTask = gwsP!.LoadDataAsync<Gas_CounterChangeModel>($"{urlCounterChange}{supplierIdStr}");

                // Beide Abfragen laufen gleichzeitig -> Halbiert potenziell die Ladezeit
                await Task.WhenAll(counterTask, changeTask);

                var rawCounterList = await counterTask;
                counterChangeList = await changeTask;

                // 5. Effizientes Sortieren im Speicher ( LINQ .OrderBy ist oft sauberer,
                // aber List.Sort() In-Place ist performant. Hier sicher konvertiert:)
                counterList = rawCounterList?.OrderBy(c => c.Ablesetag).ToList() ?? new List<Gas_CounterModel>();

                // 6. UI-Charts NICHT in Task.Run auslagern (Gefahr von Rendering-Crashes)
                // Stattdessen direkt asynchron aufrufen, wenn SelectChartData async ist.
                await SelectChartData(DdlInterval);

                // 7. Konfiguration speichern
                success = await GetSetMyAppConfig.SetMyAppSettings.WriteSettingsAsync(myAppSettings, "Supplier_Id.Gas", supplierIdStr);
                if (!success)
                {
                    OpenDialog("Gas-Anbieter nicht gespeichert!", "60px", "380px", false);
                }
            }
            else
            {
                ClearSumAverage();
                OpenDialog("Keine Gas-Verbräuche vorhanden!", "60px", "380px", false);
            }
        }
        catch (Exception ex)
        {
            // 8. Fehler abfangen, damit die App nicht abstürzt und der Spinner ausgeht
            OpenDialog($"Fehler beim Laden der Anbieterdaten: {ex.Message}", "60px", "380px", false);
        }
        finally
        {
            // 9. Spinner wird IMMER deaktiviert
            this.spinnerVisibleProperty = false;
        }
    }

    #endregion

    #region OnValueChangeInterval
    /// <summary>
    /// OnValueChangeInterval
    /// </summary>
    /// <param name="data"></param>
    /// <param name="startPeriod"></param>
    /// <param name="endPeriod"></param>
    /// <exception cref="Exception"></exception>
    private async Task OnValueChangeInterval(ChangeEventArgs<Interval, string> args)
    {
        // 1. Früher Abbruch bei ungültigen Argumenten
        if (args == null) return;

        this.spinnerVisibleProperty = true;

        // Erzwingt das sofortige Zeichnen des Spinners in der Blazor-UI
        StateHasChanged();

        try
        {
            // 2. Werte zuweisen und parsen
            DdlInterval = args.Value;
            supplierSelectEnabled = DdlInterval != Interval.jährlich;
            int enumValue = (int)DdlInterval;

            // 3. FEHLERBEHEBUNG & THREAD-SICHERHEIT:
            // Direkt asynchron abwarten (KEIN Task.Run), verhindert Compiler-Fehler CS4014
            await SelectChartData(DdlInterval);

            // 4. Einstellungen asynchron speichern
            // Hinweis: Der Text im Dialog wurde von "Gas-Anbieter" zu "Intervall" korrigiert
            success = await GetSetMyAppConfig.SetMyAppSettings.WriteSettingsAsync(
                myAppSettings,
                "Display_Interval.Gas",
                enumValue.ToString()
            );

            if (!success)
            {
                OpenDialog("Gas-Intervall nicht gespeichert!", "60px", "380px", false);
            }
        }
        catch (Exception ex)
        {
            // 5. Fehler abfangen, damit die UI stabil bleibt und der Spinner ausgeht
            OpenDialog($"Fehler beim Ändern des Intervalls: {ex.Message}", "60px", "380px", false);
        }
        finally
        {
            // 6. Künstliches Delay entfernt und Spinner-Garantie
            this.spinnerVisibleProperty = false;
        }
    }

    #endregion

    #region GetChartDataDaily
    /// <summary>
    /// Interval täglich: Erzeugen der Chart-Daten
    /// </summary>
    /// <param name="supplier"></param>
    /// <param name="counters"></param>

    public async Task GetChartDataDaily(Gas_SupplierModel? supplier, List<Gas_CounterModel>? counters)
    {
        DateTimeFormat = "dd.MM.yy";

        // 1. Logik-Korrektur: Doppelte Zuweisungen im ternären Operator entfernt
        if (counters != null && counters.Count > 0)
        {
            IntervalDuration = (counters.Count > 10 && counters.Count <= 30) ? 7 : 1;
            IntervalType = counters.Count > 30 ? IntervalType.Months : IntervalType.Days;
        }
        else
        {
            IntervalDuration = 1;
            IntervalType = IntervalType.Days;
        }

        ChartPointList.Clear();

        // 2. CPU-intensive Berechnung im Hintergrundthread belassen (das ist hier korrekt!)
        // Aber direkt prüfen, ob das Ergebnis null oder leer ist.
        var consumptions = await Task.Run(() => GWS_Calculation.CalcConsumptionDaily(supplier, counterChangeList, counters));

        if (consumptions == null || consumptions.Count == 0)
        {
            ClearSumAverage();
            OpenDialog("Keine Gas-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }

        // 3. Performance-Optimierung: Kapazität der Liste vorab reservieren,
        // um internes Kopieren/Vergrößern im Speicher zu verhindern.
        if (ChartPointList is List<ColumnChartData> list)
        {
            list.EnsureCapacity(consumptions.Count);
        }

        // 4. Schleife optimiert (Lokale Variable spart mehrfache Properties-Lookups)
        double factor = Factor_kWh;
        foreach (var cons in consumptions)
        {
            ChartPointList.Add(new ColumnChartData
            {
                Date = cons.Date,
                Cons_m3 = cons.Consumption,
                Cons_kWh = cons.Consumption * factor,
                Temp = cons.Temperature
            });
        }

        // 5. Abschließende Berechnungen
        CalcAverageSum();
        GetChartMinMaxRange(ChartPointList);
    }

    #endregion

    #region GetChartDataMonthly
    /// <summary>
    /// Interval monatlich: Erzeugen der Chart-Daten
    /// </summary>
    /// <param name="supplier"></param>
    /// <param name="counters"></param>
    public async Task GetChartDataMonthly(Gas_SupplierModel? supplier, List<Gas_CounterModel>? counters)
    {
        IntervalDuration = 1;
        IntervalType = IntervalType.Months;
        DateTimeFormat = "MMM yy";

        ChartPointList.Clear();

        // 1. CPU-intensive Berechnung im Hintergrundthread belassen
        var consumptionsMonthly = await Task.Run(() => GWS_Calculation.CalcConsumptionMonthly(supplier, counterChangeList, counters));

        // 2. Schnelle und sichere Null- sowie Leerprüfung (Count ist bei Listen performanter als .Any())
        if (consumptionsMonthly == null || consumptionsMonthly.Count == 0)
        {
            OpenDialog("Keine Gas-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }

        // 3. Performance-Optimierung: Kapazität der Zielliste vorab reservieren
        if (ChartPointList is List<ColumnChartData> list)
        {
            list.EnsureCapacity(consumptionsMonthly.Count);
        }

        // 4. Schleife optimiert (Verwendung der lokalen double-Variable ohne Null-Prüfung)
        double factor = Factor_kWh;
        foreach (var cons in consumptionsMonthly)
        {
            ChartPointList.Add(new ColumnChartData
            {
                Date = cons.Date,
                Cons_m3 = cons.Consumption,
                Cons_kWh = cons.Consumption * factor,
                Temp = cons.Temperature
            });
        }

        // 5. Berechnungen und UI-Vorbereitung finalisieren
        CalcAverageSum();
        GetChartMinMaxRange(ChartPointList);
    }

    #endregion

    #region GetChartDataYearly
    /// <summary>
    /// Interval jährlich: Erzeugen der Chart-Daten
    /// </summary>
    /// <param name="supplier"></param>
    /// <param name="counters"></param>
    public async Task GetChartDataYearly(List<Gas_SupplierModel>? suppliers)
    {
        IntervalDuration = 1;
        // Auf Days oder Years ändern, um Achsen-Probleme bei der Jahresansicht zu umgehen
        IntervalType = IntervalType.Days;
        DateTimeFormat = "yyyy";
        ChartPointList.Clear();

        // 1. Sichere und schnelle Null- und Leerprüfung
        if (suppliers == null || suppliers.Count == 0)
        {
            OpenDialog("Gas-Anbieter nicht vorhanden", "60px", "380px", false);
            return;
        }

        // 2. Ermittlung des Zeitraums mit LINQ (deutlich performanter und lesbarer als die foreach-Schleife)
        var validSuppliers = suppliers
            .Where(s => s.Zeitraum_Start != null && s.Zeitraum_Ende != null && s.Zeitraum_Ende < DateTime.Now)
            .ToList();

        if (validSuppliers.Count > 0)
        {
            StartDateYearly = validSuppliers.Min(s => s.Zeitraum_Start!.Value);
            EndDateYearly = validSuppliers.Max(s => s.Zeitraum_Ende!.Value);
        }
        else
        {
            StartDateYearly = DateTime.MaxValue;
            EndDateYearly = DateTime.MinValue;
        }

        // 3. CPU-intensive Jahresberechnung im Hintergrundthread
        var consumptionsYearly = await Task.Run(() => GWS_Calculation.CalcConsumptionYearly(suppliers, counterChangeList));

        if (consumptionsYearly == null || consumptionsYearly.Count == 0)
        {
            OpenDialog("Keine Gas-Verbräuche vorhanden!", "60px", "380px", false);
            return;
        }

        // 4. Performance-Optimierung: Kapazität der Zielliste vorab reservieren
        if (ChartPointList is List<ColumnChartData> list)
        {
            list.EnsureCapacity(consumptionsYearly.Count);
        }

        // 5. Performance-Booster: Dictionary für O(1) statt O(N) Lookup in der Schleife
        // Verhindert, dass für JEDES Jahr die komplette Liste der Anbieter linear durchsucht wird.
        // var supplierLookup = suppliers
        //     .ToDictionary(s => s.Id, s => new { Brennwert = s.Brennwert ?? 1.0d, Zustandszahl = s.Zustandszahl ?? 1.0d });

        // 5. Dictionary mit einem klaren, nicht-nullbaren ValueTuple (double Brennwert, double Zustandszahl)
        var supplierLookup = suppliers
            .ToDictionary(
                s => s.Id,
                s => (Brennwert: s.Brennwert ?? 1.0d, Zustandszahl: s.Zustandszahl ?? 1.0d)
            );

        foreach (var cons in consumptionsYearly)
        {
            double cons_kWh = 0.0d;

            // Sicherstellen, dass der Verbrauch nicht null ist (Fallback auf 0.0d)
            double consumption = cons.Consumption ?? 0.0d;

            // Zugriff auf das Tuple (wird vom Compiler garantiert als normales double erkannt)
            if (supplierLookup.TryGetValue(cons.SupplierId, out var gasValues))
            {
                cons_kWh = consumption * gasValues.Brennwert * gasValues.Zustandszahl;
            }

            ChartPointList.Add(new ColumnChartData
            {
                Date = cons.Date,
                Cons_m3 = cons.Consumption,
                Cons_kWh = cons_kWh,
                Temp = 0.0d
            });
        }

        // 6. Berechnungen abschließen
        CalcAverageSum();
        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region SelectChartData
    /// <summary>
    /// Auswählen der Chartdaten abhängig vom Intervall
    /// </summary>
    /// <param name="interval"></param>
    public async Task SelectChartData(Interval interval)
    {
        // Vorab-Abfrage für das Laden der Zählerwechsel-Daten (nur bei jährlich)
        if (interval == Interval.jährlich)
        {
            counterChangeList = await gwsP!.LoadDataAsync<Gas_CounterChangeModel>(urlCounterChangeAllSuppliers);
        }

        // Kompakte Zuordnung und Ausführung der Diagramm-Tasks
        Task chartTask = interval switch
        {
            Interval.monatlich => GetChartDataMonthly(supplierData, counterList),
            Interval.jährlich => GetChartDataYearly(supplierList),
            _ => GetChartDataDaily(supplierData, counterList) // deckt täglich und default ab
        };

        await chartTask;
    }
    #endregion

    #region CalcAverageSum
    /// <summary>
    /// Berechnen Durchschnitt/Summe/Min/Max
    /// </summary>
    public void CalcAverageSum()
    {
        ConsAverage_m3 = Math.Round(ChartPointList.Average(x => x.Cons_m3).GetValueOrDefault(), 2);

        // Berechnung der Summe m3: Wenn Start- und End-Zählerstand vorhanden, dann Differenz berechnen, ansonsten Summe der Verbrauchswerte
        if (supplierData?.Ende_Zaehlerstand != null && supplierData?.Start_Zaehlerstand != null)
        {
            ConsSum_m3=Math.Round(supplierData.Ende_Zaehlerstand.Value - supplierData.Start_Zaehlerstand.Value, 2);
        }
        else
        {
            double actCounter = counterList?.MaxBy(c => c.Ablesetag)?.Zaehlerstand ?? 0.0d;
            double startCounter = supplierData?.Start_Zaehlerstand ?? 0.0d;
            ConsSum_m3 = Math.Round(actCounter - startCounter, 2);
        }

        ConsAverage_kWh = Math.Round(ChartPointList.Average(x => x.Cons_kWh).GetValueOrDefault(), 2);
        ConsSum_kWh = Math.Round(ChartPointList.Sum(x => x.Cons_kWh).GetValueOrDefault(), 2);
        ConsMin_kWh = Math.Round(ChartPointList.Min(x => x.Cons_kWh).GetValueOrDefault(), 2);
        ConsMax_kWh = Math.Round(ChartPointList.Max(x => x.Cons_kWh).GetValueOrDefault(), 2);
        TempAverage = Math.Round(ChartPointList.Average(x => x.Temp).GetValueOrDefault(), 2);
    }
    #endregion

    #region GetMockChartData
    /// <summary>
    /// Auslesen der Mockdaten
    /// </summary>
    /// <param name="data"></param>
    /// <param name="startPeriod"></param>
    /// <param name="endPeriod"></param>
    public async Task GetMockChartData(DateTime? startPeriod, DateTime? endPeriod)
    {
        const int days = 364;
        DateTime dayToday = DateTime.Today; // .Today statt .Now, da Uhrzeit für den Tagesvergleich meist irrelevant ist
        DateTime startDate = startPeriod ?? new DateTime(1970, 1, 1);

        // Kapazität direkt zuweisen verhindert Speicher-Reallozierungen
        var temporaryList = new List<ColumnChartData>(days);

        for (int i = 0; i < days; i++)
        {
            DateTime currentDate = startDate.AddDays(i);
            if (currentDate > dayToday)
            {
                break;
            }

            // Random.Shared ist thread-safe und performanter (ab .NET 6)
            double consumption = Random.Shared.Next(0, 10);
            double temperature = Random.Shared.Next(-10, 30);
            double consumption_kWh = consumption * Factor_kWh;

            temporaryList.Add(new ColumnChartData
            {
                Date = currentDate,
                Cons_m3 = consumption,
                Temp = temperature,
                Cons_kWh = consumption_kWh
            });
        }

        // Thread-Sicherheit erhöhen: Erst am Ende der UI/Klasse zuweisen
        ChartPointList = temporaryList;

        // Künstliche Verzögerung (falls für UI-Effekte gewollt), sonst Zeile komplett löschen
        //await Task.Delay(200);

        GetChartMinMaxRange(ChartPointList);
    }
    #endregion

    #region GetChartMinMaxRange
    /// <summary>
    /// Berechnen Chart Min/Max-Range
    /// </summary>
    public void GetChartMinMaxRange(List<ColumnChartData> chartList)
    {
        // 1. Früher Abbruch
        if (chartList == null || !chartList.Any())
        {
            MinRangeCons = 0.0d;
            MaxRangeCons_kWh = 0.0d;
            MaxRangeCons_m3 = 0.0d;
            return;
        }

        // 2. Initialisierung der Min-Werte und Intervalle
        MinRangeCons = 0.0d;

        // 3. JETZT erst das Switch-Statement ausführen (da MaxRangeCons_TW_m3 nun bekannt ist!)
        (string label, int decimalPlaces, int interval) = DdlInterval switch
        {
            Interval.täglich => ("N0", 0, 4),
            Interval.monatlich => ("N0", 0, 5),
            Interval.jährlich => ("N0", 0, 6),
            _ => ("N0", 0, 4)
        };

        // Globale Format-Variable für das Razor-Markup füllen
        labelFormat = label;

        // 4. Startwerte für die Maximum-Suche aus dem ersten Element lesen
        // (Verhindert Probleme, falls alle Werte in der Liste 0 oder negativ sind)
        var firstItem = chartList.FirstOrDefault(x => x != null);
        if (firstItem == null) return;

        double maxCons_kWh = firstItem.Cons_kWh ?? 0.0d;
        double maxCons_m3= firstItem.Cons_m3 ?? 0.0d;

        // Liste einmal komplett durchlaufen
        foreach (var item in chartList)
        {
            if (item == null) continue;

            if (item.Cons_kWh > maxCons_kWh) maxCons_kWh = item.Cons_kWh ?? 0.0d;
            if (item.Cons_m3 > maxCons_m3) maxCons_m3 = item.Cons_m3 ?? 0.0d;
        }

        // 5. Werte runden und Offsets addieren
        MaxRangeCons_kWh = Math.Round(maxCons_kWh * 1.05d, decimalPlaces); // 5% Puffer
        MaxRangeCons_m3 = Math.Round(maxCons_m3 * 1.5d, decimalPlaces); // 5% Puffer 1.5d --> Vergrößerung der Y-Achse für bessere Sichtbarkeit

        Interval_YAxis_kWh = Math.Round(MaxRangeCons_kWh / interval, decimalPlaces);
        Interval_YAxis_m3 = Math.Round(MaxRangeCons_m3 / (interval), decimalPlaces);
    }
    #endregion

