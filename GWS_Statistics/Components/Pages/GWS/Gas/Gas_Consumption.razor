    #region ToolTipRenderEvent
    /// <summary>
    /// Anzeige von x Nachkommastellen im Tooltip!
    /// </summary>
    /// <param name="args"></param>
    public void ToolTipRenderEvent(SharedTooltipRenderEventArgs args)
    {
        var displayCulture = new CultureInfo("de-DE");

        for (int i = 0; i < args.Data.Count; i++)
        {
            var di = args.Data[i];

            if (di?.PointY == null) continue;

            double y;
            // If it's already numeric, avoid string parsing
            if (di.PointY is double dy) y = dy;
            else if (di.PointY is float fy) y = fy;
            else if (di.PointY is decimal dm) y = (double)dm;
            else
            {
                // Fallback: try to parse string with Invariant first, then de-DE
                var s = di.PointY.ToString();

                if (!double.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out y))
                    double.TryParse(s, NumberStyles.Any, displayCulture, out y);
            }

            args.Text[i] = args.Data[i].SeriesName switch
            {
                "Verbrauch (kWh)" => $"{di.SeriesName}: {y.ToString("N2", displayCulture)} kWh",
                "Verbrauch (m³)" => $"{di.SeriesName}: {y.ToString("N2", displayCulture)} m³",
                "Temperatur" => $"{di.SeriesName}: {y.ToString("N0", displayCulture)} °C",
                _ => args.Text[i] // Behält den alten Wert bei, falls kein Name matcht
            };
        }
    }
    #endregion
